---
interface Certificate {
  id: string;
  title: string;
  issuer: string;
  date: string | null;
  category: string;
  image: string;
  width: number;
  height: number;
  redacted: boolean;
}

interface Props { certificates: Certificate[] }
const { certificates } = Astro.props;
const filters = [
  ['All', 'All'], ['Credential', 'Credentials'], ['Training', 'Training'],
  ['CTF', 'CTF'], ['Contribution', 'Contributions'], ['Participation', 'Participation']
];
---

<div data-certificate-gallery>
  <div class="gallery-toolbar">
    <div class="certificate-filters" role="group" aria-label="Filter certificates" hidden>
      {filters.map(([value, label]) => (
        <button type="button" data-certificate-filter={value} aria-pressed={value === 'All'} aria-controls="certificate-grid">{label}</button>
      ))}
    </div>
    <p class="certificate-count" data-certificate-count role="status" aria-live="polite" aria-atomic="true">
      {certificates.length} {certificates.length === 1 ? 'certificate' : 'certificates'}
    </p>
  </div>
  <noscript><p>Certificate previews are available below. Enable JavaScript to filter or enlarge them.</p></noscript>
  <div id="certificate-grid" class="certificate-grid">
    {certificates.map((certificate, index) => (
      <article class="certificate-card" data-certificate-card data-category={certificate.category}>
        <button type="button" class="certificate-preview" data-certificate-open aria-label={`Enlarge ${certificate.title}`} aria-haspopup="dialog" disabled>
          <img src={certificate.image} alt={`${certificate.title} certificate${certificate.redacted ? ', IC number redacted' : ''}`} width={certificate.width} height={certificate.height} style={`aspect-ratio: ${certificate.width} / ${certificate.height}`} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
          <span class="preview-action" aria-hidden="true">⤢</span>
        </button>
        <div class="certificate-info">
          <p class="certificate-category">{certificate.category}</p>
          <h3>{certificate.title}</h3>
          <dl>
            <div><dt>Issuer</dt><dd data-certificate-issuer>{certificate.issuer}</dd></div>
            <div><dt>Date</dt><dd data-certificate-date>{certificate.date ?? 'Date not stated'}</dd></div>
          </dl>
          {certificate.redacted && <p class="privacy-note">IC number redacted</p>}
        </div>
      </article>
    ))}
  </div>
  <p class="gallery-empty" data-certificate-empty hidden={certificates.length > 0}>No certificates in this category yet.</p>

  <dialog class="certificate-dialog" aria-labelledby="certificate-dialog-title" aria-describedby="certificate-dialog-meta">
    <div class="dialog-header">
      <div>
        <h2 id="certificate-dialog-title" data-certificate-dialog-title></h2>
        <p id="certificate-dialog-meta" data-certificate-dialog-meta></p>
      </div>
      <button type="button" class="dialog-close" data-certificate-close autofocus>Close <span aria-hidden="true">×</span></button>
    </div>
    <div class="dialog-image-frame"><img data-certificate-dialog-image alt="" /></div>
    <p class="dialog-help">Press Escape or select Close to return to the gallery.</p>
  </dialog>
</div>

<script src="../scripts/certificate-gallery.ts"></script>

<style>
  .gallery-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 1rem; }
  .certificate-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .certificate-filters[hidden], .certificate-card[hidden], .gallery-empty[hidden] { display: none; }
  .certificate-filters button, .dialog-close { min-height: 44px; padding: 0.55rem 0.9rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--text); cursor: pointer; }
  .certificate-filters button:hover, .dialog-close:hover { border-color: var(--text); }
  .certificate-filters button[aria-pressed="true"] { background: var(--text); border-color: var(--text); color: var(--bg); }
  .certificate-filters button:focus-visible, .certificate-preview:focus-visible, .dialog-close:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; }
  .certificate-count { margin: 0; color: var(--text-muted); font-size: var(--text-sm); }
  .certificate-grid { column-count: 5; column-gap: 1rem; }
  .certificate-card { display: block; break-inside: avoid; align-self: start; width: 100%; min-width: 0; margin-bottom: 1rem; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); transition: border-color var(--motion); }
  .certificate-card:hover, .certificate-card:focus-within { border-color: var(--text-muted); }
  .certificate-preview { position: relative; display: block; width: 100%; padding: 0; border: 0; border-bottom: 1px solid var(--border); background: #efefef; color: var(--text); cursor: zoom-in; text-align: left; }
  .certificate-preview:disabled { cursor: default; }
  .certificate-preview img { display: block; width: 100%; height: auto; padding: 0; object-fit: contain; }
  .preview-action { position: absolute; top: 0.5rem; right: 0.5rem; display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--border-strong); border-radius: var(--radius); background: var(--surface); color: var(--text); font-size: 1.25rem; line-height: 1; pointer-events: none; }
  .certificate-info { padding: 0.8rem; overflow-wrap: anywhere; }
  .certificate-category { margin-bottom: 0.35rem; color: var(--text-muted); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; }
  .certificate-info h3 { margin-bottom: 0.55rem; font-size: 1.1rem; line-height: 1.3; }
  .certificate-info dl { display: grid; gap: 0.25rem; margin: 0; line-height: 1.5; }
  .certificate-info dl div { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 0.5rem; }
  .certificate-info dt { color: var(--text-muted); font-size: var(--text-xs); text-transform: uppercase; }
  .certificate-info dd { margin: 0; color: var(--text-soft); font-size: var(--text-sm); }
  .privacy-note { margin: 0.5rem 0 0; color: var(--text-muted); font-size: var(--text-xs); }
  .gallery-empty { padding: 2rem 0; color: var(--text-muted); }
  .certificate-dialog { width: min(1400px, calc(100vw - 2rem)); max-width: none; max-height: calc(100dvh - 2rem); padding: 1.25rem; border: 1px solid var(--border-strong); border-radius: var(--radius); background: var(--surface); color: var(--text); overflow: auto; }
  .certificate-dialog::backdrop { background: rgba(0, 0, 0, 0.88); }
  .dialog-header { display: flex; align-items: start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .dialog-header > div { min-width: 0; }
  .dialog-header h2 { font-size: clamp(1rem, 2vw, 1.5rem); overflow-wrap: anywhere; }
  .dialog-header p { margin: 0.5rem 0 0; color: var(--text-muted); font-size: var(--text-xs); overflow-wrap: anywhere; }
  .dialog-close { flex-shrink: 0; }
  .dialog-image-frame { background: #efefef; }
  .dialog-image-frame img { display: block; width: 100%; max-height: 72dvh; height: auto; object-fit: contain; }
  .dialog-help { margin: 0.75rem 0 0; color: var(--text-muted); font-size: var(--text-xs); }
  @media (max-width: 1280px) { .certificate-grid { column-count: 3; } }
  @media (max-width: 1024px) { .certificate-grid { column-count: 2; } }
  @media (max-width: 640px) {
    .certificate-grid { column-count: 1; }
    .certificate-filters { flex-wrap: nowrap; max-width: 100%; overflow-x: auto; padding-bottom: 0.25rem; }
    .certificate-filters button { flex: 0 0 auto; }
    .certificate-filters button:focus-visible { outline: 2px solid currentColor; outline-offset: -5px; }
    .certificate-dialog { padding: 0.8rem; }
    .dialog-header { flex-direction: column-reverse; }
    .dialog-close { align-self: end; }
  }
</style>
