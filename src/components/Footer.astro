---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-layout">
      <div>
        <a class="footer-brand" href="/">0xG10D</a>
        <p>
          Cybersecurity student archive for CTF writeups, DFIR notes, lab tooling, and authorized security practice.
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/writeups/">Writeups</a>
        <a href="/cheatsheets/">Cheatsheets</a>
        <a href="/projects/">Projects</a>
        <a href="/achievements/">Achievements</a>
        <a href="https://github.com/0xG10D" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} 0xG10D. Educational notes from authorized labs and personal research.</p>
      <p>Do not test systems without clear permission.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding: clamp(2rem, 5vw, 3.25rem) 0 2rem;
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .footer-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: start;
  }

  .footer-brand {
    display: inline-block;
    margin-bottom: 0.6rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 700;
    text-decoration: none;
  }

  .footer-layout p {
    max-width: 66ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem 0.9rem;
  }

  .footer-nav a {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .footer-bottom p {
    margin: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  @media (max-width: 720px) {
    .footer-layout {
      grid-template-columns: 1fr;
    }

    .footer-nav {
      justify-content: flex-start;
    }
  }
</style>
