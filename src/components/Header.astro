---
type NavLink = {
  href: string;
  label: string;
};

const currentPath = Astro.url.pathname;
const links: NavLink[] = [
  { href: '/writeups/', label: 'Writeups' },
  { href: '/cheatsheets/', label: 'Cheatsheets' },
  { href: '/projects/', label: 'Projects' },
  { href: '/achievements/', label: 'Achievements' }
];
---

<header class="site-header">
  <div class="container">
    <nav class="nav" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="0xG10D home">
        <span class="brand-mark">0xG10D</span>
        <span class="brand-note">field notes</span>
      </a>

      <button
        class="nav-mobile-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <span></span>
        <span></span>
      </button>

      <div class="nav-links" id="mobile-navigation" aria-hidden="true">
        {links.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`nav-link ${isActive ? 'nav-link-active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
        <a class="nav-link nav-link-github" href="https://github.com/0xG10D" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid var(--border);
    background: rgba(13, 14, 12, 0.96);
    backdrop-filter: blur(10px);
  }

  .nav {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.65rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand-mark {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
  }

  .brand-note {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .nav-link {
    padding: 0.35rem 0.58rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link-active {
    border-color: var(--border);
    background: var(--bg-soft);
    color: var(--text);
  }

  .nav-link-active {
    color: var(--accent-strong);
  }

  .nav-link-github {
    margin-left: 0.35rem;
    border-color: var(--border);
  }

  .nav-mobile-toggle {
    display: none;
    width: 42px;
    min-height: 38px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: var(--text);
    cursor: pointer;
  }

  .nav-mobile-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin: 5px auto;
    background: currentColor;
    transition: transform var(--motion);
  }

  .nav-mobile-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav-mobile-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 780px) {
    .brand-note {
      display: none;
    }

    .nav-mobile-toggle {
      display: block;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding: 0.75rem var(--gutter) 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg);
    }

    .nav-links[aria-hidden="false"] {
      display: grid;
    }

    .nav-link {
      padding: 0.78rem 0.75rem;
    }

    .nav-link-github {
      margin-left: 0;
    }
  }
</style>

<script>
  const mobileToggle = document.querySelector('.nav-mobile-toggle');
  const mobilePanel = document.querySelector('.nav-links');
  const desktopQuery = window.matchMedia('(min-width: 781px)');

  if (mobileToggle instanceof HTMLButtonElement && mobilePanel instanceof HTMLElement) {
    const setMobileMenuState = (isOpen: boolean) => {
      mobileToggle.setAttribute('aria-expanded', String(isOpen));
      mobilePanel.setAttribute('aria-hidden', String(!isOpen && !desktopQuery.matches));
    };

    const syncForViewport = () => {
      if (desktopQuery.matches) {
        mobilePanel.setAttribute('aria-hidden', 'false');
        mobileToggle.setAttribute('aria-expanded', 'false');
      } else {
        setMobileMenuState(false);
      }
    };

    mobileToggle.addEventListener('click', () => {
      const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
      setMobileMenuState(!isExpanded);
    });

    mobilePanel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (!desktopQuery.matches) setMobileMenuState(false);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMobileMenuState(false);
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!desktopQuery.matches && target instanceof Node && !mobileToggle.contains(target) && !mobilePanel.contains(target)) {
        setMobileMenuState(false);
      }
    });

    desktopQuery.addEventListener('change', syncForViewport);
    syncForViewport();
  }
</script>
