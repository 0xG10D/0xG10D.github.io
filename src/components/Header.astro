---
type NavLink = {
  href: string;
  label: string;
};

const currentPath = Astro.url.pathname;
// Cheatsheets and Projects are kept in the repo but unpublished.
// Their sources live at src/pages/_cheatsheets.astro and src/pages/_projects*.
// Re-enable by dropping the leading underscore and restoring the links below.
const links: NavLink[] = [
  { href: '/', label: 'Whoami' },
  { href: '/writeups/', label: 'Writeup' },
  { href: '/achievements/', label: 'Achievements' }
];

const isLinkActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container">
    <nav class="nav" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="0xG10D home">
        <span class="brand-mark">G10D</span>
      </a>

      <button
        class="nav-mobile-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <span></span>
        <span></span>
      </button>

      <div class="nav-links" id="mobile-navigation" aria-hidden="true">
        <div class="nav-pill">
          {links.map((link) => {
            const isActive = isLinkActive(link.href);
            return (
              <a
                href={link.href}
                class={`nav-link ${isActive ? 'nav-link-active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })}
        </div>
        <a class="nav-link-github" href="https://github.com/0xG10D" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          GitHub
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid var(--border);
    background: rgba(13, 14, 12, 0.96);
    backdrop-filter: blur(10px);
  }

  .nav {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    color: var(--text);
    text-decoration: none;
  }

  .brand-mark {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.22rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-soft);
  }

  .nav-link {
    position: relative;
    padding: 0.4rem 0.85rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color var(--motion), border-color var(--motion), background-color var(--motion);
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link-active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .nav-link-github {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .nav-link-github:hover {
    color: var(--accent-strong);
  }

  .nav-mobile-toggle {
    display: none;
    width: 42px;
    min-height: 38px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: var(--text);
    cursor: pointer;
  }

  .nav-mobile-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin: 5px auto;
    background: currentColor;
    transition: transform var(--motion);
  }

  .nav-mobile-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .nav-mobile-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 780px) {
    .nav-mobile-toggle {
      display: block;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0.6rem;
      padding: 0.75rem var(--gutter) 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg);
    }

    .nav-links[aria-hidden="false"] {
      display: flex;
    }

    .nav-pill {
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
      border-radius: var(--radius);
    }

    .nav-link {
      border-radius: var(--radius);
      text-align: center;
      padding: 0.7rem 0.75rem;
    }

    .nav-link-github {
      text-align: center;
      padding: 0.4rem 0;
    }
  }
</style>

<script>
  const mobileToggle = document.querySelector('.nav-mobile-toggle');
  const mobilePanel = document.querySelector('.nav-links');
  const desktopQuery = window.matchMedia('(min-width: 781px)');

  if (mobileToggle instanceof HTMLButtonElement && mobilePanel instanceof HTMLElement) {
    const setMobileMenuState = (isOpen: boolean) => {
      mobileToggle.setAttribute('aria-expanded', String(isOpen));
      mobilePanel.setAttribute('aria-hidden', String(!isOpen && !desktopQuery.matches));
    };

    const syncForViewport = () => {
      if (desktopQuery.matches) {
        mobilePanel.setAttribute('aria-hidden', 'false');
        mobileToggle.setAttribute('aria-expanded', 'false');
      } else {
        setMobileMenuState(false);
      }
    };

    mobileToggle.addEventListener('click', () => {
      const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
      setMobileMenuState(!isExpanded);
    });

    mobilePanel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (!desktopQuery.matches) setMobileMenuState(false);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMobileMenuState(false);
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!desktopQuery.matches && target instanceof Node && !mobileToggle.contains(target) && !mobilePanel.contains(target)) {
        setMobileMenuState(false);
      }
    });

    desktopQuery.addEventListener('change', syncForViewport);
    syncForViewport();
  }
</script>
