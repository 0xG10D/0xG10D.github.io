---
import IconHome from './icons/IconHome.astro';
import IconFile from './icons/IconFile.astro';
import IconTerminal from './icons/IconTerminal.astro';
import IconProject from './icons/IconProject.astro';
import IconAward from './icons/IconAward.astro';
import IconUser from './icons/IconUser.astro';

const Icons = {
  home: IconHome,
  writeups: IconFile,
  cheatsheets: IconTerminal,
  projects: IconProject,
  achievements: IconAward,
  about: IconUser
};

type IconName = keyof typeof Icons;
type NavLink = {
  href: string;
  label: string;
  icon: IconName;
};

const currentPath = Astro.url.pathname;
const links: NavLink[] = [
  { href: '/', label: './~', icon: 'home' },
  { href: '/writeups/', label: './writeups', icon: 'writeups' },
  { href: '/cheatsheets/', label: './cheatsheets', icon: 'cheatsheets' },
  { href: '/projects/', label: './projects', icon: 'projects' },
  { href: '/achievements/', label: './achievements', icon: 'achievements' },
  { href: '/about/', label: './about', icon: 'about' }
];
---

<header class="site-header">
  <div class="container">
    <nav class="nav" aria-label="Main navigation">
      <!-- Brand -->
      <a class="brand" href="/" aria-label="0xG10D Home">
        <span class="brand-bracket">[</span>
        <span class="brand-name">0xG10D</span>
        <span class="brand-bracket">]</span>
        <span class="brand-tagline">// sec</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="nav-desktop">
        {
          links.map((link) => {
            const isHome = link.href === '/';
            const isActive = isHome
              ? currentPath === '/'
              : currentPath === link.href || currentPath.startsWith(link.href);

            const IconComp = Icons[link.icon];

            return (
              <a
                href={link.href}
                class={`nav-link ${isActive ? 'nav-link-active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                <span class="nav-link-icon"><IconComp /></span>
                <span class="nav-link-label">{link.label}</span>
              </a>
            );
          })
        }
      </div>

      <!-- Mobile Navigation Toggle -->
      <button class="nav-mobile-toggle" type="button" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-navigation">
        <div class="nav-mobile-toggle-inner">
          <span class="nav-mobile-line"></span>
          <span class="nav-mobile-line"></span>
          <span class="nav-mobile-line"></span>
        </div>
      </button>

      <!-- Mobile Navigation Panel -->
      <div class="nav-mobile-panel" id="mobile-navigation" aria-hidden="true">
        <div class="nav-mobile-content">
          {
            links.map((link) => {
              const isHome = link.href === '/';
              const isActive = isHome
                ? currentPath === '/'
                : currentPath === link.href || currentPath.startsWith(link.href);

              const IconComp = Icons[link.icon];

              return (
                <a
                  href={link.href}
                  class={`nav-mobile-link ${isActive ? 'nav-mobile-link-active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="nav-mobile-link-icon"><IconComp /></span>
                  <span class="nav-mobile-link-label">{link.label}</span>
                </a>
              );
            })
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Header Base */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--bg-main);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.65rem 0;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 3vw, 2rem);
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.12rem;
    color: var(--text-primary);
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .brand:hover {
    color: var(--text-primary);
  }

  .brand-bracket {
    color: var(--muted-text);
  }

  .brand-name {
    color: var(--text-primary);
  }

  .brand-tagline {
    font-size: 0.75rem;
    color: var(--muted-text);
    margin-left: 0.75rem;
    letter-spacing: 0.05em;
  }

  /* Desktop Navigation */
  .nav-desktop {
    display: flex;
    gap: 0.35rem;
  }

  .nav-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.8rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    border-radius: var(--radius-sm);
    transition: all var(--motion-fast) var(--motion-ease);
    position: relative;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: var(--card-bg);
  }

  .nav-link-active {
    color: var(--text-primary);
    background: var(--card-bg);
    border-bottom: 2px solid var(--text-primary);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .nav-link-icon {
    font-size: 1.1rem;
    line-height: 1;
    color: currentColor;
  }

  .nav-link-label {
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  /* Mobile Navigation Toggle */
  .nav-mobile-toggle {
    display: none;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.65rem;
    cursor: pointer;
    color: var(--text-primary);
    transition: background var(--motion-fast) var(--motion-ease);
  }

  .nav-mobile-toggle:hover {
    background: var(--bg-main);
  }

  .nav-mobile-toggle-inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 24px;
  }

  .nav-mobile-line {
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: all var(--motion-medium) var(--motion-ease);
  }

  .nav-mobile-toggle[aria-expanded="true"] .nav-mobile-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-mobile-toggle[aria-expanded="true"] .nav-mobile-line:nth-child(2) {
    opacity: 0;
  }

  .nav-mobile-toggle[aria-expanded="true"] .nav-mobile-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Navigation Panel */
  .nav-mobile-panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - 72px);
    overflow-y: auto;
    background: var(--bg-main);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.85rem 0 max(1rem, env(safe-area-inset-bottom));
    opacity: 0;
    transform: translateY(-10px);
    transition: all var(--motion-medium) var(--motion-ease);
  }

  .nav-mobile-panel[aria-hidden="false"] {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .nav-mobile-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0 var(--container-padding);
  }

  .nav-mobile-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    padding: 0.9rem 1rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    transition: all var(--motion-fast) var(--motion-ease);
  }

  .nav-mobile-link:hover,
  .nav-mobile-link-active {
    color: var(--text-primary);
    background: var(--card-bg);
    border-color: var(--text-primary);
  }

  .nav-mobile-link-icon {
    font-size: 1.25rem;
    width: 24px;
    text-align: center;
    color: currentColor;
  }

  .nav-mobile-link-label {
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .site-header {
      padding: 0.6rem 0;
    }

    .nav {
      gap: 0.85rem;
    }

    .nav-desktop {
      display: none;
    }

    .nav-mobile-toggle {
      display: inline-flex;
    }

    .brand-tagline {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .brand {
      font-size: 1rem;
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .nav-mobile-content {
      padding-inline: 0.8rem;
    }
  }
</style>

<script>
  // Mobile navigation toggle
  const mobileToggle = document.querySelector('.nav-mobile-toggle');
  const mobilePanel = document.querySelector('.nav-mobile-panel');

  if (mobileToggle instanceof HTMLButtonElement && mobilePanel instanceof HTMLElement) {
    const setMobileMenuState = (isOpen: boolean) => {
      mobileToggle.setAttribute('aria-expanded', String(isOpen));
      mobilePanel.setAttribute('aria-hidden', String(!isOpen));
    };

    mobileToggle.addEventListener('click', () => {
      const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
      setMobileMenuState(!isExpanded);
    });

    mobilePanel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMobileMenuState(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMobileMenuState(false);
    });

    // Close mobile menu when clicking outside.
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Node && !mobileToggle.contains(target) && !mobilePanel.contains(target)) {
        setMobileMenuState(false);
      }
    });
  }
</script>
