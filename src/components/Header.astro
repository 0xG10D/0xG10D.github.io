---
type NavLink = {
  href: string;
  label: string;
};

const currentPath = Astro.url.pathname;
const links: NavLink[] = [
  { href: '/writeups/', label: 'Writeups' },
  { href: '/cheatsheets/', label: 'Cheatsheets' },
  { href: '/projects/', label: 'Projects' },
  { href: '/achievements/', label: 'Achievements' },
  { href: '/about/', label: 'About' }
];
---

<header class="site-header">
  <div class="container">
    <nav class="nav" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="0xG10D home">
        <span>0xG10D</span>
      </a>

      <button class="nav-mobile-toggle" type="button" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="nav-links" id="mobile-navigation" aria-hidden="true">
        {links.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`nav-link ${isActive ? 'nav-link-active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
        <a class="nav-link nav-link-github" href="https://github.com/0xG10D" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(11, 15, 20, 0.96);
  }

  .nav {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .brand span {
    display: inline-block;
    border-bottom: 2px solid var(--accent-blue);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .nav-link {
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--muted-text);
    font-size: 0.94rem;
    font-weight: 600;
  }

  .nav-link:hover,
  .nav-link-active {
    background: var(--accent-blue-subtle);
    color: var(--accent-blue);
  }

  .nav-link-github {
    margin-left: 0.3rem;
    border: 1px solid var(--border-subtle);
  }

  .nav-mobile-toggle {
    display: none;
    width: 44px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
  }

  .nav-mobile-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin: 4px auto;
    background: currentColor;
    transition: transform var(--motion-fast) var(--motion-ease), opacity var(--motion-fast) var(--motion-ease);
  }

  .nav-mobile-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-mobile-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .nav-mobile-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 780px) {
    .nav {
      min-height: 58px;
    }

    .nav-mobile-toggle {
      display: block;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
      padding: 0.75rem var(--container-padding) 1rem;
      border-bottom: 1px solid var(--border-subtle);
      background: var(--bg-main);
    }

    .nav-links[aria-hidden="false"] {
      display: flex;
    }

    .nav-link {
      padding: 0.75rem;
    }

    .nav-link-github {
      margin-left: 0;
    }
  }
</style>

<script>
  const mobileToggle = document.querySelector('.nav-mobile-toggle');
  const mobilePanel = document.querySelector('.nav-links');

  if (mobileToggle instanceof HTMLButtonElement && mobilePanel instanceof HTMLElement) {
    const setMobileMenuState = (isOpen: boolean) => {
      mobileToggle.setAttribute('aria-expanded', String(isOpen));
      mobilePanel.setAttribute('aria-hidden', String(!isOpen));
    };

    mobileToggle.addEventListener('click', () => {
      const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
      setMobileMenuState(!isExpanded);
    });

    mobilePanel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMobileMenuState(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMobileMenuState(false);
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Node && !mobileToggle.contains(target) && !mobilePanel.contains(target)) {
        setMobileMenuState(false);
      }
    });
  }
</script>
