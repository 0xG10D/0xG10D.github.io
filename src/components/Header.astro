---
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname;
// Cheatsheets stay unpublished: source lives at src/pages/_cheatsheets.astro.
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/writeups/', label: 'Writeups' },
  { href: '/research/', label: 'Research' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' }
];

const isLinkActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container">
    <nav class="nav" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="0xG10D home">
        <img src="/images/brand/mascot-96.png" alt="" width="44" height="41" />
      </a>

      <button
        class="nav-mobile-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="site-navigation"
      >
        <Icon name="menu" size={20} />
      </button>

      <div class="nav-panel" id="site-navigation">
        <ul class="nav-links">
          {links.map((link) => {
            const isActive = isLinkActive(link.href);
            return (
              <li>
                <a href={link.href} class="nav-link" aria-current={isActive ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>

        <form class="search-field nav-search" action="/blog/" method="get" role="search">
          <Icon name="search" size={16} />
          <input type="search" name="q" placeholder="Search posts..." aria-label="Search posts" autocomplete="off" data-site-search />
          <kbd data-search-hint>Ctrl K</kbd>
        </form>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid var(--border);
    background: rgba(5, 5, 5, 0.88);
    backdrop-filter: blur(12px);
  }

  .nav {
    display: flex;
    min-height: 64px;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .brand img {
    display: block;
    width: 44px;
    height: auto;
  }

  .nav-panel {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 2vw, 1.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 0.5rem;
    color: var(--text-soft);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    right: 0.5rem;
    bottom: 7px;
    left: 0.5rem;
    height: 2px;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .nav-link[aria-current="page"] {
    color: var(--text);
    font-weight: 700;
  }

  .nav-search {
    width: 264px;
    min-width: 0;
    background: transparent;
  }

  .nav-mobile-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-left: auto;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  @media (max-width: 1040px) {
    .nav-search {
      width: 200px;
    }

    .nav-search kbd {
      display: none;
    }
  }

  @media (max-width: 880px) {
    .nav-mobile-toggle {
      display: inline-flex;
    }

    .nav-panel {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 0.75rem var(--gutter) 1.1rem;
      border-bottom: 1px solid var(--border);
      background: var(--bg);
    }

    .nav-panel[data-open] {
      display: flex;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav-link {
      width: 100%;
      min-height: 48px;
      border-bottom: 1px solid var(--border);
    }

    .nav-link::after {
      display: none;
    }

    .nav-link[aria-current="page"]::before {
      content: ">";
      margin-right: 0.5rem;
      color: var(--accent);
    }

    .nav-search {
      width: 100%;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-mobile-toggle');
  const panel = document.querySelector<HTMLElement>('.nav-panel');
  const search = document.querySelector<HTMLInputElement>('[data-site-search]');
  const hint = document.querySelector<HTMLElement>('[data-search-hint]');

  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.toggleAttribute('data-open', open);
  };

  if (toggle && panel) {
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Node && !toggle.contains(target) && !panel.contains(target)) setOpen(false);
    });
  }

  if (hint && /Mac|iPhone|iPad/.test(navigator.userAgent)) hint.textContent = '⌘K';

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (toggle?.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
      return;
    }

    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k' && search) {
      event.preventDefault();
      // The search field sits inside the collapsed panel on small screens.
      if (toggle && getComputedStyle(toggle).display !== 'none') setOpen(true);
      search.focus();
      search.select();
    }
  });
</script>
