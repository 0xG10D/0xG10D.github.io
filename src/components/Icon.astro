  flag: '<path d="M4 22V4a1 1 0 0 1 .4-.8A6 6 0 0 1 8 2c3 0 5 2 7.3 2a6.6 6.6 0 0 0 3.1-.8.5.5 0 0 1 .6.5V14a1 1 0 0 1-.4.8A6 6 0 0 1 15 16c-3 0-5-2-8-2a6 6 0 0 0-3 .8"/>',
  flask: '<path d="M10 2v6.3a2 2 0 0 1-.3 1L4.2 18.6A2 2 0 0 0 5.9 22h12.2a2 2 0 0 0 1.7-3.4l-5.5-9.3a2 2 0 0 1-.3-1V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/>',
