  layers: '<path d="M12.8 2.2a2 2 0 0 0-1.6 0L2.6 6.1a1 1 0 0 0 0 1.8l8.6 3.9a2 2 0 0 0 1.6 0l8.6-3.9a1 1 0 0 0 0-1.8z"/><path d="m2 12 9.200 4.200a2 2 0 0 0 1.600 0L22 12"/><path d="m2 17 9.200 4.200a2 2 0 0 0 1.600 0L22 17"/>',
  box: '<path d="M21 8a2 2 0 0 0-1-1.700l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.700l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.300 7 8.700 5 8.700-5"/><path d="M12 22V12"/>',
  calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  rocket: '<path d="M4.500 16.500c-1.500 1.300-2 5-2 5s3.700-.500 5-2c.700-.800.700-2.100-.100-2.900a2.200 2.200 0 0 0-2.900-.100z"/><path d="m12 15-3-3a22 22 0 0 1 2-4A12.900 12.900 0 0 1 22 2c0 2.700-.800 7.500-6 11a22 22 0 0 1-4 2z"/><path d="M9 12H4s.600-3 2-4c1.600-1.100 5 0 5 0"/><path d="M12 15v5s3-.600 4-2c1.100-1.600 0-5 0-5"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.500.500l3-3a5 5 0 0 0-7-7l-1.700 1.700"/><path d="M14 11a5 5 0 0 0-7.500-.500l-3 3a5 5 0 0 0 7 7l1.700-1.700"/>',
  github: '<path d="M15 22v-4a4.800 4.800 0 0 0-1-3.500c3 0 6-2 6-5.500.100-1.300-.300-2.500-1-3.500.300-1.200.300-2.400 0-3.500 0 0-1 0-3 1.500-2.600-.500-5.400-.500-8 0C6 2 5 2 5 2c-.300 1.200-.300 2.400 0 3.500A5.400 5.400 0 0 0 4 9c0 3.500 3 5.500 6 5.500-.400.500-.700 1.100-.800 1.700-.200.600-.200 1.200-.200 1.800v4"/><path d="M9 18c-4.500 2-5-2-7-2"/>',
  award: '<circle cx="12" cy="8" r="6"/><path d="M15.500 12.900 17 22l-5-3-5 3 1.500-9.100"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  chevron: '<path d="m9 18 6-6-6-6"/>'
} as const;

interface Props {
  name: keyof typeof paths;
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
