---
import type { CollectionEntry } from 'astro:content';
import { getChallengeType, getEventName, getEventSlug, getWriteupUrl } from '../utils/writeups';

interface Props {
  post: CollectionEntry<'writeups'>;
}

const { post } = Astro.props;

const platformLabels: Record<string, string> = {
  hackthebox: 'HTB',
  'hack-the-box': 'HTB',
  tryhackme: 'THM',
  portswigger: 'PortSwigger',
  picoctf: 'picoCTF',
  research: 'Research',
  ctf: 'CTF',
  other: 'Other'
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });

const platformLabel = platformLabels[post.data.platform] ?? post.data.platform.replaceAll('-', ' ');
const challengeType = getChallengeType(post);
const eventName = getEventName(getEventSlug(post));
const cardId = `writeup-${post.id.replace(/[^a-z0-9-]/gi, '-')}`;
const writeupUrl = getWriteupUrl(post);
---

<article class="writeup-card" aria-labelledby={cardId}>
  <div class="card-date">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span>{eventName}</span>
  </div>

  <div class="card-main">
    <div class="card-meta">
      <span>{platformLabel}</span>
      <span>{challengeType}</span>
      <span>{post.data.difficulty}</span>
    </div>

    <h3 class="card-title" id={cardId}>
      <a href={writeupUrl}>{post.data.title}</a>
    </h3>

    {post.data.summary && <p class="card-summary">{post.data.summary}</p>}

    {post.data.tags.length > 0 && (
      <div class="card-tags" aria-label={`${post.data.title} tags`}>
        {post.data.tags.slice(0, 6).map((tag) => <span>#{tag}</span>)}
      </div>
    )}
  </div>
</article>

<style>
  .writeup-card {
    display: grid;
    grid-template-columns: minmax(7rem, 10rem) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.75rem);
    padding: 1rem 0 1.05rem;
    border-top: 1px solid var(--border);
  }

  .writeup-card:last-child {
    border-bottom: 1px solid var(--border);
  }

  .card-date {
    display: grid;
    align-content: start;
    gap: 0.22rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .card-date span {
    color: var(--text-faint);
  }

  .card-main {
    min-width: 0;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.3rem;
    color: var(--steel);
    font-size: 0.74rem;
    text-transform: lowercase;
  }

  .card-meta span + span::before {
    content: "/";
    margin-right: 0.75rem;
    color: var(--border-strong);
  }

  .card-title {
    margin-bottom: 0.35rem;
    font-size: clamp(1.18rem, 2vw, 1.52rem);
  }

  .card-title a {
    color: var(--text);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent-strong);
  }

  .card-summary {
    max-width: 82ch;
    margin: 0;
    color: var(--text-soft);
    font-size: 0.98rem;
    line-height: 1.62;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    margin-top: 0.72rem;
  }

  .card-tags span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 640px) {
    .writeup-card {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }
</style>
