---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'writeups'>;
}

const { post } = Astro.props;

// Platform labels
const platformLabels: Record<string, string> = {
  hackthebox: 'HTB',
  'hack-the-box': 'HTB',
  tryhackme: 'THM',
  portswigger: 'PORTSWIGGER',
  picoctf: 'PICOCTF',
  'international-ctf': 'INTL_CTF',
  'local-ctf': 'LOCAL_CTF',
  ctf: 'CTF',
  other: 'OTHER'
};

// Difficulty colors
const difficultyColors: Record<string, string> = {
  easy: '#7DD3FC',
  medium: '#60A5FA',
  hard: '#3B82F6',
  insane: '#2563EB',
  info: '#38BDF8'
};

const getPlatformLabel = (value: string) => platformLabels[value] ?? value.replaceAll('-', '_').toUpperCase();

// Format date
const formatDate = (date: Date) =>
  date.toLocaleDateString('en', {
    year: '2-digit',
    month: '2-digit',
    day: '2-digit'
  }).replace(/\//g, '.');

const date = formatDate(post.data.date);
const difficulty = post.data.difficulty.toUpperCase();
const difficultyColor = difficultyColors[post.data.difficulty] || difficultyColors.info;
const platformLabel = getPlatformLabel(post.data.platform);

// Get first few tags
const displayTags = post.data.tags.slice(0, 3);
const cardId = `writeup-${post.id.replace(/[^a-z0-9-]/gi, '-')}`;
const searchText = [post.data.title, post.data.summary, post.data.platform, post.data.category, post.data.difficulty, ...post.data.tags]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="writeup-card"
  data-platform={post.data.platform}
  data-category={post.data.category}
  data-difficulty={post.data.difficulty}
  data-tags={post.data.tags.join(',')}
  data-search={searchText}
  aria-labelledby={cardId}
>
  <!-- Card Header -->
  <div class="card-header">
    <div class="card-meta">
      <span class="card-platform">{platformLabel}</span>
      <span class="card-date" title="Published date">{date}</span>
    </div>
    <div class="card-difficulty">
      <span class="difficulty-dot" style={`background: ${difficultyColor}`} aria-hidden="true"></span>
      <span class="difficulty-label">{difficulty}</span>
    </div>
  </div>

  <!-- Card Body -->
  <div class="card-body">
    <h3 class="card-title" id={cardId}>
      <a href={`/writeups/${post.id}/`} class="card-title-link">
        {post.data.title}
      </a>
    </h3>

    {post.data.summary && (
      <p class="card-summary">{post.data.summary}</p>
    )}

    <div class="card-tags">
      {displayTags.map((tag) => (
        <span class="card-tag">#{tag}</span>
      ))}
      {post.data.tags.length > 3 && (
        <span class="card-tag-more">+{post.data.tags.length - 3}</span>
      )}
    </div>
  </div>

  <!-- Card Footer -->
  <div class="card-footer">
    <a href={`/writeups/${post.id}/`} class="card-read-more">
      Read Analysis
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 12l4-4-4-4"/>
      </svg>
    </a>
    <div class="card-category">
      <span class="category-label">{post.data.category.replaceAll('-', ' ')}</span>
    </div>
  </div>

  <!-- Card Glow Effect -->
  <div class="card-glow" aria-hidden="true"></div>
</article>

<style>
  /* Writeup Card Base */
  .writeup-card {
    position: relative;
    min-width: 0;
    background: linear-gradient(180deg, rgba(16, 42, 76, 0.86), rgba(11, 29, 58, 0.94));
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform var(--motion-medium) var(--motion-ease), border-color var(--motion-medium) var(--motion-ease), box-shadow var(--motion-medium) var(--motion-ease);
    height: 100%;
    overflow: hidden;
  }

  .writeup-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-medium);
    box-shadow: var(--shadow-elevated);
  }

  /* Card Glow Effect */
  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      600px circle at var(--mouse-x) var(--mouse-y),
      var(--accent-blue-subtle) 0%,
      transparent 40%
    );
    opacity: 0;
    transition: opacity var(--motion-medium) var(--motion-ease);
    pointer-events: none;
    z-index: 0;
  }

  .writeup-card:hover .card-glow {
    opacity: 1;
  }

  /* Card Header */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .card-platform {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-blue);
    background: var(--accent-blue-subtle);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--border-medium);
    letter-spacing: 0.05em;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--silver-muted);
    letter-spacing: 0.02em;
  }

  .card-difficulty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .difficulty-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    animation: difficultyPulse 2s ease-in-out infinite;
  }

  @keyframes difficultyPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .difficulty-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--silver-text);
    letter-spacing: 0.05em;
  }

  /* Card Body */
  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--silver-text);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .card-title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .card-title-link:hover {
    color: var(--accent-blue);
  }

  .card-summary {
    color: var(--silver-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--silver-muted);
    background: var(--surface-elevated);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    overflow-wrap: anywhere;
  }

  .card-tag-more {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--silver-muted);
    background: var(--surface-elevated);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    opacity: 0.7;
  }

  /* Card Footer */
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .card-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--accent-blue);
    text-decoration: none;
    transition: all var(--motion-fast) var(--motion-ease);
  }

  .card-read-more:hover {
    gap: 0.75rem;
  }

  .card-read-more svg {
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .card-read-more:hover svg {
    transform: translateX(2px);
  }

  .card-category {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--silver-muted);
    background: var(--surface-elevated);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .writeup-card {
      padding: 1.5rem;
      gap: 1rem;
    }

    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .card-meta {
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .card-read-more {
      align-self: flex-start;
      min-height: 44px;
    }
  }

  @media (max-width: 560px) {
    .writeup-card {
      padding: 1.15rem;
    }

    .card-difficulty {
      min-height: 32px;
      padding: 0.25rem 0.55rem;
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
      background: rgba(8, 20, 47, 0.62);
    }

    .card-title {
      font-size: 1.12rem;
    }

    .card-summary {
      font-size: 0.92rem;
      line-height: 1.65;
      -webkit-line-clamp: 4;
    }

    .card-tag,
    .card-tag-more {
      padding-block: 0.35rem;
    }

    .card-read-more {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // Mouse tracking for glow effect
  const cards = document.querySelectorAll('.writeup-card');

  cards.forEach((card) => {
    if (!(card instanceof HTMLElement)) return;

    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const glow = card.querySelector('.card-glow');
      if (!(glow instanceof HTMLElement)) return;

      glow.style.setProperty('--mouse-x', `${x}px`);
      glow.style.setProperty('--mouse-y', `${y}px`);
    });
  });
</script>
