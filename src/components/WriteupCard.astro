---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'writeups'>;
}

const { post } = Astro.props;

// Platform labels
const platformLabels: Record<string, string> = {
  hackthebox: 'HTB',
  'hack-the-box': 'HTB',
  tryhackme: 'THM',
  portswigger: 'PORTSWIGGER',
  picoctf: 'PICOCTF',
  'international-ctf': 'INTL_CTF',
  'local-ctf': 'LOCAL_CTF',
  ctf: 'CTF',
  other: 'OTHER'
};

const getPlatformLabel = (value: string) => platformLabels[value] ?? value.replaceAll('-', '_').toUpperCase();

// Format date
const formatDate = (date: Date) =>
  date.toLocaleDateString('en', {
    year: '2-digit',
    month: '2-digit',
    day: '2-digit'
  }).replace(/\//g, '.');

const date = formatDate(post.data.date);
const difficulty = post.data.difficulty.toUpperCase();
const platformLabel = getPlatformLabel(post.data.platform);

// Get first few tags
const displayTags = post.data.tags.slice(0, 3);
const cardId = `writeup-${post.id.replace(/[^a-z0-9-]/gi, '-')}`;
const searchText = [post.data.title, post.data.summary, post.data.platform, post.data.category, post.data.difficulty, ...post.data.tags]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="writeup-card"
  data-platform={post.data.platform}
  data-category={post.data.category}
  data-difficulty={post.data.difficulty}
  data-tags={post.data.tags.join(',')}
  data-search={searchText}
  aria-labelledby={cardId}
>
  <!-- Card Header -->
  <div class="card-header">
    <div class="card-meta">
      <span class="card-platform">{platformLabel}</span>
      <span class="card-date" title="Published date">{date}</span>
    </div>
    <div class="card-difficulty">
      <span class="difficulty-label">{difficulty}</span>
    </div>
  </div>

  <!-- Card Body -->
  <div class="card-body">
    <h3 class="card-title" id={cardId}>
      <a href={`/writeups/${post.id}/`} class="card-title-link">
        {post.data.title}
      </a>
    </h3>

    {post.data.summary && (
      <p class="card-summary">{post.data.summary}</p>
    )}

    <div class="card-tags">
      {displayTags.map((tag) => (
        <span class="card-tag">#{tag}</span>
      ))}
      {post.data.tags.length > 3 && (
        <span class="card-tag-more">+{post.data.tags.length - 3}</span>
      )}
    </div>
  </div>

  <!-- Card Footer -->
  <div class="card-footer">
    <a href={`/writeups/${post.id}/`} class="card-read-more">
      Read notes
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 12l4-4-4-4"/>
      </svg>
    </a>
    <div class="card-category">
      <span class="category-label">{post.data.category.replaceAll('-', ' ')}</span>
    </div>
  </div>
</article>

<style>
  /* Writeup Card Base */
  .writeup-card {
    position: relative;
    min-width: 0;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: border-color var(--motion-medium) var(--motion-ease);
    height: 100%;
    overflow: hidden;
  }

  .writeup-card:hover {
    border-color: var(--border-medium);
  }

  /* Card Header */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .card-platform {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-primary);
    background: transparent;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-medium);
    letter-spacing: 0.05em;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-text);
    letter-spacing: 0.02em;
  }

  .card-difficulty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .difficulty-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: transparent;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
  }

  /* Card Body */
  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-title {
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .card-title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .card-title-link:hover {
    color: var(--accent);
  }

  .card-summary {
    color: var(--text-secondary);
    font-size: 0.93rem;
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-text);
    background: transparent;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    overflow-wrap: anywhere;
  }

  .card-tag-more {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-text);
    background: transparent;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    opacity: 0.7;
  }

  /* Card Footer */
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .card-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .card-read-more:hover {
    color: var(--text-primary);
    gap: 0.75rem;
  }

  .card-read-more svg {
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .card-read-more:hover svg {
    transform: translateX(2px);
  }

  .card-category {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-text);
    background: transparent;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .writeup-card {
      padding: 1.5rem;
      gap: 1rem;
    }

    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .card-meta {
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .card-read-more {
      align-self: flex-start;
      min-height: 44px;
    }
  }

  @media (max-width: 560px) {
    .writeup-card {
      padding: 1.15rem;
    }

    .card-difficulty {
      min-height: 32px;
      padding: 0.25rem 0.55rem;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      background: var(--card-bg);
    }

    .card-title {
      font-size: 1.12rem;
    }

    .card-summary {
      font-size: 0.92rem;
      line-height: 1.65;
      -webkit-line-clamp: 4;
    }

    .card-tag,
    .card-tag-more {
      padding-block: 0.35rem;
    }

    .card-read-more {
      width: 100%;
      justify-content: center;
    }
  }
</style>
