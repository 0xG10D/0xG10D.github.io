---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Personal cybersecurity archive documenting penetration testing, CTF challenges, DFIR notes, malware analysis, and security tool development.'
} = Astro.props;
const pageTitle = `${title} | 0xG10D`;
---

<!doctype html>
<html lang="en" class="dark-theme">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />

    <!-- Open Graph / Social Meta -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400..700&display=swap" rel="stylesheet">

    <meta name="theme-color" content="#0d0e0c" />
    <meta name="color-scheme" content="dark" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "0xG10D",
        "description": "Personal cybersecurity archive documenting CTF writeups, DFIR notes, penetration testing methodology, and security tool development.",
        "url": "https://0xg10d.github.io",
        "author": {
          "@type": "Person",
          "name": "0xG10D"
        },
        "keywords": ["cybersecurity", "CTF", "writeups", "penetration testing", "security tools"]
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-wrapper">
      <Header />

      <main id="main-content" class="main-content" tabindex="-1">
        <slot />
      </main>

      <Footer />
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const findHashTarget = (hash: string) => {
          try {
            return document.getElementById(decodeURIComponent(hash));
          } catch {
            return document.getElementById(hash);
          }
        };

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          if (!(anchor instanceof HTMLAnchorElement)) return;

          anchor.addEventListener('click', (event) => {
            if (anchor.pathname !== window.location.pathname) return;

            const targetId = anchor.hash.slice(1);
            if (!targetId) return;

            const targetElement = findHashTarget(targetId);
            if (!targetElement) return;

            event.preventDefault();
            targetElement.scrollIntoView({
              behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
              block: 'start'
            });
            targetElement.focus({ preventScroll: true });
          });
        });
      });
    </script>
  </body>
</html>

<style>
  .page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .main-content {
    flex: 1;
  }

  .main-content:focus {
    outline: none;
  }

</style>
