---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'writeups'>;
  headings: Heading[];
}

const { post, headings } = Astro.props;

// Formatting helpers
const platformLabels: Record<string, string> = {
  hackthebox: 'Hack The Box',
  'hack-the-box': 'Hack The Box',
  tryhackme: 'TryHackMe',
  portswigger: 'PortSwigger',
  picoctf: 'picoCTF',
  'international-ctf': 'International CTF',
  'local-ctf': 'Local CTF',
  ctf: 'CTF',
  other: 'Other'
};

const difficultyLabels: Record<string, string> = {
  easy: 'Easy',
  medium: 'Medium',
  hard: 'Hard',
  insane: 'Insane',
  info: 'Information'
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });

const getPlatformLabel = (value: string) => platformLabels[value] ?? value.replaceAll('-', ' ');
const getDifficultyLabel = (value: string) => difficultyLabels[value] ?? value;

const formattedDate = formatDate(post.data.date);
const platformLabel = getPlatformLabel(post.data.platform);
const difficultyLabel = getDifficultyLabel(post.data.difficulty);
const categoryLabel = post.data.category.replaceAll('-', ' ');
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="writeup-article">
    <div class="container">
      <!-- Writeup Header -->
      <header class="writeup-header">
        <div class="writeup-meta">
          <div class="meta-badges">
            <span class="badge badge-platform">{platformLabel}</span>
            <span class="badge badge-difficulty" data-difficulty={post.data.difficulty}>
              {difficultyLabel}
            </span>
            <span class="badge badge-category">{categoryLabel}</span>
          </div>

          <div class="meta-dates">
            <time class="publish-date" datetime={post.data.date.toISOString()}>
              Published: {formattedDate}
            </time>
          </div>
        </div>

        <h1 class="writeup-title">{post.data.title}</h1>

        {post.data.summary && (
          <p class="writeup-summary">{post.data.summary}</p>
        )}


        <dl class="report-meta-grid" aria-label="Report metadata">
          <div>
            <dt>Platform</dt>
            <dd>{platformLabel}</dd>
          </div>
          <div>
            <dt>Difficulty</dt>
            <dd>{difficultyLabel}</dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd>{categoryLabel}</dd>
          </div>
          <div>
            <dt>Tags</dt>
            <dd>{post.data.tags.length}</dd>
          </div>
        </dl>

        {post.data.boxImage && (
          <div class="writeup-featured-image">
            <img
              src={post.data.boxImage}
              alt={`${post.data.title} machine image`}
              loading="lazy"
            />
          </div>
        )}
      </header>

      <!-- Writeup Body -->
      <div class="writeup-body">
        <div class="writeup-content">
          <slot />
        </div>

        <!-- Table of Contents Sidebar -->
        {headings.length > 0 && (
          <aside class="writeup-sidebar">
            <div class="sidebar-sticky">
              <TableOfContents headings={headings} />

              <div class="sidebar-tags">
                <h3 class="sidebar-heading">Tags</h3>
                <div class="tag-cloud">
                  {post.data.tags.map((tag) => (
                    <a
                      href={`/writeups/?tag=${tag}`}
                      class="tag"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              </div>

              <div class="sidebar-actions">
                <a href="/writeups/" class="button button-secondary">
                  <span>Back to Writeups</span>
                </a>
              </div>
            </div>
          </aside>
        )}
      </div>

      <!-- Writeup Footer -->
      <footer class="writeup-footer">
        <div class="writeup-navigation">
          <div class="nav-section">
            <h3 class="nav-heading">More Writeups</h3>
            <div class="nav-links">
              <a href="/writeups/?platform=hackthebox" class="nav-link">
                View all Hack The Box writeups
              </a>
              <a href={`/writeups/?difficulty=${post.data.difficulty}`} class="nav-link">
                View all {difficultyLabel} difficulty writeups
              </a>
            </div>
          </div>

          <div class="nav-section">
            <h3 class="nav-heading">Share</h3>
            <div class="share-buttons">
              <button class="share-button" type="button" data-share-url>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="10" height="10" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span data-share-label>Copy Link</span>
              </button>
            </div>
          </div>
        </div>

        <div class="writeup-disclaimer">
          <h3 class="disclaimer-heading">Disclaimer</h3>
          <p class="disclaimer-text">
            This writeup documents security learning through authorized platforms (Hack The Box, TryHackMe).
            All techniques are demonstrated in controlled, legal environments for educational purposes only.
            Never attempt these techniques on systems you do not own or have explicit permission to test.
          </p>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  /* ===== WRITEUP ARTICLE ===== */
  .writeup-article {
    padding: 6.25rem 0 4rem;
  }

  /* Writeup Header */
  .writeup-header {
    max-width: 980px;
    margin: 0 auto 3rem;
    padding: clamp(1.35rem, 3vw, 2.1rem);
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .writeup-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .meta-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-platform {
    background: var(--panel-elevated);
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  .badge-difficulty {
    background: var(--panel-elevated);
    color: var(--text-secondary);
    border-color: var(--border-subtle);
  }

  .badge-category {
    background: var(--panel-elevated);
    color: var(--text-secondary);
    border-color: var(--border-subtle);
  }

  .meta-dates {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: right;
  }

  .publish-date,
  .update-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted-text);
  }

  .writeup-title {
    font-size: clamp(2.05rem, 3.2vw, 2.65rem);
    font-weight: 750;
    line-height: 1.18;
    margin-bottom: 1rem;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .report-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 1.5rem 0 0;
  }

  .report-meta-grid div {
    padding: 0.8rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-main);
  }

  .report-meta-grid dt {
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .report-meta-grid dt::after {
    content: ":";
  }

  .report-meta-grid dd {
    margin: 0.28rem 0 0;
    color: var(--text-primary);
    font-size: 0.86rem;
    font-weight: 600;
    font-family: var(--font-mono);
    text-transform: capitalize;
  }

  .writeup-summary {
    font-size: clamp(1rem, 1.8vw, 1.08rem);
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.35rem;
    max-width: 760px;
  }

  .writeup-featured-image {
    margin: 1.75rem auto 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-main);
    max-width: 860px;
  }

  .writeup-featured-image img {
    width: 100%;
    max-height: 380px;
    height: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  /* Writeup Body */
  .writeup-body {
    display: grid;
    grid-template-columns: minmax(0, 840px) minmax(240px, 280px);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
    justify-content: center;
  }

  .writeup-content {
    max-width: 840px;
    min-width: 0;
    margin: 0 auto;
    overflow-wrap: anywhere;
  }

  /* Content styling for markdown */
  .writeup-content :global(*) {
    margin-bottom: 1.35rem;
  }

  .writeup-content :global(h2) {
    font-size: clamp(1.45rem, 3.5vw, 1.85rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-subtle);
  }

  .writeup-content :global(h3) {
    font-size: clamp(1.18rem, 3vw, 1.38rem);
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .writeup-content :global(p) {
    font-size: clamp(1rem, 1.6vw, 1.06rem);
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .writeup-content :global(code) {
    font-family: var(--font-mono);
    background: var(--panel-elevated);
    color: var(--text-primary);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
    border: 1px solid var(--border-subtle);
  }

  .writeup-content :global(pre) {
    max-width: 100%;
    background: var(--bg-main);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 2rem 0;
    box-shadow: none;
    scrollbar-color: var(--border-medium) var(--bg-main);
    -webkit-overflow-scrolling: touch;
  }

  .writeup-content :global(pre[data-language="bash"]),
  .writeup-content :global(pre[data-language="sh"]),
  .writeup-content :global(pre[data-language="shell"]),
  .writeup-content :global(pre[data-language="zsh"]),
  .writeup-content :global(pre[data-language="console"]) {
    padding: 0;
    overflow-x: auto;
    background: var(--bg-main);
    border-color: var(--border-medium);
    box-shadow: none;
  }

  .writeup-content :global(pre[data-language="bash"]::before),
  .writeup-content :global(pre[data-language="sh"]::before),
  .writeup-content :global(pre[data-language="shell"]::before),
  .writeup-content :global(pre[data-language="zsh"]::before),
  .writeup-content :global(pre[data-language="console"]::before) {
    content: "0xG10D@kali:~$";
    position: sticky;
    left: 0;
    display: block;
    min-width: max-content;
    padding: 0.75rem 1.25rem 0.75rem 4.35rem;
    background:
      radial-gradient(circle at 1.3rem 50%, #888 0 0.28rem, transparent 0.3rem),
      radial-gradient(circle at 2.15rem 50%, #666 0 0.28rem, transparent 0.3rem),
      radial-gradient(circle at 3rem 50%, #aaa 0 0.28rem, transparent 0.3rem),
      var(--panel-elevated);
    border-bottom: 1px solid var(--border-medium);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .writeup-content :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 0.9rem;
    line-height: 1.58;
    color: var(--text-primary);
    white-space: pre;
  }

  .writeup-content :global(pre[data-language="bash"] code),
  .writeup-content :global(pre[data-language="sh"] code),
  .writeup-content :global(pre[data-language="shell"] code),
  .writeup-content :global(pre[data-language="zsh"] code),
  .writeup-content :global(pre[data-language="console"] code) {
    display: block;
    min-width: max-content;
    padding: 1.25rem;
  }

  .writeup-content :global(blockquote) {
    border-left: 4px solid var(--border-medium);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--text-secondary);
    font-style: italic;
    background: var(--panel-elevated);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 1.25rem;
  }

  .writeup-content :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    overflow-x: auto;
    scrollbar-color: var(--border-medium) var(--bg-main);
    -webkit-overflow-scrolling: touch;
  }

  .writeup-content :global(th) {
    background: var(--panel-elevated);
    color: var(--text-primary);
    font-weight: 600;
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border-medium);
  }

  .writeup-content :global(td) {
    padding: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .writeup-content :global(tr:last-child td) {
    border-bottom: none;
  }

  .writeup-content :global(ul),
  .writeup-content :global(ol) {
    padding-left: 1.5rem;
    margin: 1.5rem 0;
  }

  .writeup-content :global(li) {
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .writeup-content :global(img) {
    max-width: 100%;
    width: auto;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    margin: 2rem 0;
  }

  /* Writeup Sidebar */
  .writeup-sidebar {
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .sidebar-sticky {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
  }

  .sidebar-tags {
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-cloud .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-text);
    background: transparent;
    padding: 0.22rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    transition: all var(--motion-fast) var(--motion-ease);
  }

  .tag-cloud .tag:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
    background: var(--panel-elevated);
  }

  .sidebar-actions {
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  /* Writeup Footer */
  .writeup-footer {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-subtle);
  }

  .writeup-navigation {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .nav-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nav-heading {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-link {
    color: var(--text-secondary);
    font-size: 0.95rem;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .share-buttons {
    display: flex;
    gap: 0.75rem;
  }

  .share-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--card-bg);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--motion-fast) var(--motion-ease);
  }

  .share-button:hover {
    border-color: var(--border-medium);
    color: var(--text-primary);
    background: var(--panel-elevated);
  }

  .share-button svg {
    width: 16px;
    height: 16px;
  }

  .writeup-disclaimer {
    padding: 2rem;
    background: var(--card-bg);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
  }

  .disclaimer-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    margin-bottom: 1rem;
  }

  .disclaimer-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted-text);
    margin: 0;
  }

  /* ===== RESPONSIVE DESIGN ===== */
  @media (max-width: 1024px) {
    .writeup-body {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .writeup-sidebar {
      position: static;
      max-height: none;
    }
  }

  @media (max-width: 768px) {
    .writeup-article {
      padding: 5.25rem 0 2rem;
    }

    .writeup-header {
      margin-bottom: 2rem;
      padding: 1.1rem;
    }

    .writeup-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .meta-dates {
      text-align: left;
    }

    .writeup-title {
      font-size: clamp(1.8rem, 8vw, 2.1rem);
    }

    .writeup-summary {
      font-size: 0.98rem;
      line-height: 1.7;
      margin-bottom: 1.25rem;
    }

    .writeup-featured-image img {
      max-height: 260px;
    }

    .report-meta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .writeup-content {
      max-width: 100%;
    }

    .writeup-content :global(h2) {
      margin-top: 2.25rem;
      margin-bottom: 1rem;
    }

    .writeup-content :global(h3) {
      margin-top: 2rem;
    }

    .writeup-content :global(pre) {
      margin: 1.5rem calc(var(--container-padding) * -0.35);
      padding: 1rem;
      border-radius: var(--radius-md);
    }

    .writeup-content :global(pre[data-language="bash"]::before),
    .writeup-content :global(pre[data-language="sh"]::before),
    .writeup-content :global(pre[data-language="shell"]::before),
    .writeup-content :global(pre[data-language="zsh"]::before),
    .writeup-content :global(pre[data-language="console"]::before) {
      padding-left: 3.8rem;
      font-size: 0.72rem;
    }

    .writeup-content :global(pre code) {
      font-size: 0.82rem;
      line-height: 1.55;
    }

    .writeup-content :global(table) {
      margin: 1.5rem 0;
      font-size: 0.9rem;
    }

    .writeup-content :global(th),
    .writeup-content :global(td) {
      padding: 0.75rem;
      min-width: 9rem;
    }

    .sidebar-sticky {
      gap: 1rem;
    }

    .sidebar-tags,
    .sidebar-actions,
    .writeup-disclaimer {
      padding: 1rem;
    }

    .writeup-navigation {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .meta-badges {
      flex-direction: column;
      align-items: flex-start;
    }

    .writeup-title {
      font-size: clamp(1.7rem, 9vw, 1.95rem);
    }

    .badge {
      width: 100%;
      justify-content: center;
      text-align: center;
      padding-inline: 0.75rem;
    }

    .report-meta-grid {
      grid-template-columns: 1fr;
    }

    .share-buttons {
      flex-direction: column;
    }

    .share-button {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-share-url]').forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;

    button.addEventListener('click', async () => {
      if (!navigator.clipboard) return;
      await navigator.clipboard.writeText(window.location.href);
      const label = button.querySelector('[data-share-label]');
      if (label) {
        const previous = label.textContent || 'Copy Link';
        label.textContent = 'Copied';
        window.setTimeout(() => { label.textContent = previous; }, 1600);
      }
    });
  });
</script>
