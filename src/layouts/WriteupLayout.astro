---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import {
  formatArchiveDate,
  getCategoryLabel,
  getChallengeType,
  getWriteupUrl
} from '../utils/writeups';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'writeups'>;
  headings: Heading[];
}

const { post, headings } = Astro.props;

const difficultyLabels: Record<string, string> = {
  easy: 'Easy',
  medium: 'Medium',
  hard: 'Hard',
  insane: 'Insane',
  info: 'Information'
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });

const categoryLabel = getCategoryLabel(post.data.category);
const difficultyLabel = difficultyLabels[post.data.difficulty] ?? post.data.difficulty;

const wordCount = post.body ? post.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const allWriteups = await getCollection('writeups', ({ data }) => !data.draft);
const sameCategory = allWriteups
  .filter((entry) => entry.id !== post.id && entry.data.category === post.data.category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const others = allWriteups
  .filter((entry) => entry.id !== post.id && entry.data.category !== post.data.category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const related = [...sameCategory, ...others].slice(0, 3);
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="writeup-article">
    <nav class="writeup-breadcrumb" aria-label="Breadcrumb">
      <div class="writeup-breadcrumb-inner">
        <a href="/">Home</a>
        <svg class="crumb-chevron" viewBox="0 0 12 12" width="10" height="10" fill="none" aria-hidden="true">
          <path d="M4.5 2.5L8 6l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <a href="/writeups/">Archive</a>
        <svg class="crumb-chevron" viewBox="0 0 12 12" width="10" height="10" fill="none" aria-hidden="true">
          <path d="M4.5 2.5L8 6l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="crumb-current">{categoryLabel}</span>
      </div>
    </nav>

    <header class="writeup-hero">
      <h1>{post.data.title}</h1>

      {post.data.summary && <p class="writeup-hero-excerpt">{post.data.summary}</p>}

      <div class="writeup-hero-meta">
        <span>By <span class="meta-accent">0xG10D</span></span>
        <span class="meta-sep">|</span>
        <span>Last updated: {formatDate(post.data.date)}</span>
        <span class="meta-sep">|</span>
        <span>{readMinutes} minute{readMinutes === 1 ? '' : 's'} read</span>
      </div>

      <div class="writeup-hero-pills" aria-label="Writeup details">
        <span class="hero-pill hero-pill-accent">{difficultyLabel}</span>
        {post.data.tags.map((tag) => <span class="hero-pill">#{tag}</span>)}
      </div>
    </header>

    {post.data.boxImage && (
      <div class="writeup-featured">
        <div class="writeup-featured-frame">
          <img src={post.data.boxImage} alt={`${post.data.title} reference image`} loading="eager" decoding="async" />
        </div>
      </div>
    )}

    <div class="writeup-main">
      <div class="writeup-content">
        <slot />
      </div>

      <aside class="writeup-aside">
        <div class="writeup-aside-sticky">
          {headings.length > 0 && <TableOfContents headings={headings} />}

          <button class="share-button" type="button" data-share-url>
            <span data-share-label aria-live="polite">Copy link</span>
          </button>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="writeup-related">
        <h2>Related Writeups</h2>

        <div class="related-grid">
          {related.map((item) => (
            <a class="related-card" href={getWriteupUrl(item)}>
              {item.data.boxImage ? (
                <div class="related-media">
                  <img src={item.data.boxImage} alt="" loading="lazy" decoding="async" />
                </div>
              ) : (
                <div class="related-media related-media-empty">
                  <span>{getCategoryLabel(item.data.category)}</span>
                </div>
              )}

              <div class="related-body">
                <p class="related-meta">
                  <time datetime={item.data.date.toISOString()}>{formatArchiveDate(item.data.date)}</time>
                  <span>{getChallengeType(item)}</span>
                </p>
                <h3 class="related-title">{item.data.title}</h3>
                <span class="related-more">Read more</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <p class="writeup-disclaimer">
      Authorized security practice only. These notes are for lab, CTF, and explicitly permitted environments.
    </p>
  </article>
</BaseLayout>

<style>
  .writeup-article {
    padding: clamp(2rem, 6vw, 3rem) 0 4rem;
  }

  /* ----- breadcrumb ----- */

  .writeup-breadcrumb-inner {
    display: flex;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
    align-items: center;
    gap: 0.5rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .writeup-breadcrumb-inner a {
    color: var(--text-faint);
    text-decoration: none;
  }

  .writeup-breadcrumb-inner a:hover {
    color: var(--text);
  }

  .crumb-chevron {
    flex-shrink: 0;
    color: var(--text-faint);
    opacity: 0.6;
  }

  .crumb-current {
    color: var(--accent-strong);
  }

  /* ----- hero ----- */

  .writeup-hero {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
    text-align: center;
  }

  .writeup-hero h1 {
    max-width: none;
    margin-bottom: 1.25rem;
    font-size: clamp(2.1rem, 4.6vw, 3.2rem);
    line-height: 1.14;
  }

  .writeup-hero-excerpt {
    max-width: 60ch;
    margin: 0 auto 2rem;
    color: var(--text-soft);
    font-size: clamp(1.05rem, 1.8vw, 1.18rem);
    line-height: 1.75;
  }

  .writeup-hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem 1rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .meta-accent {
    color: var(--accent-strong);
  }

  .meta-sep {
    color: var(--text-faint);
    opacity: 0.4;
  }

  .writeup-hero-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .hero-pill-accent {
    border-color: color-mix(in srgb, var(--accent-strong) 45%, transparent);
    color: var(--accent-strong);
  }

  /* ----- featured image ----- */

  .writeup-featured {
    max-width: 56rem;
    margin: clamp(2rem, 5vw, 3rem) auto 0;
    padding: 0 var(--gutter);
  }

  .writeup-featured-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    padding: clamp(0.75rem, 3vw, 1.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-code);
    overflow: hidden;
  }

  .writeup-featured-frame img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* ----- main grid ----- */

  .writeup-main {
    display: grid;
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--gutter);
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .writeup-main {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }

    .writeup-content {
      grid-column: 2;
      grid-row: 1;
    }

    .writeup-aside {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .writeup-aside-sticky {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .writeup-aside-sticky {
      position: sticky;
      top: 7rem;
    }
  }

  .writeup-content {
    min-width: 0;
  }

  .writeup-content :global(h2),
  .writeup-content :global(h3),
  .writeup-content :global(h4),
  .writeup-content :global(h5),
  .writeup-content :global(h6) {
    scroll-margin-top: 88px;
  }

  .writeup-content :global(h1) {
    margin: 2.5rem 0 1rem;
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
  }

  .writeup-content :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: clamp(1.5rem, 2.8vw, 1.875rem);
    font-weight: 700;
  }

  .writeup-content :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 700;
  }

  .writeup-content :global(h4) {
    margin: 1.5rem 0 0.75rem;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .writeup-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .writeup-content :global(p),
  .writeup-content :global(li) {
    color: var(--text-soft);
    line-height: 1.78;
  }

  .writeup-content :global(a) {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .writeup-content :global(a:hover) {
    color: var(--text);
  }

  .writeup-content :global(code) {
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-code);
    color: #d8cb98;
    font-size: 0.88em;
  }

  .writeup-content :global(pre) {
    margin: 1.5rem 0;
    padding: 1rem;
  }

  .writeup-content :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
  }

  .writeup-content :global(blockquote) {
    margin: 1.75rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    border-left: 3px solid var(--accent-strong);
    color: var(--text-soft);
    font-style: italic;
  }

  .writeup-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .writeup-content :global(table) {
    display: block;
    max-width: 100%;
    margin: 1.75rem 0;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }

  .writeup-content :global(img) {
    display: block;
    max-width: 100%;
    margin: 1.75rem 0 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-code);
  }

  .writeup-content :global(figure) {
    margin: 1.75rem 0;
  }

  .writeup-content :global(figcaption) {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .writeup-content :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .writeup-content :global(ul),
  .writeup-content :global(ol) {
    margin: 1rem 0 1.5rem;
    padding-left: 1.35rem;
  }

  .writeup-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .share-button {
    width: 100%;
    min-height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: color var(--motion), border-color var(--motion);
  }

  .share-button:hover {
    border-color: var(--accent-strong);
    color: var(--accent-strong);
  }

  /* ----- related writeups ----- */

  .writeup-related {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--gutter) clamp(2rem, 5vw, 3rem);
  }

  .writeup-related h2 {
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
    font-size: clamp(1.5rem, 3vw, 2rem);
    text-align: center;
  }

  .related-grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .related-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .related-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-panel);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color var(--motion), background-color var(--motion);
  }

  .related-card:hover {
    border-color: var(--accent);
    background: var(--bg-raised);
  }

  .related-card:hover .related-media img {
    transform: scale(1.04);
  }

  .related-card:hover .related-title {
    color: var(--accent-strong);
  }

  .related-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--bg-code);
  }

  .related-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--motion-enter);
  }

  .related-media-empty {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .related-media-empty span {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .related-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.1rem 1.2rem 1.25rem;
  }

  .related-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .related-meta time {
    color: var(--text-muted);
  }

  .related-meta span:not(time) {
    color: var(--accent-strong);
  }

  .related-title {
    margin: 0 0 0.9rem;
    font-size: 1.1rem;
    line-height: 1.32;
    transition: color var(--motion);
  }

  .related-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .related-more::after {
    content: "->";
  }

  /* ----- end note ----- */

  .writeup-disclaimer {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2rem) var(--gutter) 0;
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.85rem;
    font-style: italic;
    text-align: center;
  }
</style>

<script>
  document.querySelectorAll('[data-share-url]').forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;

    button.addEventListener('click', async () => {
      const label = button.querySelector('[data-share-label]');
      const previous = label?.textContent || 'Copy link';

      try {
        if (!navigator.clipboard) throw new Error('Clipboard API unavailable');
        const timeout = new Promise<never>((_, reject) => {
          window.setTimeout(() => reject(new Error('Clipboard write timed out')), 2000);
        });
        await Promise.race([navigator.clipboard.writeText(window.location.href), timeout]);
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Copy failed - select URL manually';
      }

      if (label) {
        window.setTimeout(() => { label.textContent = previous; }, 1600);
      }
    });
  });
</script>
