---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getChallengeType, getEventName, getEventSlug } from '../utils/writeups';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'writeups'>;
  headings: Heading[];
}

const { post, headings } = Astro.props;

const platformLabels: Record<string, string> = {
  hackthebox: 'Hack The Box',
  'hack-the-box': 'Hack The Box',
  tryhackme: 'TryHackMe',
  portswigger: 'PortSwigger',
  picoctf: 'picoCTF',
  research: 'Research',
  ctf: 'CTF',
  other: 'Other'
};

const difficultyLabels: Record<string, string> = {
  easy: 'Easy',
  medium: 'Medium',
  hard: 'Hard',
  insane: 'Insane',
  info: 'Information'
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });

const platformLabel = platformLabels[post.data.platform] ?? post.data.platform.replaceAll('-', ' ');
const difficultyLabel = difficultyLabels[post.data.difficulty] ?? post.data.difficulty;
const categoryLabel = getChallengeType(post);
const eventLabel = getEventName(getEventSlug(post));
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="writeup-article">
    <div class="container">
      <header class="writeup-header">
        <a class="back-link" href="/writeups/">Back to writeups</a>

        <p class="writeup-kicker">{eventLabel}</p>
        <h1>{post.data.title}</h1>

        {post.data.summary && <p class="writeup-summary">{post.data.summary}</p>}

        <dl class="report-meta-grid" aria-label="Report metadata">
          <div>
            <dt>Date</dt>
            <dd><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></dd>
          </div>
          <div>
            <dt>Platform</dt>
            <dd>{platformLabel}</dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd>{categoryLabel}</dd>
          </div>
          <div>
            <dt>Difficulty</dt>
            <dd>{difficultyLabel}</dd>
          </div>
        </dl>

        {post.data.tags.length > 0 && (
          <div class="writeup-tags" aria-label="Tags">
            {post.data.tags.map((tag) => <span>#{tag}</span>)}
          </div>
        )}

        {post.data.boxImage && (
          <figure class="writeup-featured-image">
            <img src={post.data.boxImage} alt={`${post.data.title} reference image`} loading="lazy" decoding="async" />
          </figure>
        )}
      </header>

      <div class="writeup-body">
        <div class="writeup-content">
          <slot />
        </div>

        {headings.length > 0 && (
          <aside class="writeup-sidebar">
            <TableOfContents headings={headings} />
            <button class="share-button" type="button" data-share-url>
              <span data-share-label>Copy link</span>
            </button>
          </aside>
        )}
      </div>

      <footer class="writeup-footer">
        <p>
          Authorized security practice only. These notes are for lab, CTF, and explicitly permitted environments.
        </p>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .writeup-article {
    padding: clamp(2rem, 6vw, 4.5rem) 0 4rem;
  }

  .writeup-header {
    max-width: 940px;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1.25rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link::before {
    content: "<-";
    margin-right: 0.45rem;
    color: var(--accent);
  }

  .writeup-kicker {
    margin: 0 0 0.85rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .writeup-header h1 {
    max-width: 18ch;
    margin-bottom: 1rem;
  }

  .writeup-summary {
    max-width: 74ch;
    color: var(--text-soft);
    font-size: clamp(1.08rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  .report-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 2rem 0 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .report-meta-grid div {
    min-width: 0;
    padding: 0.86rem 1rem 0.86rem 0;
  }

  .report-meta-grid dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .report-meta-grid dd {
    margin: 0.28rem 0 0;
    color: var(--text);
  }

  .writeup-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
    margin-top: 1rem;
  }

  .writeup-tags span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .writeup-featured-image {
    margin: 2rem 0 0;
    border: 1px solid var(--border);
    background: var(--bg-code);
  }

  .writeup-featured-image img {
    display: block;
    width: 100%;
  }

  .writeup-body {
    display: grid;
    grid-template-columns: minmax(0, var(--reading)) minmax(220px, 280px);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .writeup-content {
    min-width: 0;
    max-width: var(--reading);
  }

  .writeup-content :global(h2),
  .writeup-content :global(h3),
  .writeup-content :global(h4),
  .writeup-content :global(h5),
  .writeup-content :global(h6) {
    scroll-margin-top: 88px;
  }

  .writeup-content :global(h1) {
    margin: 2.75rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
  }

  .writeup-content :global(h2) {
    margin: 3rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: clamp(1.55rem, 3vw, 2.18rem);
  }

  .writeup-content :global(h3) {
    margin: 2.15rem 0 0.75rem;
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
  }

  .writeup-content :global(h4) {
    margin: 1.7rem 0 0.65rem;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.96rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .writeup-content :global(p),
  .writeup-content :global(li) {
    color: var(--text-soft);
    line-height: 1.78;
  }

  .writeup-content :global(a) {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  .writeup-content :global(code) {
    padding: 0.1rem 0.28rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-code);
    color: #d8cb98;
    font-size: 0.88em;
  }

  .writeup-content :global(pre) {
    margin: 1.5rem 0;
    padding: 1rem;
  }

  .writeup-content :global(pre code) {
    padding: 0;
    color: var(--text);
  }

  .writeup-content :global(blockquote) {
    margin: 1.75rem 0;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-soft);
    color: var(--text-soft);
  }

  .writeup-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .writeup-content :global(table) {
    display: block;
    max-width: 100%;
    margin: 1.75rem 0;
    overflow-x: auto;
    border: 1px solid var(--border);
  }

  .writeup-content :global(img) {
    display: block;
    max-width: 100%;
    margin: 1.75rem 0 0.6rem;
    border: 1px solid var(--border);
    background: var(--bg-code);
  }

  .writeup-content :global(figure) {
    margin: 1.75rem 0;
  }

  .writeup-content :global(figcaption) {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .writeup-content :global(ul),
  .writeup-content :global(ol) {
    margin: 1rem 0 1.5rem;
    padding-left: 1.35rem;
  }

  .writeup-sidebar {
    position: sticky;
    top: 88px;
    display: grid;
    gap: 1rem;
  }

  .share-button {
    width: 100%;
    min-height: 38px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-weight: 700;
  }

  .share-button:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .writeup-footer {
    max-width: var(--reading);
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .writeup-footer p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 980px) {
    .writeup-body {
      grid-template-columns: 1fr;
    }

    .writeup-sidebar {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 720px) {
    .report-meta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    .report-meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-share-url]').forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;

    button.addEventListener('click', async () => {
      if (!navigator.clipboard) return;
      await navigator.clipboard.writeText(window.location.href);
      const label = button.querySelector('[data-share-label]');
      if (label) {
        const previous = label.textContent || 'Copy link';
        label.textContent = 'Copied';
        window.setTimeout(() => { label.textContent = previous; }, 1600);
      }
    });
  });
</script>
