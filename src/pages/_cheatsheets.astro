---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityIcon from '../components/SecurityIcon.astro';
import { categoryOrder, cheatSheets, cveResearchLinks } from '../data/cheatsheets';

const totalCommands = cheatSheets.reduce((total, sheet) => total + sheet.commands.length, 0);
const allTags = [...new Set(cheatSheets.flatMap((sheet) => sheet.tags))].sort();
const categoryCounts = categoryOrder.map((category) => ({
  category,
  count: cheatSheets.filter((sheet) => sheet.category === category).length
}));
---

<BaseLayout
  title="Cybersecurity Cheat Sheets"
  description="Searchable cybersecurity quick-reference hub for CTF, labs, Hack The Box, TryHackMe, and authorized security testing."
>
  <div class="cheatsheets-page">
    <section class="cheatsheets-hero section">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-eyebrow">authorized quick reference</p>
            <h1>Cheat sheets</h1>
            <p>
              Searchable notes for CTFs, labs, Hack The Box, TryHackMe, and approved testing.
              Commands keep placeholder targets and scope warnings visible.
            </p>
          </div>

          <dl class="hero-panel" aria-label="Cheat sheet summary">
            <div><dt>Cards</dt><dd>{cheatSheets.length}</dd></div>
            <div><dt>Categories</dt><dd>{categoryOrder.length}</dd></div>
            <div><dt>Commands</dt><dd>{totalCommands}</dd></div>
            <div><dt>Tags</dt><dd>{allTags.length}</dd></div>
          </dl>
        </div>

        <div class="cheatsheet-controls" aria-label="Cheat sheet filters">
          <label class="search-group">
            <span>Search references</span>
            <input
              id="cheatsheet-search"
              type="search"
              autocomplete="off"
              placeholder="Search commands, tags, category, or description"
              aria-label="Search cheat sheets"
            />
          </label>

          <div class="filter-group" aria-label="Category filters">
            <button class="filter-chip active" type="button" data-category-filter="all">All</button>
            {categoryOrder.map((category) => (
              <button class="filter-chip" type="button" data-category-filter={category}>
                {category}
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="category-band" aria-label="Category overview">
      <div class="container">
        <div class="category-grid">
          {categoryCounts.map(({ category, count }) => (
            <button class="category-tile" type="button" data-category-filter={category}>
              <span>{category}</span>
              <strong>{count}</strong>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="section sheets-section">
      <div class="container">
        <div class="results-line" aria-live="polite">
          <span><strong id="cheatsheet-count">{cheatSheets.length}</strong> cards visible</span>
          <button type="button" class="clear-button" data-clear-filters>Clear filters</button>
        </div>

        <div class="sheets-grid" id="cheatsheet-grid">
          {cheatSheets.map((sheet) => {
            const searchText = [
              sheet.title,
              sheet.category,
              sheet.description,
              ...sheet.tags,
              ...sheet.notes,
              ...sheet.commands.flatMap((command) => [command.label, command.code])
            ].join(' ').toLowerCase();

            return (
              <article
                class="sheet-card"
                data-cheatsheet-card
                data-category={sheet.category}
                data-search={searchText}
              >
                <header class="sheet-header">
                  <SecurityIcon name={sheet.icon} size={21} />
                  <div>
                    <p>{sheet.category}</p>
                    <h2>{sheet.title}</h2>
                  </div>
                </header>

                <p class="sheet-description">{sheet.description}</p>

                {sheet.warning && (
                  <p class="sheet-warning">
                    <SecurityIcon name="shield" size={15} />
                    <span>{sheet.warning}</span>
                  </p>
                )}

                <div class="command-list">
                  {sheet.commands.map((command) => (
                    <div class="command-block">
                      <div class="command-head">
                        <span>{command.label}</span>
                        {command.copy !== false && (
                          <button type="button" class="copy-button" data-copy-command aria-label={`Copy ${command.label}`}>
                            Copy
                          </button>
                        )}
                      </div>
                      <pre><code>{command.code}</code></pre>
                    </div>
                  ))}
                </div>

                <ul class="sheet-notes">
                  {sheet.notes.map((note) => <li>{note}</li>)}
                </ul>

                {sheet.links && sheet.links.length > 0 && (
                  <div class="sheet-links">
                    {sheet.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label}
                        <SecurityIcon name="external" size={14} />
                      </a>
                    ))}
                  </div>
                )}

                <div class="sheet-tags" aria-label={`${sheet.title} tags`}>
                  {sheet.tags.map((tag) => (
                    <button type="button" data-tag-filter={tag}>#{tag}</button>
                  ))}
                </div>
              </article>
            );
          })}
        </div>

        <div class="empty-state" id="cheatsheet-empty" hidden>
          <h2>No matching cheat sheets</h2>
          <p>Clear filters or search for a broader technique, tool, or category.</p>
          <button type="button" class="button button-primary" data-clear-filters>Clear filters</button>
        </div>
      </div>
    </section>

    <section class="section cve-section">
      <div class="container">
        <div class="cve-layout">
          <div>
            <p class="hero-eyebrow">CVE workflow</p>
            <h2>CVE and exploit research</h2>
            <p>
              Use this as a source checklist. Do not invent live CVE details. Verify affected versions,
              fixed versions, exploitability, and patch status from primary sources.
            </p>
          </div>

          <div class="cve-card">
            <h3>Placeholder record format</h3>
            <dl>
              <div><dt>CVE</dt><dd>CVE-YYYY-NNNN</dd></div>
              <div><dt>Vendor advisory</dt><dd>Official advisory URL</dd></div>
              <div><dt>Affected version</dt><dd>Verified vulnerable range</dd></div>
              <div><dt>Fixed version</dt><dd>Patched release or mitigation</dd></div>
              <div><dt>CVSS / CWE</dt><dd>Score, vector, and weakness class</dd></div>
              <div><dt>Exploitability</dt><dd>Auth, reachability, prerequisites, patch status</dd></div>
            </dl>
          </div>
        </div>

        <div class="research-links">
          {cveResearchLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              <span>{link.label}</span>
              <SecurityIcon name="external" size={14} />
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .cheatsheets-hero {
    border-bottom: 1px solid var(--border);
  }

  .hero-grid,
  .cve-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.55fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: end;
  }

  .hero-eyebrow {
    margin: 0 0 0.9rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero-copy h1 {
    margin-bottom: 1rem;
  }

  .hero-copy p:not(.hero-eyebrow) {
    max-width: 72ch;
    font-size: 1.08rem;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .hero-panel div {
    padding: 0.9rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .hero-panel dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .hero-panel dd {
    margin: 0.2rem 0 0;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 1.6rem;
    line-height: 1;
  }

  .cheatsheet-controls {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .search-group {
    display: grid;
    gap: 0.45rem;
  }

  .search-group span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .search-group input {
    width: 100%;
    min-height: 46px;
    padding: 0.72rem 0.82rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-code);
    color: var(--text);
  }

  .filter-group,
  .sheet-tags,
  .sheet-links,
  .research-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .filter-chip,
  .sheet-tags button,
  .clear-button,
  .category-tile,
  .copy-button {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-weight: 700;
  }

  .filter-chip,
  .clear-button {
    min-height: 36px;
    padding: 0.4rem 0.68rem;
    font-size: 0.82rem;
  }

  .filter-chip:hover,
  .filter-chip.active,
  .sheet-tags button:hover,
  .sheet-tags button.active,
  .category-tile:hover,
  .category-tile.active,
  .clear-button:hover,
  .copy-button:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .category-band {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.55rem;
  }

  .category-tile {
    display: flex;
    min-height: 40px;
    justify-content: space-between;
    gap: 0.7rem;
    align-items: center;
    padding: 0.58rem 0.68rem;
    text-align: left;
  }

  .category-tile span {
    min-width: 0;
    font-size: 0.84rem;
  }

  .category-tile strong {
    color: var(--accent-strong);
    font-family: var(--font-mono);
  }

  .sheets-section {
    padding-top: 2rem;
  }

  .results-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.25rem;
    color: var(--text-muted);
  }

  .results-line strong {
    color: var(--accent-strong);
    font-family: var(--font-mono);
  }

  .sheets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .sheet-card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    gap: 1rem;
    padding: 1.1rem;
  }

  .sheet-header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    align-items: start;
  }

  .sheet-header svg {
    color: var(--steel);
    margin-top: 0.18rem;
  }

  .sheet-header p {
    margin: 0 0 0.25rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .sheet-header h2 {
    font-size: 1.18rem;
  }

  .sheet-description {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.95rem;
  }

  .sheet-warning {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem;
    margin: 0;
    padding: 0.68rem;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--accent-strong);
    font-size: 0.84rem;
  }

  .sheet-warning svg {
    margin-top: 0.12rem;
  }

  .command-list {
    display: grid;
    gap: 0.72rem;
  }

  .command-block {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-code);
  }

  .command-head {
    display: flex;
    min-height: 36px;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.42rem 0.55rem 0.42rem 0.68rem;
    border-bottom: 1px solid var(--border);
  }

  .command-head span {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .copy-button {
    min-height: 28px;
    padding: 0.22rem 0.52rem;
    font-size: 0.72rem;
  }

  .copy-button.copied {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .command-block pre {
    margin: 0;
    padding: 0.8rem;
    border: 0;
  }

  .command-block code {
    color: var(--text);
    font-size: 0.82rem;
    line-height: 1.55;
    white-space: pre;
  }

  .sheet-notes {
    display: grid;
    gap: 0.48rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .sheet-links a,
  .research-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-weight: 700;
    text-decoration: none;
  }

  .sheet-links a {
    padding: 0.4rem 0.58rem;
    font-size: 0.8rem;
  }

  .research-links a {
    padding: 0.58rem 0.68rem;
    font-size: 0.86rem;
  }

  .sheet-links a:hover,
  .research-links a:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .sheet-tags {
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .sheet-tags button {
    min-height: 30px;
    padding: 0.28rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .cve-section {
    border-top: 1px solid var(--border);
  }

  .cve-layout {
    align-items: start;
    margin-bottom: 1.5rem;
  }

  .cve-layout h2 {
    margin-bottom: 0.8rem;
  }

  .cve-layout p:not(.hero-eyebrow) {
    max-width: 64ch;
  }

  .cve-card {
    padding: 1.1rem;
  }

  .cve-card h3 {
    margin-bottom: 1rem;
    font-size: 1.15rem;
  }

  .cve-card dl {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .cve-card div {
    display: grid;
    grid-template-columns: minmax(120px, 0.45fr) minmax(0, 1fr);
    gap: 0.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border);
  }

  .cve-card div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .cve-card dt {
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .cve-card dd {
    margin: 0;
    color: var(--text-soft);
  }

  @media (max-width: 980px) {
    .hero-grid,
    .cve-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-panel,
    .sheets-grid {
      grid-template-columns: 1fr;
    }

    .results-line {
      align-items: flex-start;
      flex-direction: column;
    }

    .cve-card div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  @media (max-width: 380px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = Array.from(document.querySelectorAll('[data-cheatsheet-card]'))
      .filter((card): card is HTMLElement => card instanceof HTMLElement);
    const searchInput = document.getElementById('cheatsheet-search');
    const countElement = document.getElementById('cheatsheet-count');
    const emptyState = document.getElementById('cheatsheet-empty');
    const grid = document.getElementById('cheatsheet-grid');
    const categoryButtons = Array.from(document.querySelectorAll('[data-category-filter]'))
      .filter((button): button is HTMLButtonElement => button instanceof HTMLButtonElement);
    const tagButtons = Array.from(document.querySelectorAll('[data-tag-filter]'))
      .filter((button): button is HTMLButtonElement => button instanceof HTMLButtonElement);
    let activeCategory = 'all';
    let activeTag = '';

    function getSearchTerm() {
      return searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
    }

    function setActiveCategory(category: string) {
      activeCategory = category;
      categoryButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.categoryFilter === category);
      });
    }

    function setActiveTag(tag: string) {
      activeTag = tag;
      tagButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.tagFilter === tag);
      });
    }

    function filterCards() {
      const searchTerm = getSearchTerm();
      let visible = 0;

      cards.forEach((card) => {
        const category = card.dataset.category || '';
        const search = card.dataset.search || '';
        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesTag = !activeTag || search.includes(activeTag.toLowerCase());
        const matchesSearch = !searchTerm || search.includes(searchTerm);
        const shouldShow = matchesCategory && matchesTag && matchesSearch;

        card.hidden = !shouldShow;
        if (shouldShow) visible += 1;
      });

      if (countElement) countElement.textContent = String(visible);
      if (grid && emptyState) {
        grid.hidden = visible === 0;
        emptyState.hidden = visible !== 0;
      }
    }

    searchInput?.addEventListener('input', filterCards);

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setActiveCategory(button.dataset.categoryFilter || 'all');
        filterCards();
        document.querySelector('.sheets-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const tag = button.dataset.tagFilter || '';
        setActiveTag(activeTag === tag ? '' : tag);
        filterCards();
      });
    });

    document.querySelectorAll('[data-clear-filters]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener('click', () => {
        if (searchInput instanceof HTMLInputElement) searchInput.value = '';
        setActiveCategory('all');
        setActiveTag('');
        filterCards();
      });
    });

    document.querySelectorAll('[data-copy-command]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      button.addEventListener('click', async () => {
        const block = button.closest('.command-block');
        const code = block?.querySelector('code')?.textContent;
        if (!code || !navigator.clipboard) return;

        await navigator.clipboard.writeText(code);
        const previous = button.textContent || 'Copy';
        button.textContent = 'Copied';
        button.classList.add('copied');
        window.setTimeout(() => {
          button.textContent = previous;
          button.classList.remove('copied');
        }, 1400);
      });
    });

    filterCards();
  });
</script>
