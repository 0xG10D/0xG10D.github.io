---
import BaseLayout from '../layouts/BaseLayout.astro';
import achievementContent from '../content/achievements/certifications.json';
import SecurityIcon from '../components/SecurityIcon.astro';

type Certification = {
  name: string;
  provider: string;
  date?: string;
  status?: 'verified' | 'in-progress' | 'planned';
  credentialId?: string;
};

type CtfCompetition = {
  event: string;
  organizer: string;
  date: string;
  placement: string;
  category?: string;
  team?: string;
};

type AchievementContent = {
  overview: {
    identity: string;
    summary: string;
    focusAreas: string[];
  };
  certifications: {
    networkingSecurity: Certification[];
    cybersecurity: Certification[];
  };
  ctfCompetitions: CtfCompetition[];
  currentlyPursuing: Certification[];
};

const data = achievementContent as AchievementContent;

// Process certifications
const allCertifications = [
  ...data.certifications.networkingSecurity.map(cert => ({ ...cert, category: 'Networking & Infrastructure' })),
  ...data.certifications.cybersecurity.map(cert => ({ ...cert, category: 'Cybersecurity' })),
  ...data.currentlyPursuing.map(cert => ({ ...cert, category: 'In Progress', status: 'in-progress' }))
];

// Calculate stats
const stats = [
  {
    label: 'Total Certifications',
    value: data.certifications.networkingSecurity.length + data.certifications.cybersecurity.length,
    description: 'Verified credentials'
  },
  {
    label: 'CTF Engagements',
    value: data.ctfCompetitions.length,
    description: 'Competitive events'
  },
  {
    label: 'Active Learning',
    value: data.currentlyPursuing.length,
    description: 'Ongoing tracks'
  },
  {
    label: 'Platforms',
    value: 4, // HTB, THM, etc.
    description: 'Learning environments'
  }
];

// Status colors
const statusColors = {
  verified: '#7DD3FC',
  'in-progress': '#60A5FA',
  planned: '#38BDF8'
};

const statusLabels = {
  verified: 'Verified',
  'in-progress': 'In Progress',
  planned: 'Planned'
};
---

<BaseLayout title="Achievements">
  <main class="achievements-page">

    <!-- ===== HERO SECTION ===== -->
    <section class="achievements-hero section">
      <div class="container">
        <div class="hero-content">
          <div class="hero-eyebrow">
            <span class="eyebrow-tag">// LOG</span>
          </div>

          <h1 class="hero-title">Achievements & Credentials</h1>

          <p class="hero-description">
            Verified cybersecurity certifications, competitive CTF performance,
            and ongoing professional development tracks.
          </p>

          <div class="hero-stats">
            {stats.map((stat) => (
              <div class="stat-card">
                <div class="stat-value">{stat.value}</div>
                <div class="stat-label">{stat.label}</div>
                <div class="stat-description">{stat.description}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ===== PROFILE OVERVIEW ===== -->
    <section class="profile-section section">
      <div class="container">
        <div class="profile-grid">
          <!-- Mission Profile -->
          <div class="profile-card">
            <div class="profile-header">
              <h2 class="profile-title">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                Mission Profile
              </h2>
            </div>

            <div class="profile-content">
              <p class="profile-summary">{data.overview.summary}</p>

              <div class="profile-focus">
                <h3 class="focus-title">Focus Areas</h3>
                <div class="focus-tags">
                  {data.overview.focusAreas.map((area) => (
                    <span class="focus-tag">{area}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Learning Status -->
          <div class="status-card">
            <div class="status-header">
              <h2 class="status-title">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="18 10 15 10 12.5 17 8 3 5.5 10 2 10"/>
                </svg>
                Learning Status
              </h2>
            </div>

            <div class="status-content">
              <div class="status-item">
                <div class="status-indicator status-verified"></div>
                <div class="status-info">
                  <span class="status-label">Verified</span>
                  <span class="status-count">
                    {data.certifications.networkingSecurity.length + data.certifications.cybersecurity.length} credentials
                  </span>
                </div>
              </div>

              <div class="status-item">
                <div class="status-indicator status-in-progress"></div>
                <div class="status-info">
                  <span class="status-label">In Progress</span>
                  <span class="status-count">{data.currentlyPursuing.length} tracks</span>
                </div>
              </div>

              <div class="status-item">
                <div class="status-indicator status-active"></div>
                <div class="status-info">
                  <span class="status-label">Active Learning</span>
                  <span class="status-count">Continuous</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="achievement-snapshot section">
      <div class="container snapshot-grid">
        <article class="snapshot-card">
          <SecurityIcon name="award" size={24} />
          <h2>Credential record</h2>
          <p>Certifications are grouped by domain and status so recruiters can scan verified and in-progress learning quickly.</p>
        </article>
        <article class="snapshot-card">
          <SecurityIcon name="target" size={24} />
          <h2>Competitive practice</h2>
          <p>CTF participation is presented as event history without changing placement, team, organizer, or date facts.</p>
        </article>
        <article class="snapshot-card">
          <SecurityIcon name="radar" size={24} />
          <h2>Learning roadmap</h2>
          <p>Current tracks remain clearly separated from verified credentials to avoid overstating progress.</p>
        </article>
      </div>
    </section>

    <!-- ===== CERTIFICATIONS ===== -->
    <section class="certifications-section section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Technical Certifications</h2>
          <p class="section-subtitle">
            Verified credentials across networking, infrastructure, and cybersecurity domains.
          </p>
        </div>

        <div class="certifications-grid">
          {allCertifications.map((cert) => {
            const status = (cert.status || 'verified') as keyof typeof statusColors;
            const statusLabel = statusLabels[status] || 'Verified';

            return (
              <div class="certification-card" data-status={status}>
                <div class="certification-header">
                  <div class="certification-provider">{cert.provider}</div>
                  <div class="certification-status">
                    {statusLabel}
                  </div>
                </div>

                <h3 class="certification-name">{cert.name}</h3>

                <div class="certification-meta">
                  {cert.date && (
                    <div class="meta-item">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="8" height="8" rx="1" ry="1"/>
                        <path d="M7 2v2"/>
                        <path d="M3 6h8"/>
                      </svg>
                      {cert.date}
                    </div>
                  )}

                  <div class="meta-item">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12h10"/>
                      <path d="M7 2v10"/>
                      <path d="M4 9l3 3 3-3"/>
                    </svg>
                    {cert.category}
                  </div>
                </div>

                {cert.credentialId && (
                  <div class="certification-id">
                    <span class="id-label">ID:</span>
                    <span class="id-value">{cert.credentialId}</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ===== CTF COMPETITIONS ===== -->
    <section class="ctf-section section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">CTF Competitions</h2>
          <p class="section-subtitle">
            Competitive cybersecurity challenge participation and performance.
          </p>
        </div>

        {data.ctfCompetitions.length > 0 ? (
          <div class="ctf-grid">
            {data.ctfCompetitions.map((competition) => {
              // Parse placement for styling
              const placement = competition.placement.toLowerCase();
              const isTopPlacement = placement.includes('1st') || placement.includes('2nd') || placement.includes('3rd');

              return (
                <div class="ctf-card">
                  <div class="ctf-header">
                    <h3 class="ctf-event">{competition.event}</h3>
                    <div class={`ctf-placement ${isTopPlacement ? 'ctf-placement-top' : ''}`}>
                      {competition.placement}
                    </div>
                  </div>

                  <div class="ctf-meta">
                    <div class="meta-item">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="8" height="8" rx="1" ry="1"/>
                        <path d="M7 2v2"/>
                        <path d="M3 6h8"/>
                      </svg>
                      {competition.date}
                    </div>

                    <div class="meta-item">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2H2v12h10V2z"/>
                        <path d="M7 7l2 2-2 2"/>
                        <path d="M9 9H5"/>
                      </svg>
                      {competition.organizer}
                    </div>

                    {competition.category && (
                      <div class="meta-item">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 2h8l2 4v8H2V6l2-4"/>
                          <path d="M4 2v4"/>
                          <path d="M12 2v4"/>
                          <path d="M2 6h12"/>
                        </svg>
                        {competition.category}
                      </div>
                    )}

                    {competition.team && (
                      <div class="meta-item">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                          <circle cx="9" cy="7" r="4"/>
                        </svg>
                        {competition.team}
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-state">
            <div class="empty-state-icon"><SecurityIcon name="award" size={34} /></div>
            <h3 class="empty-state-title">No CTF Competitions</h3>
            <p class="empty-state-description">
              CTF competition history will be documented here as events are completed.
            </p>
          </div>
        )}
      </div>
    </section>

    <!-- ===== LEARNING ROADMAP ===== -->
    <section class="roadmap-section section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Learning Roadmap</h2>
          <p class="section-subtitle">
            Planned and ongoing cybersecurity certification tracks.
          </p>
        </div>

        {data.currentlyPursuing.length > 0 ? (
          <div class="roadmap">
            {data.currentlyPursuing.map((track) => (
              <div class="roadmap-item">
                <div class="roadmap-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 10.4V11a8 8 0 1 1-4.7-7.3"/>
                    <polyline points="18 4 10 12 7 9"/>
                  </svg>
                </div>

                <div class="roadmap-content">
                  <h3 class="roadmap-title">{track.name}</h3>
                  <div class="roadmap-meta">
                    <span class="meta-provider">{track.provider}</span>
                    {track.date && <span class="meta-date">Target: {track.date}</span>}
                  </div>

                  <div class="roadmap-progress">
                    <div class="progress-bar">
                      <div class="progress-fill" style="width: 50%"></div>
                    </div>
                    <span class="progress-label">In Progress</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <div class="empty-state-icon"><SecurityIcon name="archive" size={34} /></div>
            <h3 class="empty-state-title">No Active Learning Tracks</h3>
            <p class="empty-state-description">
              Future certification plans will be documented here as they are established.
            </p>
          </div>
        )}
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ===== ACHIEVEMENTS PAGE ===== */
  .achievements-page {
    padding-top: 80px;
  }

  .snapshot-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .snapshot-card {
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .snapshot-card svg {
    color: var(--text-secondary);
  }

  .snapshot-card h2 {
    margin: 1rem 0 0.6rem;
    font-size: 1.15rem;
  }

  .snapshot-card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  /* Achievements Hero */
  .achievements-hero {
    background: var(--bg-main);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .eyebrow-tag {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-secondary);
    background: var(--accent-subtle);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-medium);
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.1;
    margin: 0;
  }

  .hero-description {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 800px;
    margin: 0;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .stat-card {
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: all var(--motion-medium) var(--motion-ease);
  }

  .stat-card:hover {
    border-color: var(--border-medium);
    transform: translateY(-2px);
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--accent);
    line-height: 1;
    font-family: var(--font-mono);
  }

  .stat-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  .stat-description {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  /* Profile Section */
  .profile-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
  }

  .profile-card,
  .status-card {
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .profile-header,
  .status-header {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .profile-title,
  .status-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .profile-title svg,
  .status-title svg {
    width: 20px;
    height: 20px;
    color: var(--text-secondary);
  }

  .profile-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .profile-summary {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  .profile-focus {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .focus-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  .focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .focus-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: var(--bg-main);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    overflow-wrap: anywhere;
  }

  .status-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .status-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg-main);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .status-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--muted-text);
  }

  .status-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .status-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .status-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Certifications Grid */
  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }

  .certification-card {
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all var(--motion-medium) var(--motion-ease);
    min-width: 0;
  }

  .certification-card:hover {
    border-color: var(--border-medium);
    transform: translateY(-4px);
  }

  .certification-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .certification-provider {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .certification-status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--panel-elevated);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .certification-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .certification-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem 1rem;
    margin-top: 0.5rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .meta-item svg {
    width: 12px;
    height: 12px;
  }

  .certification-id {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .id-label {
    opacity: 0.7;
  }

  .id-value {
    color: var(--text-primary);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* CTF Grid */
  .ctf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }

  .ctf-card {
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all var(--motion-medium) var(--motion-ease);
    min-width: 0;
  }

  .ctf-card:hover {
    border-color: var(--border-medium);
    transform: translateY(-4px);
  }

  .ctf-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .ctf-event {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .ctf-placement {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    background: var(--bg-main);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ctf-placement-top {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  .ctf-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem 1rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
  }

  /* Roadmap */
  .roadmap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .roadmap-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: all var(--motion-medium) var(--motion-ease);
  }

  .roadmap-item:hover {
    border-color: var(--border-medium);
    transform: translateX(4px);
