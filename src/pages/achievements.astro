---
import BaseLayout from '../layouts/BaseLayout.astro';
import achievementContent from '../content/achievements/certifications.json';
import SecurityIcon from '../components/SecurityIcon.astro';

type Certification = {
  name: string;
  provider: string;
  date?: string;
  status?: 'verified' | 'in-progress' | 'planned';
  credentialId?: string;
};

type CtfCompetition = {
  event: string;
  organizer: string;
  date: string;
  placement: string;
  category?: string;
  team?: string;
};

type AchievementContent = {
  overview: {
    identity: string;
    summary: string;
    focusAreas: string[];
  };
  certifications: {
    networkingSecurity: Certification[];
    cybersecurity: Certification[];
  };
  ctfCompetitions: CtfCompetition[];
  currentlyPursuing: Certification[];
};

const data = achievementContent as AchievementContent;

const allCertifications = [
  ...data.certifications.networkingSecurity.map((cert) => ({ ...cert, category: 'Networking & Infrastructure' })),
  ...data.certifications.cybersecurity.map((cert) => ({ ...cert, category: 'Cybersecurity' })),
  ...data.currentlyPursuing.map((cert) => ({ ...cert, category: 'In Progress', status: 'in-progress' as const }))
];

const stats = [
  {
    label: 'Certifications',
    value: data.certifications.networkingSecurity.length + data.certifications.cybersecurity.length,
    description: 'verified credentials'
  },
  {
    label: 'CTF events',
    value: data.ctfCompetitions.length,
    description: 'competitive records'
  },
  {
    label: 'Active tracks',
    value: data.currentlyPursuing.length,
    description: 'ongoing learning'
  }
];

const statusLabels = {
  verified: 'Verified',
  'in-progress': 'In progress',
  planned: 'Planned'
};
---

<BaseLayout title="Achievements">
  <div class="achievements-page">
    <section class="achievements-hero section">
      <div class="container hero-grid">
        <div>
          <p class="hero-eyebrow">technical credentials</p>
          <h1>Achievements</h1>
          <p>
            Certification records, CTF participation, and current learning tracks.
            Verified work stays separate from plans and in-progress study.
          </p>
        </div>

        <dl class="achievement-stats" aria-label="Achievement summary">
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd><strong>{stat.value}</strong><span>{stat.description}</span></dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section profile-section">
      <div class="container profile-grid">
        <article class="profile-card">
          <h2>Profile</h2>
          <p>{data.overview.summary}</p>
          <div class="focus-tags" aria-label="Focus areas">
            {data.overview.focusAreas.map((area) => <span class="focus-tag">{area}</span>)}
          </div>
        </article>

        <aside class="status-card" aria-label="Learning status">
          <h2>Status</h2>
          <dl>
            <div><dt>Verified</dt><dd>{data.certifications.networkingSecurity.length + data.certifications.cybersecurity.length} credentials</dd></div>
            <div><dt>In progress</dt><dd>{data.currentlyPursuing.length} tracks</dd></div>
            <div><dt>Practice</dt><dd>Continuous</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="section snapshot-section">
      <div class="container snapshot-grid">
        <article class="snapshot-card">
          <SecurityIcon name="award" size={22} />
          <h2>Credential record</h2>
          <p>Certifications are grouped by domain and status for quick scanning.</p>
        </article>
        <article class="snapshot-card">
          <SecurityIcon name="target" size={22} />
          <h2>Competitive practice</h2>
          <p>CTF records keep placement, organizer, team, and date facts intact.</p>
        </article>
        <article class="snapshot-card">
          <SecurityIcon name="radar" size={22} />
          <h2>Learning roadmap</h2>
          <p>Current tracks are separated from verified credentials.</p>
        </article>
      </div>
    </section>

    <section class="section certifications-section">
      <div class="container">
        <div class="section-header">
          <p class="section-kicker">credentials</p>
          <h2 class="section-title">Technical certifications</h2>
          <p class="section-subtitle">
            Networking, infrastructure, and cybersecurity credentials with status and credential metadata.
          </p>
        </div>

        <div class="certifications-grid">
          {allCertifications.map((cert) => {
            const status = (cert.status || 'verified') as keyof typeof statusLabels;
            return (
              <article class="certification-card" data-status={status}>
                <header>
                  <p>{cert.provider}</p>
                  <span>{statusLabels[status]}</span>
                </header>

                <h3>{cert.name}</h3>

                <dl class="certification-meta">
                  {cert.date && <div><dt>Date</dt><dd>{cert.date}</dd></div>}
                  <div><dt>Domain</dt><dd>{cert.category}</dd></div>
                  {cert.credentialId && <div><dt>ID</dt><dd>{cert.credentialId}</dd></div>}
                </dl>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section ctf-section">
      <div class="container">
        <div class="section-header">
          <p class="section-kicker">competition record</p>
          <h2 class="section-title">CTF competitions</h2>
          <p class="section-subtitle">Event participation and placement history.</p>
        </div>

        {data.ctfCompetitions.length > 0 ? (
          <div class="ctf-grid">
            {data.ctfCompetitions.map((competition) => (
              <article class="ctf-card">
                <header>
                  <h3>{competition.event}</h3>
                  <span>{competition.placement}</span>
                </header>

                <dl class="ctf-meta">
                  <div><dt>Date</dt><dd>{competition.date}</dd></div>
                  <div><dt>Organizer</dt><dd>{competition.organizer}</dd></div>
                  {competition.category && <div><dt>Category</dt><dd>{competition.category}</dd></div>}
                  {competition.team && <div><dt>Team</dt><dd>{competition.team}</dd></div>}
                </dl>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No CTF competitions</h2>
            <p>Competition history will be documented here as events are completed.</p>
          </div>
        )}
      </div>
    </section>

    <section class="section roadmap-section">
      <div class="container">
        <div class="section-header">
          <p class="section-kicker">roadmap</p>
          <h2 class="section-title">Learning tracks</h2>
          <p class="section-subtitle">Planned and ongoing certification work.</p>
        </div>

        {data.currentlyPursuing.length > 0 ? (
          <div class="roadmap">
            {data.currentlyPursuing.map((track) => (
              <article class="roadmap-item">
                <SecurityIcon name="file" size={18} />
                <div>
                  <h3>{track.name}</h3>
                  <p>{track.provider}{track.date ? ` / Target: ${track.date}` : ''}</p>
                </div>
                <span>In progress</span>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No active learning tracks</h2>
            <p>Future certification plans will be documented here as they are established.</p>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .achievements-hero {
    border-bottom: 1px solid var(--border);
  }

  .hero-grid,
  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.38fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }

  .hero-eyebrow,
  .section-kicker {
    margin: 0 0 0.9rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .achievements-hero h1 {
    margin-bottom: 1rem;
  }

  .achievements-hero p:not(.hero-eyebrow) {
    max-width: 70ch;
    font-size: 1.08rem;
  }

  .achievement-stats {
    display: grid;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .achievement-stats div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 0.82rem 0;
    border-bottom: 1px solid var(--border);
  }

  .achievement-stats div:last-child {
    border-bottom: 0;
  }

  .achievement-stats dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
  }

  .achievement-stats dd {
    display: grid;
    margin: 0;
    text-align: right;
  }

  .achievement-stats strong {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 1.35rem;
    line-height: 1;
  }

  .achievement-stats span {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .profile-card,
  .status-card,
  .snapshot-card,
  .certification-card,
  .ctf-card,
  .roadmap-item {
    padding: 1.15rem;
  }

  .profile-card h2,
  .status-card h2,
  .snapshot-card h2 {
    margin-bottom: 0.6rem;
    font-size: 1.35rem;
  }

  .profile-card p {
    margin-bottom: 1rem;
  }

  .focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .status-card dl,
  .certification-meta,
  .ctf-meta {
    display: grid;
    gap: 0.6rem;
    padding: 0;
  }

  .status-card dl div,
  .certification-meta div,
  .ctf-meta div {
    display: grid;
    grid-template-columns: minmax(6rem, 0.35fr) 1fr;
    gap: 0.75rem;
  }

  dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--text-soft);
  }

  .snapshot-grid,
  .certifications-grid,
  .ctf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1rem;
  }

  .snapshot-card svg {
    color: var(--steel);
  }

  .snapshot-card p {
    margin: 0;
  }

  .certification-card,
  .ctf-card {
    display: grid;
    gap: 1rem;
  }

  .certification-card header,
  .ctf-card header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
  }

  .certification-card header p {
    margin: 0;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .certification-card header span,
  .ctf-card header span,
  .roadmap-item > span {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.18rem 0.45rem;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .certification-card h3,
  .ctf-card h3,
  .roadmap-item h3 {
    font-size: 1.2rem;
  }

  .roadmap {
    display: grid;
    gap: 0.8rem;
  }

  .roadmap-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: start;
  }

  .roadmap-item svg {
    color: var(--steel);
    margin-top: 0.18rem;
  }

  .roadmap-item p {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  @media (max-width: 820px) {
    .hero-grid,
    .profile-grid {
      grid-template-columns: 1fr;
    }

    .achievement-stats dd {
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .certification-card header,
    .ctf-card header,
    .roadmap-item {
      grid-template-columns: 1fr;
    }

    .certification-card header,
    .ctf-card header {
      display: grid;
    }
  }
</style>
