---
import BaseLayout from '../layouts/BaseLayout.astro';
import achievementContent from '../content/achievements/certifications.json';
import SecurityIcon from '../components/SecurityIcon.astro';
import { parseAchievementDate, formatAchievementYear } from '../utils/achievements';

type Certification = {
  name: string;
  provider: string;
  date?: string;
  status?: 'verified' | 'in-progress' | 'planned';
  credentialId?: string;
};

type CtfCompetition = {
  event: string;
  organizer: string;
  date: string;
  placement: string;
  category?: string;
  team?: string;
};

type AchievementContent = {
  overview: {
    identity: string;
    summary: string;
    focusAreas: string[];
  };
  certifications: {
    networkingSecurity: Certification[];
    cybersecurity: Certification[];
  };
  ctfCompetitions: CtfCompetition[];
  currentlyPursuing: Certification[];
};

const data = achievementContent as AchievementContent;

const allCertifications = [
  ...data.certifications.networkingSecurity.map((cert) => ({ ...cert, category: 'Networking & Infrastructure' })),
  ...data.certifications.cybersecurity.map((cert) => ({ ...cert, category: 'Cybersecurity' })),
  ...data.currentlyPursuing.map((cert) => ({ ...cert, category: 'In Progress', status: 'in-progress' as const }))
];

const certTimeline = allCertifications
  .map((cert) => ({ ...cert, sortDate: parseAchievementDate(cert.date ?? '') }))
  .sort((a, b) => b.sortDate.valueOf() - a.sortDate.valueOf());

const hasMonth = (value: string) => /([A-Za-z]{3,})\s+(\d{4})/.test(value);

const ctfTimeline = data.ctfCompetitions
  .map((ctf) => ({ ...ctf, sortDate: parseAchievementDate(ctf.date) }))
  .sort((a, b) => b.sortDate.valueOf() - a.sortDate.valueOf());

type CtfGroup = { key: string; label: string; items: typeof ctfTimeline };

const ctfGroups: CtfGroup[] = [];
for (const ctf of ctfTimeline) {
  const label = hasMonth(ctf.date)
    ? ctf.sortDate.toLocaleDateString('en', { month: 'long', year: 'numeric' })
    : formatAchievementYear(ctf.sortDate);
  const key = `${ctf.sortDate.getFullYear()}-${label}`;
  let group = ctfGroups.find((g) => g.key === key);
  if (!group) {
    group = { key, label, items: [] };
    ctfGroups.push(group);
  }
  group.items.push(ctf);
}

const stats = [
  {
    label: 'Certifications',
    value: data.certifications.networkingSecurity.length + data.certifications.cybersecurity.length,
    description: 'verified credentials'
  },
  {
    label: 'CTF events',
    value: data.ctfCompetitions.length,
    description: 'competitive records'
  },
  {
    label: 'Active tracks',
    value: data.currentlyPursuing.length,
    description: 'ongoing learning'
  }
];

const statusLabels = {
  verified: 'Verified',
  'in-progress': 'In progress',
  planned: 'Planned'
};
---

<BaseLayout title="Achievements">
  <div class="achievements-page">
    <section class="achievements-hero section">
      <div class="container hero-grid">
        <div>
          <p class="hero-eyebrow">// technical credentials</p>
          <h1>Achievements</h1>
          <p>
            Certification records, CTF participation, and current learning tracks.
            Verified work stays separate from plans and in-progress study.
          </p>
        </div>

        <dl class="achievement-stats" aria-label="Achievement summary">
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd><strong>{stat.value}</strong><span>{stat.description}</span></dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section profile-section">
      <div class="container profile-grid">
        <article class="profile-card">
          <h2>Profile</h2>
          <p>{data.overview.summary}</p>
          <div class="focus-tags" aria-label="Focus areas">
            {data.overview.focusAreas.map((area) => <span class="focus-tag">{area}</span>)}
          </div>
        </article>

        <aside class="status-card" aria-label="Learning status">
          <h2>Status</h2>
          <dl>
            <div><dt>Verified</dt><dd>{data.certifications.networkingSecurity.length + data.certifications.cybersecurity.length} credentials</dd></div>
            <div><dt>In progress</dt><dd>{data.currentlyPursuing.length} tracks</dd></div>
            <div><dt>Practice</dt><dd>Continuous</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="section snapshot-section">
      <div class="container snapshot-grid">
        <article class="snapshot-card reveal">
          <SecurityIcon name="award" size={22} />
          <h2>Credential record</h2>
          <p>Certifications are grouped by domain and status for quick scanning.</p>
        </article>
        <article class="snapshot-card reveal" data-reveal-delay="60">
          <SecurityIcon name="target" size={22} />
          <h2>Competitive practice</h2>
          <p>CTF records keep placement, organizer, team, and date facts intact.</p>
        </article>
        <article class="snapshot-card reveal" data-reveal-delay="120">
          <SecurityIcon name="radar" size={22} />
          <h2>Learning roadmap</h2>
          <p>Current tracks are separated from verified credentials.</p>
        </article>
      </div>
    </section>

    <section class="section certifications-section">
      <div class="container">
        <div class="field-head">
          <span class="field-num">(01)</span>
          <span class="field-rule" aria-hidden="true"></span>
          <span class="field-label">Certifications</span>
        </div>

        <div class="ach-timeline">
          {certTimeline.map((cert, index) => {
            const status = (cert.status || 'verified') as keyof typeof statusLabels;
            return (
              <article class="ach-item reveal" data-reveal-delay={Math.min(index * 20, 240)} data-status={status}>
                <p class="ach-year">{cert.date ? `${cert.date} • ${statusLabels[status]}` : statusLabels[status]}</p>
                <h3 class="ach-title">{cert.name}</h3>
                <p class="ach-meta">{cert.provider} — {cert.category}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section ctf-section">
      <div class="container">
        <div class="field-head">
          <span class="field-num">(02)</span>
          <span class="field-rule" aria-hidden="true"></span>
          <span class="field-label">CTF Record</span>
        </div>

        {ctfGroups.length > 0 ? (
          <div class="ach-groups">
            {ctfGroups.map((group) => (
              <div class="ach-group">
                <h3 class="ach-group-heading">{group.label}</h3>
                <div class="ach-timeline">
                  {group.items.map((competition, index) => (
                    <article class="ach-item reveal" data-reveal-delay={Math.min(index * 20, 240)}>
                      <p class="ach-year">{competition.placement}</p>
                      <h3 class="ach-title">{competition.event}</h3>
                      <p class="ach-meta">
                        {competition.organizer}
                        {competition.category ? ` — ${competition.category}` : ''}
                        {competition.team ? ` — ${competition.team}` : ''}
                      </p>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No CTF competitions</h2>
            <p>Competition history will be documented here as events are completed.</p>
          </div>
        )}
      </div>
    </section>

    <section class="section roadmap-section">
      <div class="container">
        <div class="field-head">
          <span class="field-num">(03)</span>
          <span class="field-rule" aria-hidden="true"></span>
          <span class="field-label">Roadmap</span>
        </div>

        {data.currentlyPursuing.length > 0 ? (
          <div class="ach-timeline">
            {data.currentlyPursuing.map((track, index) => (
              <article class="ach-item reveal" data-reveal-delay={Math.min(index * 20, 240)} data-status="in-progress">
                <p class="ach-year">In progress</p>
                <h3 class="ach-title">{track.name}</h3>
                <p class="ach-meta">{track.provider}{track.date ? ` — Target: ${track.date}` : ''}</p>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No active learning tracks</h2>
            <p>Future certification plans will be documented here as they are established.</p>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .achievements-hero {
    border-bottom: 1px solid var(--border);
  }

  .hero-grid,
  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.38fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }

  .hero-eyebrow,
  .section-kicker {
    margin: 0 0 0.9rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .achievements-hero h1 {
    margin-bottom: 1rem;
  }

  .achievements-hero p:not(.hero-eyebrow) {
    max-width: 70ch;
    font-size: 1.08rem;
  }

  .achievement-stats {
    display: grid;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .achievement-stats div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 0.82rem 0;
    border-bottom: 1px solid var(--border);
  }

  .achievement-stats div:last-child {
    border-bottom: 0;
  }

  .achievement-stats dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
  }

  .achievement-stats dd {
    display: grid;
    margin: 0;
    text-align: right;
  }

  .achievement-stats strong {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 1.35rem;
    line-height: 1;
  }

  .achievement-stats span {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .profile-card,
  .status-card,
  .snapshot-card,
  .certification-card,
  .ctf-card,
  .roadmap-item {
    padding: 1.15rem;
  }

  .profile-card h2,
  .status-card h2,
  .snapshot-card h2 {
    margin-bottom: 0.6rem;
    font-size: 1.35rem;
  }

  .profile-card p {
    margin-bottom: 1rem;
  }

  .focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .status-card dl {
    display: grid;
    gap: 0.6rem;
    padding: 0;
  }

  .status-card dl div {
    display: grid;
    grid-template-columns: minmax(6rem, 0.35fr) 1fr;
    gap: 0.75rem;
  }

  dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--text-soft);
  }

  .snapshot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1rem;
  }

  .snapshot-card svg {
    color: var(--steel);
  }

  .snapshot-card p {
    margin: 0;
  }

  .ach-groups {
    display: grid;
    gap: 1.8rem;
  }

  .ach-group-heading {
    margin: 0 0 0.9rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .ach-item[data-status="in-progress"] .ach-year,
  .ach-item[data-status="planned"] .ach-year {
    color: var(--steel);
  }

  @media (max-width: 820px) {
    .hero-grid,
    .profile-grid {
      grid-template-columns: 1fr;
    }

    .achievement-stats dd {
      text-align: left;
    }
  }
</style>
