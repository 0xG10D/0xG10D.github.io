---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityIcon from '../components/SecurityIcon.astro';
import { categoryOrder, cheatSheetSections, cheatSheets } from '../data/cheatsheets';
import type { CheatSheetCategory } from '../data/cheatsheets';
import type { SecurityIconName } from '../data/security-icons';

const totalCommands = cheatSheets.length;
const allTags = [...new Set(cheatSheets.flatMap((entry) => entry.tags))].sort();
const categoryIcons: Record<CheatSheetCategory, SecurityIconName> = {
  Recon: 'radar',
  Nmap: 'target',
  'Web Enumeration': 'search',
  Fuzzing: 'tool',
  'Linux Privilege Escalation': 'terminal',
  'Windows Enumeration': 'platform',
  'Active Directory Basics': 'network',
  'Reverse Shells': 'terminal',
  'File Transfer': 'archive',
  'Password Attacks': 'shield',
  Forensics: 'search',
  'Malware Analysis Basics': 'flask',
  'SOC / Detection': 'shield',
  'Useful Links': 'external'
};
---

<BaseLayout
  title="cheatsheets"
  description="Practical commands and notes for authorized labs, CTFs, and defensive learning."
>
  <main class="cheatsheets-page">
    <section class="cheatsheets-hero section">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="meta-pill">
              <SecurityIcon name="terminal" size={16} />
              <span>// QUICK_REFERENCE</span>
            </div>
            <h1>cheatsheets</h1>
            <p>Practical commands and notes for authorized labs, CTFs, and defensive learning.</p>
          </div>

          <aside class="hero-panel" aria-label="Cheatsheet summary">
            <div>
              <strong>{categoryOrder.length}</strong>
              <span>categories</span>
            </div>
            <div>
              <strong>{totalCommands}</strong>
              <span>commands</span>
            </div>
            <div>
              <strong>{allTags.length}</strong>
              <span>tags</span>
            </div>
          </aside>
        </div>

        <div class="cheatsheet-controls" aria-label="Cheatsheet filters">
          <label class="search-group" for="cheatsheet-search">
            <span>search reference</span>
            <input
              id="cheatsheet-search"
              type="search"
              autocomplete="off"
              placeholder="grep -i command, tool, technique..."
              aria-describedby="cheatsheet-results"
            />
          </label>
        </div>
      </div>
    </section>

    <section class="reference-shell section" aria-label="Command reference">
      <div class="container reference-layout">
        <aside class="reference-sidebar" aria-label="Category navigation">
          <div class="sidebar-inner">
            <p class="sidebar-label">./categories</p>
            <nav class="category-nav">
              <button class="category-link active" type="button" data-category-filter="all">
                <span>./all</span>
                <strong>{totalCommands}</strong>
              </button>
              {cheatSheetSections.map((section) => (
                <button class="category-link" type="button" data-category-filter={section.category}>
                  <span>./{section.slug}</span>
                  <strong>{section.entries.length}</strong>
                </button>
              ))}
            </nav>
          </div>
        </aside>

        <div class="reference-main">
          <div class="results-line" id="cheatsheet-results" aria-live="polite">
            <span><strong id="cheatsheet-count">{totalCommands}</strong> commands visible</span>
            <button type="button" class="clear-button" data-clear-filters>clear filters</button>
          </div>

          <div class="reference-sections" id="cheatsheet-grid">
            {cheatSheetSections.map((section) => (
              <section
                class="command-section"
                id={section.slug}
                data-cheatsheet-section
                data-category={section.category}
                aria-labelledby={`${section.slug}-heading`}
              >
                <header class="section-heading">
                  <div class="section-title-line">
                    <div class="section-icon">
                      <SecurityIcon name={categoryIcons[section.category]} size={20} />
                    </div>
                    <div>
                      <p>{`./${section.slug}`}</p>
                      <h2 id={`${section.slug}-heading`}>{section.category}</h2>
                    </div>
                  </div>
                  <span>{section.entries.length} refs</span>
                </header>
                <p class="section-summary">{section.summary}</p>

                <div class="command-card-list">
                  {section.entries.map((entry) => {
                    const searchText = [
                      section.category,
                      section.slug,
                      entry.title,
                      entry.command,
                      entry.description,
                      entry.whenToUse,
                      entry.notes,
                      entry.exampleOutput || '',
                      entry.language,
                      ...entry.tags
                    ].join(' ').toLowerCase();

                    return (
                      <article
                        class="command-card"
                        data-cheatsheet-card
                        data-category={section.category}
                        data-search={searchText}
                      >
                        <header class="command-card-header">
                          <div>
                            <p class="command-card-category">{section.category}</p>
                            <h3>{entry.title}</h3>
                          </div>
                          <div class="tag-row" aria-label={`${entry.title} tags`}>
                            {entry.tags.map((tag) => (
                              <button type="button" data-tag-filter={tag}>#{tag}</button>
                            ))}
                          </div>
                        </header>

                        <div class="terminal-block">
                          <div class="terminal-head">
                            <span>command</span>
                            <span class="language-label">{entry.language}</span>
                            <button type="button" class="copy-button" data-copy-command aria-label={`Copy ${entry.title} command`}>
                              copy
                            </button>
                          </div>
                          <pre data-language={entry.language}><code>{entry.command}</code></pre>
                        </div>

                        <div class="reference-notes">
                          <div>
                            <span>explains</span>
                            <p>{entry.description}</p>
                          </div>
                          <div>
                            <span>use when</span>
                            <p>{entry.whenToUse}</p>
                          </div>
                          <div>
                            <span>note</span>
                            <p>{entry.notes}</p>
                          </div>
                          {entry.exampleOutput && (
                            <div>
                              <span>expected</span>
                              <p>{entry.exampleOutput}</p>
                            </div>
                          )}
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>

          <div class="empty-state" id="cheatsheet-empty" hidden>
            <SecurityIcon name="search" size={34} />
            <h2>No matching commands</h2>
            <p>Clear filters or search for a broader command, tool, technique, tag, or category.</p>
            <button type="button" class="button button-primary" data-clear-filters>clear filters</button>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .cheatsheets-page {
    padding-top: 80px;
  }

  .cheatsheets-hero {
    padding-top: calc(var(--section-spacing) * 1.05);
    padding-bottom: 2rem;
    background: var(--bg-main);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(250px, 360px);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: end;
  }

  .hero-copy h1 {
    margin: 1rem 0 0.8rem;
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 7vw, 5.25rem);
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .hero-copy p {
    max-width: 70ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.12rem);
  }

  .hero-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .hero-panel div {
    min-width: 0;
    padding: 1rem;
    background: var(--card-bg);
  }

  .hero-panel strong {
    display: block;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1;
  }

  .hero-panel span {
    display: block;
    margin-top: 0.5rem;
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .cheatsheet-controls {
    margin-top: 1.5rem;
    padding: 1rem;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .search-group {
    display: grid;
    gap: 0.5rem;
  }

  .search-group span,
  .sidebar-label,
  .command-card-category,
  .terminal-head,
  .reference-notes span,
  .section-heading p {
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .search-group input {
    width: 100%;
    min-height: 50px;
    padding: 0.78rem 0.9rem;
    color: var(--text-primary);
    background: var(--bg-main);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .search-group input:focus,
  .category-link:focus-visible,
  .clear-button:focus-visible,
  .copy-button:focus-visible,
  .tag-row button:focus-visible {
    outline: none;
    border-color: var(--border-strong);
    box-shadow: 0 0 0 2px var(--accent-subtle);
  }

  .reference-shell {
    padding-top: 1.25rem;
    background: var(--bg-main);
  }

  .reference-layout {
    display: grid;
    grid-template-columns: minmax(200px, 240px) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
  }

  .reference-sidebar {
    position: sticky;
    top: 96px;
  }

  .sidebar-inner {
    padding: 0.85rem;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .sidebar-label {
    margin: 0 0 0.65rem;
  }

  .category-nav {
    display: grid;
    gap: 0.35rem;
  }

  .category-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.65rem;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-align: left;
    transition: background var(--motion-fast) var(--motion-ease), border-color var(--motion-fast) var(--motion-ease), color var(--motion-fast) var(--motion-ease);
  }

  .category-link span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-link strong {
    color: var(--muted-text);
    font-size: 0.72rem;
  }

  .category-link:hover,
  .category-link.active {
    color: var(--text-primary);
    background: var(--accent-subtle);
    border-color: var(--border-medium);
  }

  .reference-main {
    min-width: 0;
  }

  .results-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
    padding: 0.75rem 0;
    color: var(--text-secondary);
  }

  .results-line strong {
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .clear-button,
  .copy-button,
  .tag-row button {
    color: var(--text-secondary);
    background: var(--bg-main);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: 800;
    transition: background var(--motion-fast) var(--motion-ease), border-color var(--motion-fast) var(--motion-ease), color var(--motion-fast) var(--motion-ease), transform var(--motion-fast) var(--motion-ease);
  }

  .clear-button {
    min-height: 44px;
    padding: 0.45rem 0.8rem;
    font-size: 0.78rem;
    text-transform: lowercase;
  }

  .reference-sections {
    display: grid;
    gap: 1rem;
  }

  .command-section {
    scroll-margin-top: 110px;
    padding: clamp(1rem, 2vw, 1.2rem);
    background: rgba(20, 20, 20, 0.72);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
  }

  .section-title-line {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    align-items: center;
    min-width: 0;
  }

  .section-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    color: var(--text-secondary);
    background: var(--bg-main);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
  }

  .section-heading h2 {
    margin: 0.05rem 0 0;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    letter-spacing: 0;
  }

  .section-heading > span {
    flex: 0 0 auto;
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .section-summary {
    max-width: 78ch;
    margin: 0.9rem 0 1rem;
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .command-card-list {
    display: grid;
    gap: 0.85rem;
  }

  .command-card {
    min-width: 0;
    padding: clamp(0.95rem, 2vw, 1.15rem);
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .command-card-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, auto);
    gap: 0.8rem;
    align-items: start;
    margin-bottom: 0.85rem;
  }

  .command-card h3 {
    margin: 0;
    font-size: clamp(1.02rem, 2vw, 1.2rem);
    letter-spacing: 0;
  }

  .command-card-category {
    margin: 0 0 0.2rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
    max-width: 320px;
  }

  .tag-row button {
    min-height: 34px;
    padding: 0.25rem 0.5rem;
    font-size: 0.68rem;
  }

  .clear-button:hover,
  .copy-button:hover,
  .tag-row button:hover,
  .tag-row button.active {
    color: var(--text-primary);
    background: var(--accent-subtle);
    border-color: var(--border-medium);
  }

  .clear-button:active,
  .copy-button:active,
  .tag-row button:active,
  .category-link:active {
    transform: translateY(1px);
  }

  .terminal-block {
    min-width: 0;
    overflow: hidden;
    background: var(--bg-main);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .terminal-head {
    display: grid;
    grid-template-columns: minmax(0, auto) 1fr auto;
    gap: 0.65rem;
    align-items: center;
    min-height: 42px;
    padding: 0.45rem 0.55rem 0.45rem 0.75rem;
    background: var(--panel-elevated);
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-head > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .language-label {
    color: var(--muted-text);
    text-transform: lowercase;
  }

  .copy-button {
    justify-self: end;
    min-height: 32px;
    padding: 0.2rem 0.55rem;
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .copy-button.copied {
    color: var(--text-primary);
    background: var(--accent-subtle);
    border-color: var(--border-medium);
  }

  .terminal-block pre {
    max-width: 100%;
    margin: 0;
    padding: 0.9rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .terminal-block code {
    display: block;
    min-width: max-content;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.6;
    white-space: pre;
  }

  .reference-notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-top: 0.85rem;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .reference-notes div {
    min-width: 0;
    padding: 0.85rem;
    background: var(--panel-elevated);
  }

  .reference-notes p {
    margin: 0.35rem 0 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .empty-state {
    padding: 3rem 1.25rem;
    text-align: center;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .empty-state svg {
    margin: 0 auto 1rem;
    color: var(--text-secondary);
  }

  .empty-state h2 {
    font-size: 1.5rem;
  }

  .empty-state p {
    max-width: 48ch;
    margin-inline: auto;
  }

  @media (max-width: 1040px) {
    .reference-layout {
      grid-template-columns: 1fr;
    }

    .reference-sidebar {
      position: sticky;
      top: 76px;
      z-index: 3;
      margin-inline: calc(var(--container-padding) * -1);
      padding-inline: var(--container-padding);
      background: var(--bg-main);
      border-bottom: 1px solid var(--border-subtle);
    }

    .sidebar-inner {
      padding: 0.7rem 0;
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    .sidebar-label {
      display: none;
    }

    .category-nav {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding-bottom: 0.7rem;
      scrollbar-width: thin;
      scroll-snap-type: x proximity;
    }

    .category-link {
      flex: 0 0 auto;
      width: auto;
      min-width: 130px;
      scroll-snap-align: start;
    }
  }

  @media (max-width: 820px) {
    .hero-grid,
    .command-card-header,
    .reference-notes {
      grid-template-columns: 1fr;
    }

    .tag-row {
      justify-content: flex-start;
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .cheatsheets-page {
      padding-top: 68px;
    }

    .cheatsheets-hero {
      padding-top: 2.35rem;
      padding-bottom: 1.4rem;
    }

    .hero-copy h1 {
      font-size: clamp(2.25rem, 13vw, 3.1rem);
    }

    .hero-panel {
      grid-template-columns: 1fr;
    }

    .cheatsheet-controls,
    .command-section,
    .command-card {
      padding: 0.9rem;
    }

    .results-line {
      align-items: stretch;
      flex-direction: column;
    }

    .clear-button {
      width: 100%;
    }

    .section-heading {
      flex-direction: column;
      gap: 0.65rem;
    }

    .terminal-head {
      grid-template-columns: 1fr auto;
    }

    .terminal-block pre {
      padding: 0.8rem;
    }

    .terminal-block code {
      font-size: 0.78rem;
      line-height: 1.55;
    }

    .terminal-head > span:first-child {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = Array.from(document.querySelectorAll('[data-cheatsheet-card]'))
      .filter((card): card is HTMLElement => card instanceof HTMLElement);
    const sections = Array.from(document.querySelectorAll('[data-cheatsheet-section]'))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);
    const searchInput = document.getElementById('cheatsheet-search');
    const countElement = document.getElementById('cheatsheet-count');
    const emptyState = document.getElementById('cheatsheet-empty');
    const grid = document.getElementById('cheatsheet-grid');
    const categoryButtons = Array.from(document.querySelectorAll('[data-category-filter]'))
      .filter((button): button is HTMLButtonElement => button instanceof HTMLButtonElement);
    const tagButtons = Array.from(document.querySelectorAll('[data-tag-filter]'))
      .filter((button): button is HTMLButtonElement => button instanceof HTMLButtonElement);
    let activeCategory = 'all';
    let activeTag = '';

    function getSearchTerm() {
      return searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
    }

    function setActiveCategory(category: string) {
      activeCategory = category;
      categoryButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.categoryFilter === category);
      });
    }

    function setActiveTag(tag: string) {
      activeTag = tag;
      tagButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.tagFilter === tag);
      });
    }

    function filterCards() {
      const searchTerm = getSearchTerm();
      let visible = 0;

      cards.forEach((card) => {
        const category = card.dataset.category || '';
        const search = card.dataset.search || '';
        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesTag = !activeTag || search.includes(activeTag.toLowerCase());
        const matchesSearch = !searchTerm || search.includes(searchTerm);
        const shouldShow = matchesCategory && matchesTag && matchesSearch;

        card.hidden = !shouldShow;
        if (shouldShow) visible += 1;
      });

      sections.forEach((section) => {
        const sectionCards = Array.from(section.querySelectorAll('[data-cheatsheet-card]'))
          .filter((card): card is HTMLElement => card instanceof HTMLElement);
        section.hidden = sectionCards.every((card) => card.hidden);
      });

      if (countElement) countElement.textContent = String(visible);
      if (grid && emptyState) {
        grid.hidden = visible === 0;
        emptyState.hidden = visible !== 0;
      }
    }

    searchInput?.addEventListener('input', filterCards);

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.categoryFilter || 'all';
        setActiveCategory(category);
        filterCards();

        if (category === 'all') {
          document.querySelector('.reference-shell')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }

        const section = sections.find((item) => item.dataset.category === category);
        section?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const tag = button.dataset.tagFilter || '';
        setActiveTag(activeTag === tag ? '' : tag);
        filterCards();
      });
    });

    document.querySelectorAll('[data-clear-filters]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener('click', () => {
        if (searchInput instanceof HTMLInputElement) searchInput.value = '';
        setActiveCategory('all');
        setActiveTag('');
        filterCards();
      });
    });

    document.querySelectorAll('[data-copy-command]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      button.addEventListener('click', async () => {
        const block = button.closest('.terminal-block');
        const code = block?.querySelector('code')?.textContent;
        if (!code || !navigator.clipboard) return;

        await navigator.clipboard.writeText(code);
        const previous = button.textContent || 'copy';
        button.textContent = 'copied';
        button.classList.add('copied');
        window.setTimeout(() => {
          button.textContent = previous;
          button.classList.remove('copied');
        }, 1400);
      });
    });

    filterCards();
  });
</script>
