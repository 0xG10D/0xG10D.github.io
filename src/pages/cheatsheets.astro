---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityIcon from '../components/SecurityIcon.astro';
import { categoryOrder, cheatSheets, cveResearchLinks } from '../data/cheatsheets';

const totalCommands = cheatSheets.reduce((total, sheet) => total + sheet.commands.length, 0);
const allTags = [...new Set(cheatSheets.flatMap((sheet) => sheet.tags))].sort();
const categoryCounts = categoryOrder.map((category) => ({
  category,
  count: cheatSheets.filter((sheet) => sheet.category === category).length
}));
---

<BaseLayout
  title="Cybersecurity Cheat Sheets"
  description="Searchable cybersecurity quick-reference hub for CTF, labs, Hack The Box, TryHackMe, and authorized security testing."
>
  <main class="cheatsheets-page">
    <section class="cheatsheets-hero section">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="meta-pill">
              <SecurityIcon name="shield" size={16} />
              <span>Authorized use only</span>
            </div>
            <h1>Cybersecurity Cheat Sheets</h1>
            <p>
              A searchable quick-reference hub for CTFs, labs, Hack The Box, TryHackMe, and approved security testing.
              Built for fast lookup during real workflow pressure.
            </p>
          </div>

          <div class="hero-panel" aria-label="Cheat sheet summary">
            <div>
              <strong>{cheatSheets.length}</strong>
              <span>Reference cards</span>
            </div>
            <div>
              <strong>{categoryOrder.length}</strong>
              <span>Categories</span>
            </div>
            <div>
              <strong>{totalCommands}</strong>
              <span>Command snippets</span>
            </div>
            <div>
              <strong>{allTags.length}</strong>
              <span>Search tags</span>
            </div>
          </div>
        </div>

        <div class="cheatsheet-controls" aria-label="Cheat sheet filters">
          <label class="search-group">
            <span>Search references</span>
            <input
              id="cheatsheet-search"
              type="search"
              autocomplete="off"
              placeholder="Search commands, tags, category, or description"
              aria-label="Search cheat sheets"
            />
          </label>

          <div class="filter-group" aria-label="Category filters">
            <button class="filter-chip active" type="button" data-category-filter="all">All</button>
            {categoryOrder.map((category) => (
              <button class="filter-chip" type="button" data-category-filter={category}>
                {category}
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="category-band" aria-label="Category overview">
      <div class="container">
        <div class="category-grid">
          {categoryCounts.map(({ category, count }) => (
            <button class="category-tile" type="button" data-category-filter={category}>
              <span>{category}</span>
              <strong>{count}</strong>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="section sheets-section">
      <div class="container">
        <div class="results-line" aria-live="polite">
          <span><strong id="cheatsheet-count">{cheatSheets.length}</strong> cards visible</span>
          <button type="button" class="clear-button" data-clear-filters>Clear filters</button>
        </div>

        <div class="sheets-grid" id="cheatsheet-grid">
          {cheatSheets.map((sheet) => {
            const searchText = [
              sheet.title,
              sheet.category,
              sheet.description,
              ...sheet.tags,
              ...sheet.notes,
              ...sheet.commands.flatMap((command) => [command.label, command.code])
            ].join(' ').toLowerCase();

            return (
              <article
                class="sheet-card"
                data-cheatsheet-card
                data-category={sheet.category}
                data-search={searchText}
              >
                <header class="sheet-header">
                  <div class="sheet-icon">
                    <SecurityIcon name={sheet.icon} size={22} />
                  </div>
                  <div>
                    <p class="sheet-category">{sheet.category}</p>
                    <h2>{sheet.title}</h2>
                  </div>
                </header>

                <p class="sheet-description">{sheet.description}</p>

                {sheet.warning && (
                  <p class="sheet-warning">
                    <SecurityIcon name="shield" size={16} />
                    <span>{sheet.warning}</span>
                  </p>
                )}

                <div class="command-list">
                  {sheet.commands.map((command) => (
                    <div class="command-block">
                      <div class="command-head">
                        <span>{command.label}</span>
                        {command.copy !== false && (
                          <button type="button" class="copy-button" data-copy-command aria-label={`Copy ${command.label}`}>
                            Copy
                          </button>
                        )}
                      </div>
                      <pre><code>{command.code}</code></pre>
                    </div>
                  ))}
                </div>

                <ul class="sheet-notes">
                  {sheet.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>

                {sheet.links && sheet.links.length > 0 && (
                  <div class="sheet-links">
                    {sheet.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label}
                        <SecurityIcon name="external" size={14} />
                      </a>
                    ))}
                  </div>
                )}

                <div class="sheet-tags" aria-label={`${sheet.title} tags`}>
                  {sheet.tags.map((tag) => (
                    <button type="button" data-tag-filter={tag}>#{tag}</button>
                  ))}
                </div>
              </article>
            );
          })}
        </div>

        <div class="empty-state" id="cheatsheet-empty" hidden>
          <SecurityIcon name="search" size={34} />
          <h2>No matching cheat sheets</h2>
          <p>Clear filters or search for a broader technique, tool, or category.</p>
          <button type="button" class="button button-primary" data-clear-filters>Clear filters</button>
        </div>
      </div>
    </section>

    <section class="section cve-section">
      <div class="container">
        <div class="cve-layout">
          <div>
            <div class="meta-pill">
              <SecurityIcon name="file" size={16} />
              <span>CVE workflow</span>
            </div>
            <h2>CVE and exploit research</h2>
            <p>
              Use this as a source checklist. Do not invent live CVE details. Verify affected versions,
              fixed versions, exploitability, and patch status from primary sources.
            </p>
          </div>

          <div class="cve-card">
            <h3>Placeholder record format</h3>
            <dl>
              <div><dt>CVE</dt><dd>CVE-YYYY-NNNN</dd></div>
              <div><dt>Vendor advisory</dt><dd>Official advisory URL</dd></div>
              <div><dt>Affected version</dt><dd>Verified vulnerable range</dd></div>
              <div><dt>Fixed version</dt><dd>Patched release or mitigation</dd></div>
              <div><dt>CVSS / CWE</dt><dd>Score, vector, and weakness class</dd></div>
              <div><dt>Exploitability</dt><dd>Auth, reachability, prerequisites, patch status</dd></div>
            </dl>
          </div>
        </div>

        <div class="research-links">
          {cveResearchLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              <span>{link.label}</span>
              <SecurityIcon name="external" size={14} />
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .cheatsheets-page {
    padding-top: 80px;
  }

  .cheatsheets-hero {
    padding-top: calc(var(--section-spacing) * 1.15);
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background:
      radial-gradient(circle at 82% 12%, rgba(56, 189, 248, 0.18), transparent 32%),
      linear-gradient(135deg, rgba(8, 20, 47, 0.86), rgba(5, 11, 31, 0));
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(280px, 0.82fr);
    gap: 2rem;
    align-items: end;
  }

  .hero-copy h1 {
    max-width: 860px;
    margin-top: 1.1rem;
    text-wrap: balance;
  }

  .hero-copy p {
    max-width: 72ch;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .hero-panel div,
  .sheet-card,
  .cve-card,
  .empty-state {
    background: var(--gradient-panel);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    box-shadow: var(--shadow-medium);
  }

  .hero-panel div {
    padding: 1rem;
  }

  .hero-panel strong {
    display: block;
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1;
  }

  .hero-panel span {
    display: block;
    margin-top: 0.45rem;
    color: var(--muted-text);
    font-size: 0.76rem;
    text-transform: uppercase;
  }

  .cheatsheet-controls {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1rem;
    background: rgba(8, 20, 47, 0.74);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
  }

  .search-group {
    display: grid;
    gap: 0.45rem;
  }

  .search-group span {
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .search-group input {
    width: 100%;
    min-height: 48px;
    color: var(--text-primary);
    background: rgba(5, 11, 31, 0.86);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 0.75rem 0.9rem;
  }

  .search-group input:focus {
    outline: none;
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px var(--accent-blue-subtle);
  }

  .filter-group,
  .sheet-tags,
  .sheet-links,
  .research-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .filter-chip,
  .sheet-tags button,
  .clear-button,
  .category-tile {
    color: var(--text-secondary);
    background: rgba(8, 20, 47, 0.78);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    cursor: pointer;
  }

  .filter-chip {
    min-height: 44px;
    padding: 0.45rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .filter-chip:hover,
  .filter-chip.active,
  .sheet-tags button:hover,
  .sheet-tags button.active,
  .category-tile:hover,
  .category-tile.active {
    color: var(--accent-blue);
    border-color: var(--accent-blue);
    background: var(--accent-blue-subtle);
  }

  .category-band {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(5, 11, 31, 0.4);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
  }

  .category-tile {
    display: flex;
    justify-content: space-between;
    gap: 0.7rem;
    align-items: center;
    padding: 0.85rem;
    min-height: 48px;
    text-align: left;
  }

  .category-tile span {
    font-weight: 700;
  }

  .category-tile strong {
    color: var(--accent-blue);
    font-family: var(--font-mono);
  }

  .sheets-section {
    padding-top: 2rem;
  }

  .results-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
  }

  .results-line strong {
    color: var(--accent-blue);
    font-family: var(--font-mono);
  }

  .clear-button {
    min-height: 44px;
    padding: 0.45rem 0.75rem;
    font-weight: 700;
  }

  .sheets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 1.2rem;
    align-items: start;
  }

  .sheet-card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }

  .sheet-header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
  }

  .sheet-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    color: var(--accent-blue);
    background: var(--accent-blue-subtle);
    border: 1px solid var(--border-medium);
    border-radius: 10px;
  }

  .sheet-category {
    margin: 0 0 0.25rem;
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: 0.73rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .sheet-header h2 {
    margin: 0;
    font-size: 1.18rem;
  }

  .sheet-description {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .sheet-warning {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    margin: 0;
    padding: 0.75rem;
    color: var(--soft-cyan);
    background: rgba(37, 99, 235, 0.1);
    border: 1px solid var(--border-medium);
    border-radius: 8px;
    font-size: 0.85rem;
  }

  .command-list {
    display: grid;
    gap: 0.75rem;
  }

  .command-block {
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: rgba(5, 11, 31, 0.68);
  }

  .command-head {
    display: flex;
    min-height: 38px;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
    padding: 0.45rem 0.55rem 0.45rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .command-head span {
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .copy-button {
    min-height: 36px;
    padding: 0.25rem 0.55rem;
    color: var(--accent-blue);
    background: var(--accent-blue-subtle);
    border: 1px solid var(--border-medium);
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .copy-button.copied {
    color: var(--bg-main);
    background: var(--accent-blue);
  }

  .command-block pre {
    margin: 0;
    padding: 0.85rem;
    overflow-x: auto;
  }

  .command-block code {
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
    white-space: pre;
  }

  .sheet-notes {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .sheet-links a,
  .research-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: rgba(8, 20, 47, 0.72);
    font-weight: 700;
  }

  .sheet-links a {
    padding: 0.45rem 0.65rem;
    min-height: 44px;
    font-size: 0.82rem;
  }

  .research-links a {
    padding: 0.7rem 0.85rem;
  }

  .sheet-links a:hover,
  .research-links a:hover {
    color: var(--accent-blue);
    border-color: var(--accent-blue);
  }

  .sheet-tags {
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .sheet-tags button {
    min-height: 38px;
    padding: 0.3rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .empty-state {
    padding: 3rem 1.25rem;
    text-align: center;
  }

  .empty-state svg {
    color: var(--accent-blue);
    margin-bottom: 1rem;
  }

  .empty-state h2 {
    font-size: 1.5rem;
  }

  .cve-section {
    border-top: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, rgba(8, 20, 47, 0.46), rgba(5, 11, 31, 0));
  }

  .cve-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(300px, 1.1fr);
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 1.5rem;
  }

  .cve-layout h2 {
    margin-top: 1rem;
  }

  .cve-layout p {
    max-width: 62ch;
  }

  .cve-card {
    padding: 1.25rem;
  }

  .cve-card h3 {
    margin: 0 0 1rem;
    font-size: 1.1rem;
  }

  .cve-card dl {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .cve-card div {
    display: grid;
    grid-template-columns: minmax(120px, 0.45fr) minmax(0, 1fr);
    gap: 0.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cve-card div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .cve-card dt {
    color: var(--accent-blue);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .cve-card dd {
    margin: 0;
    color: var(--text-secondary);
  }

  @media (max-width: 980px) {
    .hero-grid,
    .cve-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .cheatsheets-page {
      padding-top: 68px;
    }

    .cheatsheets-hero {
      padding-top: 2.25rem;
      padding-bottom: 1.75rem;
    }

    .hero-copy h1 {
      font-size: clamp(2rem, 10vw, 2.8rem);
    }

    .hero-copy p {
      font-size: 1rem;
      line-height: 1.65;
    }

    .hero-panel,
    .sheets-grid,
    .category-grid {
      grid-template-columns: 1fr;
    }

    .cheatsheet-controls,
    .sheet-card {
      padding: 1rem;
    }

    .filter-group {
      display: grid;
      grid-template-columns: 1fr;
    }

    .filter-chip,
    .clear-button {
      width: 100%;
      justify-content: center;
    }

    .results-line {
      align-items: flex-start;
      flex-direction: column;
    }

    .sheet-header {
      grid-template-columns: 1fr;
    }

    .command-head {
      align-items: stretch;
      flex-direction: column;
    }

    .copy-button {
      width: 100%;
    }

    .cve-card div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = Array.from(document.querySelectorAll('[data-cheatsheet-card]'))
      .filter((card): card is HTMLElement => card instanceof HTMLElement);
    const searchInput = document.getElementById('cheatsheet-search');
    const countElement = document.getElementById('cheatsheet-count');
    const emptyState = document.getElementById('cheatsheet-empty');
    const grid = document.getElementById('cheatsheet-grid');
    const categoryButtons = Array.from(document.querySelectorAll('[data-category-filter]'))
      .filter((button): button is HTMLButtonElement => button instanceof HTMLButtonElement);
    const tagButtons = Array.from(document.querySelectorAll('[data-tag-filter]'))
      .filter((button): button is HTMLButtonElement => button instanceof HTMLButtonElement);
    let activeCategory = 'all';
    let activeTag = '';

    function getSearchTerm() {
      return searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : '';
    }

    function setActiveCategory(category: string) {
      activeCategory = category;
      categoryButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.categoryFilter === category);
      });
    }

    function setActiveTag(tag: string) {
      activeTag = tag;
      tagButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.tagFilter === tag);
      });
    }

    function filterCards() {
      const searchTerm = getSearchTerm();
      let visible = 0;

      cards.forEach((card) => {
        const category = card.dataset.category || '';
        const search = card.dataset.search || '';
        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesTag = !activeTag || search.includes(activeTag.toLowerCase());
        const matchesSearch = !searchTerm || search.includes(searchTerm);
        const shouldShow = matchesCategory && matchesTag && matchesSearch;

        card.hidden = !shouldShow;
        if (shouldShow) visible += 1;
      });

      if (countElement) countElement.textContent = String(visible);
      if (grid && emptyState) {
        grid.hidden = visible === 0;
        emptyState.hidden = visible !== 0;
      }
    }

    searchInput?.addEventListener('input', filterCards);

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setActiveCategory(button.dataset.categoryFilter || 'all');
        filterCards();
        document.querySelector('.sheets-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const tag = button.dataset.tagFilter || '';
        setActiveTag(activeTag === tag ? '' : tag);
        filterCards();
      });
    });

    document.querySelectorAll('[data-clear-filters]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener('click', () => {
        if (searchInput instanceof HTMLInputElement) searchInput.value = '';
        setActiveCategory('all');
        setActiveTag('');
        filterCards();
      });
    });

    document.querySelectorAll('[data-copy-command]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      button.addEventListener('click', async () => {
        const block = button.closest('.command-block');
        const code = block?.querySelector('code')?.textContent;
        if (!code || !navigator.clipboard) return;

        await navigator.clipboard.writeText(code);
        const previous = button.textContent || 'Copy';
        button.textContent = 'Copied';
        button.classList.add('copied');
        window.setTimeout(() => {
          button.textContent = previous;
          button.classList.remove('copied');
        }, 1400);
      });
    });

    filterCards();
  });
</script>
