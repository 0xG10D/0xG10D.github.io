---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostRow from '../components/PostRow.astro';
import achievementContent from '../content/achievements/certifications.json';
import { projects } from '../data/projects';
import {
  formatShortDate,
  getChallengeType,
  getEventName,
  getEventSlug,
  getReadMinutes,
  getSection,
  getWriteupUrl,
  sortWriteupsNewestFirst
} from '../utils/writeups';

type Post = CollectionEntry<'writeups'>;

const posts = (await getCollection('writeups', ({ data }) => !data.draft)).sort(sortWriteupsNewestFirst);
const [lead, ...others] = posts;
const sidePosts = others.slice(0, 2);
const recentPosts = others.slice(2, 6);

const countOf = (section: string) => posts.filter((post) => getSection(post) === section).length;
const counts = { htb: countOf('htb'), sherlock: countOf('sherlock'), ctf: countOf('ctf'), lab: countOf('lab') };

const stats = [
  { icon: 'book', value: posts.length, label: 'Posts' },
  { icon: 'flag', value: counts.ctf, label: 'CTF Writeups' },
  { icon: 'flask', value: counts.lab, label: 'Lab & Research Notes' },
  { icon: 'code', value: projects.length, label: 'Projects' }
] as const;

const categories = [
  { icon: 'terminal', href: '/writeups/#ctf', label: 'CTF Events', note: `${counts.ctf} writeups` },
  { icon: 'box', href: '/writeups/#htb', label: 'HTB Machines', note: `${counts.htb} machines` },
  { icon: 'search', href: '/writeups/#sherlock', label: 'HTB Sherlocks', note: `${counts.sherlock} investigations` },
  { icon: 'flask', href: '/research/', label: 'Research', note: `${counts.lab} lab notes` },
  { icon: 'code', href: '/projects/', label: 'Projects', note: `${projects.length} tools` }
] as const;

const indexLinks = [
  { href: '/blog/', label: 'Blog' },
  { href: '/writeups/', label: 'Writeups' },
  { href: '/research/', label: 'Research' },
  { href: '/projects/', label: 'Projects' }
];

const pillsFor = (post: Post) => [getChallengeType(post), getEventName(getEventSlug(post))];
---

<BaseLayout title="Cybersecurity Notes, Writeups & Research">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="prompt">0xG10D://blog</p>
        <h1>Cybersecurity Notes, Writeups &amp; Research<span class="caret" aria-hidden="true">_</span></h1>
        <p class="hero-lede">
          A personal blog documenting hands-on cybersecurity learning, CTF writeups, DFIR lab notes, and security tooling.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/blog/">
            <Icon name="terminal" size={17} />
            Explore Blog
            <Icon name="arrow" size={17} />
          </a>
          <a class="button" href="/writeups/">
            <Icon name="rocket" size={17} />
            Latest Writeups
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hud">
          <svg class="hud-rings" viewBox="0 0 440 440" fill="none" aria-hidden="true">
            <circle class="hud-spin" cx="220" cy="220" r="204" stroke="currentColor" stroke-width="1" stroke-dasharray="150 60 40 90 220 70" opacity="0.5" />
            <circle cx="220" cy="220" r="178" stroke="currentColor" stroke-width="1" stroke-dasharray="2 9" opacity="0.45" />
            <circle cx="220" cy="220" r="156" stroke="currentColor" stroke-width="2" stroke-dasharray="560 70 250 100" stroke-linecap="round" transform="rotate(-140 220 220)" />
            <path d="M398 22h24v24M42 418H18v-24" stroke="currentColor" stroke-width="1.5" />
            <path d="M8 196h44M388 232h36" stroke="currentColor" stroke-width="1" opacity="0.7" />
            <circle cx="5" cy="196" r="3" stroke="currentColor" stroke-width="1" />
            <circle cx="427" cy="232" r="2" fill="currentColor" />
            <circle cx="430" cy="118" r="3" stroke="currentColor" stroke-width="1" />
          </svg>
          <img
            class="hud-mascot"
            src="/images/brand/mascot.webp"
            srcset="/images/brand/mascot-360.webp 360w, /images/brand/mascot.webp 640w"
            sizes="(max-width: 640px) 190px, (max-width: 1400px) 270px, 410px"
            alt="0xG10D mascot: an angular fox-like mark"
            width="640"
            height="602"
            fetchpriority="high"
          />
        </div>

        <nav class="index-card" aria-label="Sections">
          <p class="index-card-title">0xG10D</p>
          <ul>
            {indexLinks.map((link) => (
              <li>
                <a href={link.href}>
                  <span class="index-card-mark" aria-hidden="true">▷</span>
                  <span>{link.label}</span>
                  <span class="index-card-check" aria-hidden="true"><Icon name="check" size={11} /></span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <div class="container home-body">
    <ul class="stats panel" aria-label="Archive totals">
      {stats.map((stat) => (
        <li class="stat">
          <Icon name={stat.icon} size={26} />
          <p>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </p>
        </li>
      ))}
    </ul>

    {lead && (
      <section class="block" aria-labelledby="featured-heading">
        <div class="section-head">
          <div>
            <p class="eyebrow">Featured</p>
            <h2 id="featured-heading">Latest Posts</h2>
          </div>
          <a class="more-link" href="/blog/">View All <Icon name="arrow" size={17} /></a>
        </div>

        <div class="featured-grid">
          <a class="feature feature-lead panel card-link" href={getWriteupUrl(lead)}>
            <div class="feature-body">
              <p class="feature-pills">{pillsFor(lead).map((pill) => <span class="pill">{pill}</span>)}</p>
              <h3>{lead.data.title}</h3>
              {lead.data.summary && <p class="feature-summary">{lead.data.summary}</p>}
              <p class="feature-meta">
                <span class="meta"><Icon name="calendar" size={15} />{formatShortDate(lead.data.date)}</span>
                <span class="meta"><Icon name="clock" size={15} />{getReadMinutes(lead)} min read</span>
              </p>
            </div>
            {lead.data.boxImage && (
              <div class="feature-media"><img src={lead.data.boxImage} alt="" decoding="async" /></div>
            )}
          </a>

          <div class="featured-side">
            {sidePosts.map((post) => (
              <a class="feature panel card-link" href={getWriteupUrl(post)}>
                <div class="feature-body">
                  <p class="feature-pills">{pillsFor(post).map((pill) => <span class="pill">{pill}</span>)}</p>
                  <h3>{post.data.title}</h3>
                  <p class="feature-meta">
                    <span class="meta"><Icon name="calendar" size={15} />{formatShortDate(post.data.date)}</span>
                    <span class="meta"><Icon name="clock" size={15} />{getReadMinutes(post)} min read</span>
                  </p>
                </div>
                {post.data.boxImage && (
                  <div class="feature-media"><img src={post.data.boxImage} alt="" loading="lazy" decoding="async" /></div>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="block" aria-labelledby="categories-heading">
      <h2 class="eyebrow" id="categories-heading">Categories</h2>
      <ul class="category-grid">
        {categories.map((category) => (
          <li>
            <a class="category panel card-link" href={category.href}>
              <Icon name={category.icon} size={26} />
              <span>
                <strong>{category.label}</strong>
                <small>{category.note}</small>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="recent-grid block">
      <section aria-labelledby="recent-heading">
        <h2 class="eyebrow" id="recent-heading">Recent posts</h2>
        <div class="post-list">
          {recentPosts.map((post) => <PostRow post={post} />)}
        </div>
      </section>

      <aside class="about-card panel" aria-labelledby="about-heading">
        <h2 id="about-heading"><Icon name="info" size={18} /> About This Blog</h2>
        <p>{achievementContent.overview.summary}</p>
        <img src="/images/brand/mascot-96.png" alt="" width="48" height="45" loading="lazy" />
        <div class="about-card-foot">
          <h3><Icon name="link" size={17} /> Follow / Connect</h3>
          <div class="social-links">
            <a href="https://github.com/0xG10D" target="_blank" rel="noopener noreferrer" aria-label="0xG10D on GitHub">
              <Icon name="github" size={20} />
            </a>
            <a href="/about/" aria-label="About 0xG10D"><Icon name="info" size={20} /></a>
            <a href="/achievements/" aria-label="Certifications and CTF record"><Icon name="award" size={20} /></a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  /* ----- hero ----- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 4vw, 3rem) 0 clamp(1.5rem, 3vw, 2rem);
  }

  /* Planet horizon, bottom right */
  .hero::after {
    content: "";
    position: absolute;
    right: -26%;
    bottom: -930px;
    z-index: 0;
    width: 1100px;
    height: 1100px;
    border-top: 1px solid rgba(245, 245, 245, 0.45);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 0, rgba(245, 245, 245, 0.12), transparent 24%),
      radial-gradient(rgba(245, 245, 245, 0.11) 1px, transparent 1.3px) 0 0 / 6px 6px,
      #060606;
    box-shadow: 0 -14px 70px rgba(245, 245, 245, 0.1);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
  }

  .hero-copy h1 {
    max-width: 12.5em;
    margin-bottom: 1.2rem;
    font-size: clamp(2.05rem, 4.1vw, 4.6rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .caret {
    animation: caret-blink 1.1s steps(1) infinite;
  }

  .hero-lede {
    max-width: 46ch;
    margin: 0 0 1.5rem;
    color: var(--text-soft);
    font-size: clamp(0.94rem, 1.05vw, 1.2rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.4rem;
  }

  .hero-actions .button {
    min-height: 46px;
    gap: 0.8rem;
    padding-inline: 1.3rem;
    border-color: var(--border-bright);
    color: var(--text);
  }

  .hero-actions .button-primary {
    color: var(--bg);
  }

  .hero-visual {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(168px, 12vw, 240px);
    gap: 1.25rem;
    align-items: start;
  }

  .hud {
    position: relative;
    width: min(100%, clamp(400px, 30vw, 620px));
    aspect-ratio: 1;
    margin-inline: auto;
    color: var(--text);
  }

  .hud-rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hud-spin {
    transform-origin: 220px 220px;
    animation: hud-spin 90s linear infinite;
  }

  .hud-mascot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 66%;
    height: auto;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 0 26px rgba(245, 245, 245, 0.16));
    animation: mascot-in 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes mascot-in {
    /* No opacity fade: the mascot is the largest paint, and fading it in delays LCP. */
    from {
      transform: translate(-50%, -46%) scale(0.94);
    }
  }

  @keyframes hud-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .index-card {
    margin-top: 0.5rem;
    border: 1px solid var(--border-strong);
    border-top-color: var(--border-bright);
    border-radius: var(--radius);
    background: rgba(5, 5, 5, 0.72);
  }

  .index-card-title {
    margin: 0;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: var(--text-md);
    font-weight: 700;
  }

  .index-card ul {
    margin: 0;
    padding: 0.35rem 0;
    list-style: none;
  }

  .index-card a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.6rem;
    min-height: 32px;
    align-items: center;
    padding: 0 0.9rem;
    color: var(--text-soft);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .index-card a:hover,
  .index-card a:focus-visible {
    background: var(--elevated);
    color: var(--text);
  }

  .index-card-mark {
    font-size: 0.6rem;
  }

  .index-card-check {
    display: inline-flex;
    width: 15px;
    height: 15px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-bright);
    border-radius: 3px;
  }

  .index-card a:hover .index-card-check {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ----- stats ----- */
  .home-body {
    position: relative;
    z-index: 1;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 0.6rem;
    padding: 0.85rem 0;
    list-style: none;
    border-color: var(--border-strong);
    background: rgba(11, 13, 16, 0.86);
  }

  .stat {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    padding: 0.2rem 1rem;
  }

  .stat + .stat {
    border-left: 1px solid var(--border-strong);
  }

  .stat p {
    margin: 0;
  }

  .stat strong {
    display: block;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .stat span {
    color: var(--text-2);
    font-size: var(--text-xs);
  }

  /* ----- featured ----- */
  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.66fr) minmax(0, 1fr);
    gap: 1.25rem;
  }

  .featured-side {
    display: grid;
    gap: 1rem;
  }

  .feature {
    position: relative;
    display: flex;
    min-height: 118px;
    overflow: hidden;
    border-color: var(--border-strong);
  }

  .feature-lead {
    min-height: clamp(240px, 17vw, 380px);
  }

  /* corner bracket on the lead card */
  .feature-lead::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 18px;
    height: 18px;
    border-top: 2px solid var(--text);
    border-left: 2px solid var(--text);
    border-top-left-radius: var(--radius-lg);
  }

  .feature-body {
    position: relative;
    z-index: 1;
    display: flex;
    max-width: 68%;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.25rem;
  }

  .feature-lead .feature-body {
    max-width: 64%;
    gap: 0.85rem;
    padding: 1.5rem 1.9rem;
  }

  .feature-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .feature h3 {
    font-family: var(--font-mono);
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .feature-lead h3 {
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.3;
  }

  .feature-summary {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
  }

  .feature-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    margin: auto 0 0;
  }

  .feature-media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 46%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 55%);
    mask-image: linear-gradient(to right, transparent, #000 55%);
  }

  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    opacity: 0.7;
    transition: filter 240ms ease, opacity 240ms ease;
  }

  .feature:hover .feature-media img,
  .feature:focus-visible .feature-media img {
    filter: none;
    opacity: 0.95;
  }

  /* ----- categories ----- */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .category {
    display: flex;
    min-height: 60px;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1.1rem;
    border-color: var(--border-strong);
  }

  .category strong {
    display: block;
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.35;
  }

  .category small {
    color: var(--text-2);
    font-size: 0.66rem;
  }

  /* ----- recent + about ----- */
  .recent-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(306px, 22vw, 420px);
    gap: 2rem;
    align-items: start;
  }

  .recent-grid .post-list {
    margin-top: 0.7rem;
  }

  .about-card {
    display: grid;
    gap: 0.9rem;
    padding: 1.2rem 1.25rem;
    border-color: var(--border-strong);
  }

  .about-card h2,
  .about-card h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 1.02rem;
    font-weight: 500;
  }

  .about-card h3 {
    font-size: var(--text-sm);
  }

  .about-card p {
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .about-card > img {
    width: 48px;
    height: auto;
    margin-inline: auto;
  }

  .about-card-foot {
    display: grid;
    gap: 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .about-card .social-links {
    justify-content: center;
  }

  /* ----- responsive ----- */
  @media (max-width: 1080px) {
    .hero-visual {
      grid-template-columns: 1fr;
    }

    .index-card {
      display: none;
    }

    .category-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .featured-grid,
    .recent-grid {
      grid-template-columns: 1fr;
    }

    .featured-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat {
      flex-direction: column;
      gap: 0.4rem;
      text-align: center;
    }
  }

  @media (max-width: 640px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hud {
      width: min(72vw, 280px);
      margin-top: 1rem;
    }

    .hero::after {
      display: none;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0.9rem;
    }

    .stat:nth-child(3) {
      border-left: 0;
    }

    .featured-side,
    .category-grid {
      grid-template-columns: 1fr;
    }

    .feature-lead .feature-body {
      max-width: 100%;
      padding: 1.25rem;
    }

    .feature-lead .feature-media {
      opacity: 0.35;
    }
  }
</style>
