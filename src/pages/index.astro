---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import achievementContent from '../content/achievements/certifications.json';
import { formatArchiveDate, getChallengeType, getWriteupUrl, sortWriteupsNewestFirst } from '../utils/writeups';
import { parseAchievementDate, formatAchievementYear } from '../utils/achievements';

type AchievementOverview = {
  overview: {
    summary: string;
    focusAreas: string[];
  };
  certifications: {
    networkingSecurity: { name: string; provider: string; date?: string }[];
    cybersecurity: { name: string; provider: string; date?: string }[];
  };
  ctfCompetitions: { event: string; organizer: string; date: string; placement: string }[];
};

const data = achievementContent as AchievementOverview;

const allWriteups = await getCollection('writeups', ({ data: entry }) => !entry.draft);
const latestWriteups = allWriteups.sort(sortWriteupsNewestFirst).slice(0, 3);

const allCertifications = [
  ...data.certifications.networkingSecurity,
  ...data.certifications.cybersecurity
].map((cert) => ({
  title: cert.name,
  meta: cert.provider,
  date: parseAchievementDate(cert.date ?? '')
}));

const ctfHighlights = data.ctfCompetitions.map((ctf) => ({
  title: ctf.event,
  meta: `${ctf.placement} • ${ctf.organizer}`,
  date: parseAchievementDate(ctf.date)
}));

const recentAchievements = [...allCertifications, ...ctfHighlights]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

const latestCert = allCertifications.sort((a, b) => b.date.valueOf() - a.date.valueOf())[0];
---

<BaseLayout title="Cybersecurity Writeup Archive">
  <div class="homepage">
    <section class="intro">
      <div class="container intro-grid">
        <div class="intro-copy">
          <p class="field-tag">Field Note // 001</p>
          <h1>0xG10D<span class="cursor-blink" aria-hidden="true"></span></h1>
          <p class="intro-tagline">Penetration Testing, DFIR, Malware Analysis &amp; CTF Player</p>
        </div>

        <aside class="status-panel" aria-label="Current status">
          <p class="field-tag">Current Status</p>
          <p class="status-line status-line-em">Student</p>
          {latestCert && <p class="status-line">Certs: {latestCert.title}</p>}
        </aside>
      </div>
    </section>

    <section class="section field-body">
      <div class="container field-grid">
        <div class="field-col">
          <div class="field-head">
            <span class="field-num">(01)</span>
            <span class="field-rule" aria-hidden="true"></span>
            <span class="field-label">Mission</span>
          </div>

          <div class="field-copy">
            <p>{data.overview.summary}</p>
            <p>Primary focus: {data.overview.focusAreas.join(', ')}.</p>
          </div>

          <div class="field-head field-head-spaced">
            <span class="field-num">(02)</span>
            <span class="field-rule" aria-hidden="true"></span>
            <span class="field-label">Achievement</span>
          </div>

          <div class="ach-timeline">
            {recentAchievements.map((item) => (
              <div class="ach-item">
                <p class="ach-year">{formatAchievementYear(item.date)}</p>
                <h3 class="ach-title">{item.title}</h3>
                <p class="ach-meta">{item.meta}</p>
              </div>
            ))}
          </div>

          <a href="/achievements/" class="archive-link">View all achievements</a>
        </div>

        <div class="field-col">
          <div class="field-head">
            <span class="field-num">(03)</span>
            <span class="field-rule" aria-hidden="true"></span>
            <span class="field-label">Writeups</span>
          </div>

          {latestWriteups.length > 0 ? (
            <div class="teaser-list">
              {latestWriteups.map((post) => (
                <article class="teaser-row">
                  <div class="teaser-meta">
                    <span>{getChallengeType(post)}</span>
                    <span>{formatArchiveDate(post.data.date)}</span>
                  </div>
                  <h3 class="teaser-title">
                    <a href={getWriteupUrl(post)}>{post.data.title}</a>
                  </h3>
                  {post.data.summary && <p class="teaser-summary">&ldquo;{post.data.summary}&rdquo;</p>}
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <h2>No writeups published</h2>
              <p>Published notes will appear here when they are ready.</p>
            </div>
          )}

          <a href="/writeups/" class="archive-link">View all archive</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    padding: clamp(2.75rem, 8vw, 5rem) 0 clamp(2.25rem, 6vw, 3.5rem);
    border-bottom: 1px solid var(--border);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.42fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }

  .intro-copy h1 {
    max-width: none;
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: clamp(2.75rem, 9vw, 6rem);
    line-height: 0.94;
  }

  .intro-tagline {
    max-width: 46ch;
    margin: 0;
    color: var(--text-soft);
    font-size: clamp(1.02rem, 1.8vw, 1.16rem);
  }

  .status-panel {
    padding-top: 0.35rem;
  }

  .status-line {
    margin: 0 0 0.35rem;
    color: var(--text-soft);
    font-family: var(--font-heading);
    font-style: italic;
  }

  .status-line-em {
    color: var(--text);
  }

  .status-line:last-child {
    margin-bottom: 0;
  }

  .field-body {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .field-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.94fr);
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: start;
  }

  .field-copy p {
    max-width: 60ch;
    color: var(--text-soft);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .ach-item:first-child::before {
    background: var(--accent-strong);
  }

  .teaser-list {
    display: grid;
  }

  .teaser-row {
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .teaser-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .teaser-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .teaser-title {
    margin-bottom: 0.35rem;
    font-size: 1.1rem;
  }

  .teaser-title a {
    color: var(--text);
    text-decoration: none;
  }

  .teaser-title a:hover {
    color: var(--accent-strong);
  }

  .teaser-summary {
    max-width: 52ch;
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    .intro-grid,
    .field-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .field-head-spaced {
      margin-top: 2.25rem;
    }
  }
</style>
