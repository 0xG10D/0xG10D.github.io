---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteupCard from '../components/WriteupCard.astro';
import { projects } from '../data/projects';

const allWriteups = await getCollection('writeups', ({ data }) => !data.draft);
const latestWriteups = allWriteups
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 10);

const featuredProjects = projects.filter((project) =>
  ['awd-watchdog', 'wavesentinel-wids'].includes(project.id)
);

const categories = [...new Set(allWriteups.map((post) => post.data.category))].length;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
---

<BaseLayout title="Cybersecurity Writeup Archive">
  <div class="homepage">
    <section class="intro">
      <div class="container intro-layout">
        <div class="intro-copy">
          <p class="intro-kicker">cybersecurity student / authorized labs / field notes</p>
          <h1>0xG10D</h1>
          <p>
            A personal archive of CTF writeups, DFIR notes, security lab work, and defensive tooling.
            Writeups are kept as reports first: dated, tagged, and organized for reuse.
          </p>
        </div>

        <dl class="archive-notes" aria-label="Archive status">
          <div>
            <dt>Writeups</dt>
            <dd>{allWriteups.length}</dd>
          </div>
          <div>
            <dt>Categories</dt>
            <dd>{categories}</dd>
          </div>
          <div>
            <dt>Latest</dt>
            <dd>{latestWriteups[0] ? formatDate(latestWriteups[0].data.date) : 'No posts yet'}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section latest-section">
      <div class="container">
        <div class="section-header section-header-row">
          <div>
            <p class="section-kicker">latest reports</p>
            <h2 class="section-title">Writeups</h2>
            <p class="section-subtitle">Recent notes from CTFs, machines, investigations, and lab exercises.</p>
          </div>
          <a href="/writeups/" class="text-link">Open archive</a>
        </div>

        {latestWriteups.length > 0 ? (
          <div class="writeup-list">
            {latestWriteups.map((post) => <WriteupCard post={post} />)}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No writeups published</h2>
            <p>Published notes will appear here when they are ready.</p>
          </div>
        )}
      </div>
    </section>

    <section class="section projects-section">
      <div class="container">
        <div class="section-header section-header-row">
          <div>
            <p class="section-kicker">side work</p>
            <h2 class="section-title">Security projects</h2>
            <p class="section-subtitle">Tooling and lab projects documented as case studies.</p>
          </div>
          <a href="/projects/" class="text-link">All projects</a>
        </div>

        <div class="project-list">
          {featuredProjects.map((project) => (
            <article class="project-row">
              <div>
                <p class="project-type">{project.type}</p>
                <h3><a href={project.route}>{project.title}</a></h3>
                <p>{project.summary}</p>
              </div>
              <div class="project-stack" aria-label={`${project.title} stack`}>
                {project.stack.slice(0, 6).map((tech) => <span>{tech}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    padding: clamp(3rem, 10vw, 6.5rem) 0 clamp(2.25rem, 6vw, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.38fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: end;
  }

  .intro-kicker,
  .section-kicker {
    margin: 0 0 0.8rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .intro h1 {
    max-width: none;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(2.45rem, 8vw, 5.4rem);
    line-height: 0.96;
  }

  .intro-copy p:not(.intro-kicker) {
    max-width: 68ch;
    margin: 0;
    color: var(--text-soft);
    font-size: clamp(1.08rem, 2vw, 1.24rem);
  }

  .archive-notes {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .archive-notes div {
    display: grid;
    grid-template-columns: minmax(6rem, 0.55fr) 1fr;
    gap: 1rem;
    padding: 0.82rem 0;
    border-bottom: 1px solid var(--border);
  }

  .archive-notes div:last-child {
    border-bottom: 0;
  }

  .archive-notes dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
  }

  .archive-notes dd {
    margin: 0;
    color: var(--text);
    text-align: right;
  }

  .section-header-row {
    display: flex;
    max-width: none;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .writeup-list,
  .project-list {
    display: grid;
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(190px, 0.32fr);
    gap: 1.5rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--border);
  }

  .project-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .project-row h3 {
    margin: 0.15rem 0 0.45rem;
    font-size: 1.35rem;
  }

  .project-row h3 a {
    text-decoration: none;
  }

  .project-row p {
    max-width: 74ch;
    margin: 0;
  }

  .project-type {
    color: var(--steel) !important;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-content: start;
    justify-content: flex-end;
  }

  .project-stack span {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.18rem 0.45rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 820px) {
    .intro-layout,
    .project-row {
      grid-template-columns: 1fr;
    }

    .section-header-row {
      display: grid;
    }

    .archive-notes dd {
      text-align: left;
    }

    .project-stack {
      justify-content: flex-start;
    }
  }
</style>
