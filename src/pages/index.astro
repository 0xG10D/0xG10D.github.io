---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteupCard from '../components/WriteupCard.astro';
import { projects } from '../data/projects';

const allWriteups = await getCollection('writeups', ({ data }) => !data.draft);
const latestWriteups = allWriteups
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);

const featuredProjects = projects.filter((project) =>
  ['awd-watchdog', 'wavesentinel-wids'].includes(project.id)
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
---

<BaseLayout title="Cybersecurity Writeup Archive">
  <main class="homepage">
    <section class="intro">
      <div class="container intro-layout">
        <div>
          <h1>0xG10D</h1>
          <p class="intro-copy">
            Cybersecurity student documenting penetration testing, CTF challenges, DFIR investigations,
            malware analysis, and the development of CellShield 2.0.
          </p>
        </div>

        <dl class="archive-notes" aria-label="Archive status">
          <div>
            <dt>Archive</dt>
            <dd>{allWriteups.length} writeups</dd>
          </div>
          <div>
            <dt>Latest</dt>
            <dd>{latestWriteups[0] ? formatDate(latestWriteups[0].data.date) : 'No posts yet'}</dd>
          </div>
          <div>
            <dt>Scope</dt>
            <dd>HTB, THM, local CTF, DFIR, tooling</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section latest-section">
      <div class="container">
        <div class="section-header section-header-row">
          <div>
            <h2 class="section-title">Latest writeups</h2>
            <p class="section-subtitle">Recent reports and lab notes, ordered by publication date.</p>
          </div>
          <a href="/writeups/" class="text-link">View archive</a>
        </div>

        {latestWriteups.length > 0 ? (
          <div class="writeup-list">
            {latestWriteups.map((post) => <WriteupCard post={post} />)}
          </div>
        ) : (
          <div class="empty-state">
            <p>No writeups are published yet.</p>
          </div>
        )}
      </div>
    </section>

    <section class="section projects-section">
      <div class="container">
        <div class="section-header section-header-row">
          <div>
            <h2 class="section-title">Featured projects</h2>
            <p class="section-subtitle">Security tools and lab projects with public documentation.</p>
          </div>
          <a href="/projects/" class="text-link">All projects</a>
        </div>

        <div class="project-list">
          {featuredProjects.map((project) => (
            <article class="project-row">
              <div>
                <p class="project-type">{project.type}</p>
                <h3><a href={project.route}>{project.title}</a></h3>
                <p>{project.summary}</p>
              </div>
              <div class="project-stack">
                {project.stack.slice(0, 5).map((tech) => <span>{tech}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .homepage {
    padding-top: 0;
  }

  .intro {
    padding: clamp(3rem, 9vw, 6rem) 0 clamp(2.25rem, 6vw, 4rem);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-main);
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.42fr);
    gap: 2rem;
    align-items: end;
  }

  .intro h1 {
    max-width: none;
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: clamp(2.2rem, 7vw, 5.4rem);
    line-height: 0.95;
  }

  .intro-copy {
    max-width: 66ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(1.08rem, 2vw, 1.28rem);
    line-height: 1.65;
  }

  .archive-notes {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--border-subtle);
  }

  .archive-notes div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
  }

  .archive-notes dt {
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .archive-notes dd {
    margin: 0;
    color: var(--text-secondary);
  }

  .section-header-row {
    display: flex;
    max-width: none;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
  }

  .text-link {
    flex: 0 0 auto;
    color: var(--accent-blue);
    font-weight: 700;
  }

  .writeup-list,
  .project-list {
    display: grid;
    gap: 0.85rem;
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 0.32fr);
    gap: 1.5rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .project-row:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-row h3 {
    margin: 0.15rem 0 0.45rem;
    font-size: 1.35rem;
  }

  .project-row p {
    margin: 0;
    max-width: 72ch;
  }

  .project-type {
    color: var(--muted-text) !important;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-content: start;
    justify-content: flex-end;
  }

  .project-stack span {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.18rem 0.45rem;
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 820px) {
    .intro-layout,
    .project-row {
      grid-template-columns: 1fr;
    }

    .section-header-row {
      display: grid;
    }

    .project-stack {
      justify-content: flex-start;
    }
  }
</style>
