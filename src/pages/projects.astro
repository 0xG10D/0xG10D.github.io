---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityIcon from '../components/SecurityIcon.astro';
import { projects } from '../data/projects';

const categoryId = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const projectCategories = [
  { id: 'all', label: 'All projects', count: projects.length },
  ...[...new Set(projects.map((project) => project.type))].map((type) => ({
    id: categoryId(type),
    label: type,
    count: projects.filter((project) => project.type === type).length
  }))
];

const allTechStack = [...new Set(projects.flatMap((project) => project.stack))];
---

<BaseLayout title="Projects">
  <div class="projects-page">
    <section class="projects-hero section">
      <div class="container">
        <div class="hero-grid">
          <div>
            <p class="hero-eyebrow">security tooling and lab work</p>
            <h1>Projects</h1>
            <p>
              Defensive tools and lab systems documented as technical case studies: what they solve,
              how they work, and what still needs improvement.
            </p>
          </div>

          <dl class="project-stats" aria-label="Project archive metrics">
            <div><dt>Projects</dt><dd>{projects.length}</dd></div>
            <div><dt>Categories</dt><dd>{projectCategories.length - 1}</dd></div>
            <div><dt>Technologies</dt><dd>{allTechStack.length}</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section projects-grid-section">
      <div class="container">
        <div class="category-filter" aria-label="Project filters">
          <p>Filter</p>
          <div class="filter-buttons">
            {projectCategories.map((category) => (
              <button
                type="button"
                class={`filter-button ${category.id === 'all' ? 'filter-button-active' : ''}`}
                data-category={category.id}
              >
                {category.label}
                <span class="filter-count">({category.count})</span>
              </button>
            ))}
          </div>
        </div>

        {projects.length > 0 ? (
          <div class="projects-grid">
            {projects.map((project) => (
              <article class="project-card" data-category={categoryId(project.type)}>
                <header class="project-card-header">
                  <p>{project.type}</p>
                  <h2><a href={project.route}>{project.title}</a></h2>
                </header>

                <p class="project-summary">{project.summary}</p>

                <div class="project-value">
                  <SecurityIcon name="shield" size={18} />
                  <span>{project.securityUseCaseTitle}: {project.securityUseCase}</span>
                </div>

                <div class="project-tech">
                  {project.stack.map((tech) => <span>{tech}</span>)}
                </div>

                <ul class="features-list">
                  {project.features.slice(0, 3).map((feature) => <li>{feature}</li>)}
                </ul>

                <footer class="project-card-footer">
                  <a href={project.route} class="text-link">Read case study</a>
                  {project.repoUrl && (
                    <a href={project.repoUrl} class="repo-link" target="_blank" rel="noopener noreferrer">
                      GitHub
                    </a>
                  )}
                </footer>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No projects available</h2>
            <p>Project notes will be listed here when public documentation is ready.</p>
          </div>
        )}
      </div>
    </section>

    <section class="section project-details">
      <div class="container">
        <div class="section-header">
          <p class="section-kicker">documentation index</p>
          <h2 class="section-title">Technical notes</h2>
          <p class="section-subtitle">
            Summary records for each project, kept separate from the full project pages.
          </p>
        </div>

        <div class="details-grid">
          {projects.map((project) => (
            <article class="detail-card" id={project.id}>
              <header class="detail-header">
                <h3>{project.title}</h3>
                <div class="detail-meta">
                  <span>{project.type}</span>
                  <span>{project.stack.length} technologies</span>
                  <span>public documentation</span>
                </div>
              </header>

              <div class="detail-content">
                <section>
                  <h4>Overview</h4>
                  <p>{project.overview}</p>
                </section>
                <section>
                  <h4>Problem</h4>
                  <p>{project.problem}</p>
                </section>
                <section>
                  <h4>Workflow</h4>
                  <ol>
                    {project.workflow.map((step) => <li>{step}</li>)}
                  </ol>
                </section>
                <section>
                  <h4>Future improvements</h4>
                  <ul>
                    {project.future.map((item) => <li>{item}</li>)}
                  </ul>
                </section>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .projects-hero {
    border-bottom: 1px solid var(--border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.38fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: end;
  }

  .hero-eyebrow,
  .section-kicker {
    margin: 0 0 0.9rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .projects-hero h1 {
    margin-bottom: 1rem;
  }

  .projects-hero p:not(.hero-eyebrow) {
    max-width: 70ch;
    font-size: 1.08rem;
  }

  .project-stats {
    display: grid;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .project-stats div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.82rem 0;
    border-bottom: 1px solid var(--border);
  }

  .project-stats div:last-child {
    border-bottom: 0;
  }

  .project-stats dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
  }

  .project-stats dd {
    margin: 0;
    text-align: right;
  }

  .projects-grid-section {
    padding-top: clamp(2rem, 5vw, 3rem);
  }

  .category-filter {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .category-filter p {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-button {
    min-height: 36px;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .filter-button:hover,
  .filter-button-active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1rem;
  }

  .project-card {
    display: grid;
    gap: 1rem;
    padding: 1.15rem;
  }

  .project-card-header p {
    margin: 0 0 0.35rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .project-card-header h2 {
    font-size: 1.45rem;
  }

  .project-card-header a {
    text-decoration: none;
  }

  .project-summary {
    margin: 0;
    color: var(--text-soft);
  }

  .project-value {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .project-value svg {
    color: var(--steel);
    margin-top: 0.12rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-tech span {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.16rem 0.42rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .features-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-soft);
    font-size: 0.92rem;
  }

  .project-card-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
  }

  .repo-link {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
  }

  .details-grid {
    display: grid;
    gap: 1rem;
  }

  .detail-card {
    padding: 1.15rem;
  }

  .detail-header {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .detail-header h3 {
    margin-bottom: 0.55rem;
    font-size: 1.45rem;
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .detail-content {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding-top: 1rem;
  }

  .detail-content h4 {
    margin-bottom: 0.45rem;
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  .detail-content p {
    margin: 0;
  }

  .detail-content ol,
  .detail-content ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-soft);
  }

  @media (max-width: 820px) {
    .hero-grid,
    .detail-content {
      grid-template-columns: 1fr;
    }

    .project-stats dd {
      text-align: left;
    }
  }

  @media (max-width: 380px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-button');
    const projectCards = document.querySelectorAll('.project-card');

    if (filterButtons.length === 0 || projectCards.length === 0) return;

    filterButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      button.addEventListener('click', () => {
        filterButtons.forEach((btn) => btn.classList.remove('filter-button-active'));
        button.classList.add('filter-button-active');

        const category = button.dataset.category;

        projectCards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          card.hidden = !(category === 'all' || card.dataset.category === category);
        });
      });
    });
  });
</script>
