---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityIcon from '../components/SecurityIcon.astro';
import { projects } from '../data/projects';

const categoryId = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

// Project categories for filtering
const projectCategories = [
  { id: 'all', label: 'All Projects', count: projects.length },
  ...[...new Set(projects.map((project) => project.type))].map((type) => ({
    id: categoryId(type),
    label: type,
    count: projects.filter((project) => project.type === type).length
  }))
];

// Get unique tech stack items
const allTechStack = [...new Set(projects.flatMap(p => p.stack))];
---

<BaseLayout title="Projects">
  <main class="projects-page">
    <!-- ===== PROJECTS HERO ===== -->
    <section class="projects-hero section">
      <div class="container">
        <div class="hero-content">
          <div class="hero-eyebrow">
            <span class="eyebrow-tag">SECURITY TOOLING & RESEARCH</span>
            <span class="status-indicator active" aria-label="Active"></span>
          </div>

          <h1 class="hero-title">Security Projects</h1>

          <p class="hero-description">
            Practical implementations of wireless IDS systems, defensive monitoring,
            log collectors, and security automation tools built for learning and real-world application.
          </p>

          <div class="hero-stats">
            <div class="stat">
              <span class="stat-value">{projects.length}</span>
              <span class="stat-label">Total Projects</span>
            </div>
            <div class="stat">
              <span class="stat-value">{projectCategories.length - 1}</span>
              <span class="stat-label">Categories</span>
            </div>
            <div class="stat">
              <span class="stat-value">{allTechStack.length}</span>
              <span class="stat-label">Technologies</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== PROJECTS GRID ===== -->
    <section class="projects-grid-section section">
      <div class="container">
        <!-- Category Filter -->
        <div class="category-filter">
          <div class="filter-label">Filter by Category:</div>
          <div class="filter-buttons">
            {projectCategories.map((category) => (
              <button
                class={`filter-button ${category.id === 'all' ? 'filter-button-active' : ''}`}
                data-category={category.id}
              >
                {category.label}
                <span class="filter-count">({category.count})</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Projects Grid -->
        <div class="projects-grid">
          {projects.map((project, index) => (
            <article class="project-card" data-category={categoryId(project.type)} data-index={index}>
              <div class="project-card-inner">
                <!-- Project Header -->
                <div class="project-header">
                  <div class="project-badges">
                    <span class="badge badge-type">{project.type.toUpperCase()}</span>
                    <span class="badge badge-status">PUBLIC CASE STUDY</span>
                  </div>

                  <div class="project-meta">
                    <span class="project-date">{project.stack.length} technologies</span>
                  </div>
                </div>

                <!-- Project Body -->
                <div class="project-body">
                  <h2 class="project-title">{project.title}</h2>

                  <p class="project-summary">{project.summary}</p>

                  <div class="project-value">
                    <SecurityIcon name="shield" size={18} />
                    <span>{project.securityUseCaseTitle}: {project.securityUseCase}</span>
                  </div>

                  <div class="project-tech">
                    <h3 class="tech-heading">Tech Stack</h3>
                    <div class="tech-tags">
                      {project.stack.map((tech) => (
                        <span class="tech-tag">{tech}</span>
                      ))}
                    </div>
                  </div>

                  <div class="project-features">
                    <h3 class="features-heading">Key Features</h3>
                    <ul class="features-list">
                      {project.features.slice(0, 3).map((feature) => (
                        <li class="feature-item">{feature}</li>
                      ))}
                      {project.features.length > 3 && (
                        <li class="feature-item-more">+{project.features.length - 3} more</li>
                      )}
                    </ul>
                  </div>
                </div>

                <!-- Project Footer -->
                <div class="project-footer">
                  <div class="project-actions">
                    <a href={project.route} class="button button-primary">
                      View Details
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 12l4-4-4-4"/>
                      </svg>
                    </a>
                  </div>

                  <div class="project-links">
                    {project.repoUrl && (
                      <a href={project.repoUrl} class="project-link" target="_blank" rel="noopener noreferrer">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                        </svg>
                        GitHub
                      </a>
                    )}

                  </div>
                </div>
              </div>

              <!-- Project Glow -->
              <div class="project-glow" style={`--project-index: ${index}`}></div>
            </article>
          ))}
        </div>

        <!-- Empty State -->
        {projects.length === 0 && (
          <div class="empty-state">
            <div class="empty-state-icon"><SecurityIcon name="tool" size={34} /></div>
            <h3 class="empty-state-title">No Projects Available</h3>
            <p class="empty-state-description">
              Projects are currently under development. Check back soon for security tool updates!
            </p>
          </div>
        )}
      </div>
    </section>

    <!-- ===== PROJECT DETAILS ===== -->
    <section class="project-details section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Project Documentation</h2>
          <p class="section-subtitle">
            Detailed technical documentation, architecture diagrams, and implementation notes.
          </p>
        </div>

        <div class="details-grid">
          {projects.map((project) => (
            <div class="detail-section" id={project.id}>
              <article class="detail-card">
                <div class="detail-header">
                  <h3 class="detail-title">{project.title}</h3>
                  <div class="detail-meta">
                    <span class="meta-item">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="8" cy="8" r="6"/>
                        <path d="M8 4v4l2 2"/>
                      </svg>
                      {project.type}
                    </span>
                    <span class="meta-item">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 12h12"/>
                        <path d="M8 2v10"/>
                        <path d="M5 9l3 3 3-3"/>
                      </svg>
                      {project.stack.length} technologies
                    </span>
                    <span class="meta-item">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H2v12h12V2z"/>
                        <path d="M5 5h6"/>
                        <path d="M5 8h6"/>
                        <path d="M5 11h4"/>
                      </svg>
                      Public documentation
                    </span>
                  </div>
                </div>

                <div class="detail-content">
                  <div class="content-section">
                    <h4 class="content-heading">Overview</h4>
                    <p class="content-text">{project.overview}</p>
                  </div>

                  <div class="content-section">
                    <h4 class="content-heading">Problem Statement</h4>
                    <p class="content-text">
                      {project.problem}
                    </p>
                  </div>

                  <div class="content-section">
                    <h4 class="content-heading">Key Features</h4>
                    <ul class="content-list">
                      {project.features.map((feature) => (
                        <li>{feature}</li>
                      ))}
                    </ul>
                  </div>

                  <div class="content-section">
                    <h4 class="content-heading">Technical Architecture</h4>
                    <div class="architecture">
                      <ul class="content-list">
                        {project.workflow.map((step) => (
                          <li>{step}</li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div class="content-section">
                    <h4 class="content-heading">Security Value</h4>
                    <p class="content-text">
                      {project.securityUseCase}
                    </p>
                  </div>

                  <div class="content-section">
                    <h4 class="content-heading">Lessons Learned</h4>
                    <p class="content-text">
                      {project.helpText}
                    </p>
                  </div>

                  {project.future.length > 0 && (
                    <div class="content-section">
                      <h4 class="content-heading">Future Improvements</h4>
                      <ul class="content-list">
                        {project.future.map((improvement) => (
                          <li>{improvement}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>

                <div class="detail-footer">
                  <div class="detail-tech">
                    <h4 class="tech-heading">Technology Stack</h4>
                    <div class="tech-tags">
                      {project.stack.map((tech) => (
                        <span class="tech-tag">{tech}</span>
                      ))}
                    </div>
                  </div>

                  <div class="detail-actions">
                    {project.repoUrl && (
                      <a href={project.repoUrl} class="button button-primary" target="_blank" rel="noopener noreferrer">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                        </svg>
                        View on GitHub
                      </a>
                    )}

                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ===== PROJECTS PAGE ===== */
  .projects-page {
    padding-top: 80px; /* Account for fixed header */
  }

  /* Projects Hero */
  .projects-hero {
    background:
      radial-gradient(circle at 82% 18%, rgba(56, 189, 248, 0.14), transparent 34%),
      linear-gradient(135deg, var(--bg-secondary), var(--bg-main));
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .eyebrow-tag {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent-blue);
    background: var(--accent-blue-subtle);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    border: 1px solid var(--border-medium);
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    color: var(--silver-text);
    line-height: 1.1;
    margin: 0;
  }

  .hero-description {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--silver-muted);
    max-width: 800px;
    margin: 0;
  }

  .hero-stats {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--accent-blue);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--silver-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Category Filter */
  .category-filter {
    margin-bottom: 3rem;
    padding: 1.5rem;
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
  }

  .filter-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--silver-text);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-button {
    padding: 0.75rem 1.5rem;
    background: linear-gradient(180deg, rgba(16, 42, 76, 0.86), rgba(11, 29, 58, 0.94));
    color: var(--silver-text);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--motion-fast) var(--motion-ease);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-button:hover {
    border-color: var(--border-medium);
    background: var(--surface-elevated);
  }

  .filter-button-active {
    background: var(--accent-blue-subtle);
    color: var(--accent-blue);
    border-color: var(--accent-blue);
  }

  .filter-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: inherit;
    opacity: 0.8;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .project-card {
    position: relative;
    background: var(--deep-matte-grey);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    overflow: hidden;
    transition: all var(--motion-medium) var(--motion-ease);
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-medium);
    box-shadow: var(--shadow-elevated);
  }

  .project-card-inner {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .project-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      400px circle at 50% 50%,
      rgba(56, 189, 248, calc(0.05 + var(--project-index) * 0.02)) 0%,
      transparent 50%
    );
    opacity: 0;
    transition: opacity var(--motion-medium) var(--motion-ease);
    pointer-events: none;
  }

  .project-card:hover .project-glow {
    opacity: 0.1;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .project-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge-type {
    background: var(--accent-blue-subtle);
    color: var(--accent-blue);
    border-color: var(--accent-blue);
  }

  .badge-status {
    background: var(--surface-elevated);
    color: var(--silver-text);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: right;
  }

  .project-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--silver-muted);
  }

  .project-difficulty {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--silver-text);
  }

  .project-difficulty[data-difficulty="beginner"] {
    color: #7DD3FC;
    border-color: #7DD3FC;
    background: rgba(125, 211, 252, 0.1);
  }

  .project-difficulty[data-difficulty="intermediate"] {
    color: #60A5FA;
    border-color: #60A5FA;
    background: rgba(96, 165, 250, 0.1);
  }

  .project-difficulty[data-difficulty="advanced"] {
    color: #3B82F6;
    border-color: #3B82F6;
    background: rgba(59, 130, 246, 0.1);
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--silver-text);
    margin: 0;
    line-height: 1.3;
  }

  .project-value {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    padding: 0.9rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: rgba(56, 189, 248, 0.045);
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .project-value svg {
    color: var(--accent-blue);
    margin-top: 0.15rem;
  }

  .project-summary {
    color: var(--silver-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .project-tech {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tech-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--silver-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--silver-muted);
    background: var(--surface-elevated);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .project-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .features-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--silver-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .feature-item {
    font-size: 0.875rem;
    color: var(--silver-muted);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .feature-item::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--accent-blue);
  }

  .feature-item-more {
    font-size: 0.75rem;
    color: var(--silver-muted);
    opacity: 0.7;
    font-style: italic;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .project-actions .button {
    min-width: 140px;
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }

  .project-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--silver-muted);
    text-decoration: none;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .project-link:hover {
    color: var(--accent-blue);
  }

  .project-link svg {
    width: 14px;
    height: 14px;
  }

  /* Project Details */
  .details-grid {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .detail-card {
    background: var(--deep-matte-grey);
    border: 1px solid var(--border-medium);
    border-radius: 12px;
    overflow: hidden;
  }

  .detail-header {
    padding: 2rem;
    background: var(--surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
  }

  .detail-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--silver-text);
    margin: 0 0 1rem 0;
  }

  .detail-meta {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--silver-muted);
  }

  .meta-item svg {
    width: 14px;
    height: 14px;
  }

  .detail-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .content-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .content-heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--silver-text);
    margin: 0;
  }

  .content-text {
    color: var(--silver-muted);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  .content-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .content-list li {
    color: var(--silver-muted);
    font-size: 1rem;
    line-height: 1.6;
    padding-left: 1rem;
    position: relative;
  }

  .content-list li::before {
    content: "-";
    position: absolute;
    left: 0;
    color: var(--accent-blue);
  }

  .architecture {
    background: var(--dark-slate);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .architecture-placeholder {
    text-align: center;
    padding: 2rem;
    color: var(--silver-muted);
  }

  .placeholder-note {
