---
import { getCollection, render } from 'astro:content';
import WriteupLayout from '../../layouts/WriteupLayout.astro';
import { getWriteupSlug } from '../../utils/writeups';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups', ({ data }) => !data.draft);
  return writeups.map((post) => ({
    params: { slug: getWriteupSlug(post) },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<WriteupLayout post={post} headings={headings}>
  <Content />
</WriteupLayout>
