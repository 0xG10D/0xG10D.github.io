---
import { getCollection } from 'astro:content';
import { getWriteupSlug, getWriteupUrl } from '../../utils/writeups';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups', ({ data }) => !data.draft);
  return writeups
    .map((post) => ({ post, canonicalSlug: getWriteupSlug(post) }))
    .filter(({ canonicalSlug }) => canonicalSlug.includes('/'))
    .map((post) => {
      const slug = post.canonicalSlug.split('/').pop();
      return {
        params: { slug },
        props: { target: getWriteupUrl(post.post), title: post.post.data.title }
      };
    })
    .filter((entry) => Boolean(entry.params.slug));
}

const { target, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{title} moved | 0xG10D</title>
  </head>
  <body>
    <p>This writeup moved to <a href={target}>{target}</a>.</p>
  </body>
</html>
