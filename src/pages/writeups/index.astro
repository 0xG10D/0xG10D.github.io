---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatDifficulty,
  formatShortDate,
  getCategoryLabel,
  getEventName,
  getEventSlug,
  getSection,
  getWriteupUrl,
  sectionLabels,
  sortWriteupsNewestFirst
} from '../../utils/writeups';
import type { Section } from '../../utils/writeups';

type Post = CollectionEntry<'writeups'>;

const posts = (await getCollection('writeups', ({ data }) => !data.draft)).sort(sortWriteupsNewestFirst);

const blurbs: Record<Section, string> = {
  htb: 'Retired Hack The Box machines: enumeration, foothold, and privilege escalation.',
  sherlock: 'Hack The Box Sherlocks: defensive investigations from logs, memory, and disk artifacts.',
  ctf: 'Competition challenges grouped by event, newest event first.',
  lab: 'DFIR, wireless, and malware lab notes plus guided platform rooms.'
};

// Posts are already newest-first, so events come out ordered by their latest post.
const groupByEvent = (items: Post[]) =>
  [...new Set(items.map(getEventSlug))].map((slug) => ({
    slug,
    name: getEventName(slug),
    posts: items.filter((post) => getEventSlug(post) === slug)
  }));

const sections = (Object.keys(sectionLabels) as Section[]).map((id) => {
  const items = posts.filter((post) => getSection(post) === id);
  return { id, label: sectionLabels[id], blurb: blurbs[id], count: items.length, events: groupByEvent(items) };
});
---

<BaseLayout title="Writeups" description="CTF, Hack The Box machine, Sherlock, and lab writeups grouped by platform and event.">
  <section class="page-hero">
    <div class="container">
      <p class="prompt">0xG10D://writeups</p>
      <h1>Writeups</h1>
      <p class="lede">
        Grouped by platform and event. To search across everything, use the <a href="/blog/">blog archive</a>.
      </p>
      <nav class="filter-pills jump" aria-label="Jump to section">
        {sections.map((section) => (
          <a class="filter-pill" href={`#${section.id}`}>{section.label}<span class="count">{section.count}</span></a>
        ))}
      </nav>
    </div>
  </section>

  <div class="container">
    {sections.map((section) => (
      <section class="block writeup-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
        <div class="section-head">
          <div>
            <p class="eyebrow">{section.count} writeups</p>
            <h2 id={`${section.id}-heading`}>{section.label}</h2>
          </div>
        </div>
        <p class="section-blurb">{section.blurb}</p>

        {section.events.map((event) => (
          <div class="event">
            {section.events.length > 1 && (
              <h3 class="event-name">{event.name}<span>{event.posts.length}</span></h3>
            )}
            <ul class="entry-list">
              {event.posts.map((post) => (
                <li>
                  <a class="entry" href={getWriteupUrl(post)}>
                    <span class="entry-title">{post.data.title}</span>
                    <span class="entry-kind">{getCategoryLabel(post.data.category)}</span>
                    <span class={`entry-level level-${post.data.difficulty}`}>{formatDifficulty(post.data.difficulty)}</span>
                    <time datetime={post.data.date.toISOString()}>{formatShortDate(post.data.date)}</time>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}

    {posts.length === 0 && (
      <div class="empty-state block">
        <h2>No writeups published</h2>
        <p>Writeups appear here once they are published.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .jump {
    margin-top: 1.25rem;
  }

  .jump .filter-pill {
    display: inline-flex;
    align-items: center;
  }

  .writeup-section {
    scroll-margin-top: 80px;
  }

  .section-blurb {
    max-width: 68ch;
    margin: -0.5rem 0 1rem;
    color: var(--text-2);
    font-size: var(--text-sm);
  }

  .event + .event {
    margin-top: 1.5rem;
  }

  .event-name {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 700;
  }

  .event-name::before {
    content: ">";
    color: var(--accent);
  }

  .event-name span {
    color: var(--text-faint);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  .entry-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 700px), 1fr));
    column-gap: 3rem;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem 4.5rem 6.5rem;
    gap: 1rem;
    min-height: 46px;
    align-items: center;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-2);
    font-size: var(--text-xs);
    text-decoration: none;
    transition: background-color var(--motion);
  }

  .entry:hover,
  .entry:focus-visible {
    background: var(--surface);
    color: var(--text-2);
  }

  .entry-title {
    color: var(--text);
    font-size: var(--text-md);
    font-weight: 500;
  }

  .entry:hover .entry-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .level-hard,
  .level-insane {
    color: var(--text);
  }

  .entry time {
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .entry {
      grid-template-columns: 1fr auto auto;
      gap: 0.2rem 1rem;
    }

    .entry-title {
      grid-column: 1 / -1;
    }

    .entry time {
      text-align: left;
    }
  }
</style>
