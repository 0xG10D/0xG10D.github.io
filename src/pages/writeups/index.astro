---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatArchiveDate,
  formatDifficulty,
  getChallengeType,
  getEventName,
  getEventSlug,
  getWriteupUrl,
  sortEventsByName,
  sortWriteupsNewestFirst
} from '../../utils/writeups';

const allWriteups = await getCollection('writeups');
const writeups = allWriteups
  .filter((post) => !post.data.draft)
  .sort(sortWriteupsNewestFirst);

const eventMap = new Map<string, typeof writeups>();

writeups.forEach((post) => {
  const eventSlug = getEventSlug(post);
  const eventWriteups = eventMap.get(eventSlug) ?? [];
  eventWriteups.push(post);
  eventMap.set(eventSlug, eventWriteups);
});

const events = Array.from(eventMap.entries())
  .map(([slug, posts]) => ({
    slug,
    name: getEventName(slug),
    posts: posts.sort(sortWriteupsNewestFirst),
    count: posts.length,
    latest: posts[0]?.data.date
  }))
  .sort(sortEventsByName);

const totalWriteups = writeups.length;
const latestWriteupDate = writeups[0]?.data.date
  ? formatArchiveDate(writeups[0].data.date)
  : 'No posts yet';
---

<BaseLayout title="Writeups" description="Event-based archive of CTF writeups, lab notes, and security research.">
  <main class="writeups-page">
    <section class="archive-hero section">
      <div class="container">
        <div class="archive-hero-grid">
          <div>
            <p class="hero-eyebrow">Security research archive</p>
            <h1>Writeups by event</h1>
            <p>
              Reports are grouped by their source event or platform. Open an event to browse its entries
              newest to oldest.
            </p>
          </div>
          <dl class="archive-metrics" aria-label="Archive metrics">
            <div>
              <dt>Total writeups</dt>
              <dd>{totalWriteups}</dd>
            </div>
            <div>
              <dt>Events</dt>
              <dd>{events.length}</dd>
            </div>
            <div>
              <dt>Latest update</dt>
              <dd>{latestWriteupDate}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section archive-section">
      <div class="container">
        {events.length > 0 ? (
          <div class="event-archive" aria-label="Event archive">
            {events.map((event, index) => (
              <details class="event-row" name="writeup-events" open={index === 0}>
                <summary>
                  <span class="event-name">{event.name}</span>
                  <span class="event-count">{event.count} {event.count === 1 ? 'writeup' : 'writeups'}</span>
                </summary>

                <ol class="event-writeups">
                  {event.posts.map((post) => (
                    <li class="event-writeup">
                      <time datetime={post.data.date.toISOString()}>{formatArchiveDate(post.data.date)}</time>
                      <a href={getWriteupUrl(post)}>{post.data.title}</a>
                      <span>{getChallengeType(post)}</span>
                      <span>{formatDifficulty(post.data.difficulty)}</span>
                    </li>
                  ))}
                </ol>
              </details>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No writeups available</h2>
            <p>Writeups are currently being prepared.</p>
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .writeups-page {
    padding-top: 0;
  }

  .archive-hero {
    padding-top: var(--section-spacing);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-main);
  }

  .archive-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.42fr);
    gap: 2rem;
    align-items: end;
  }

  .hero-eyebrow {
    margin: 0 0 1rem;
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .archive-hero h1 {
    max-width: 18ch;
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  .archive-hero p:not(.hero-eyebrow) {
    max-width: 68ch;
    color: var(--text-secondary);
    font-size: 1.08rem;
    line-height: 1.68;
  }

  .archive-metrics {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--border-subtle);
  }

  .archive-metrics div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
  }

  .archive-metrics dt {
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .archive-metrics dd {
    margin: 0;
    color: var(--text-primary);
    text-align: right;
  }

  .archive-section {
    padding-top: clamp(2rem, 5vw, 3rem);
  }

  .event-archive {
    border-top: 1px solid var(--border-subtle);
  }

  .event-row {
    border-bottom: 1px solid var(--border-subtle);
  }

  .event-row summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.7rem 1rem;
    align-items: center;
    min-height: 58px;
    padding: 0.95rem 0;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }

  .event-row summary::-webkit-details-marker {
    display: none;
  }

  .event-row summary::before {
    content: "+";
    display: inline-block;
    width: 1.2rem;
    color: var(--accent-blue);
    font-family: var(--font-mono);
  }

  .event-row[open] summary::before {
    content: "-";
  }

  .event-name {
    display: inline;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    font-weight: 700;
  }

  .event-count {
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-align: right;
  }

  .event-writeups {
    display: grid;
    gap: 0;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-subtle);
  }

  .event-writeup {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) minmax(8rem, 0.24fr) minmax(5rem, 0.12fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.72rem 0;
    border-bottom: 1px solid rgba(38, 49, 60, 0.7);
  }

  .event-writeup:last-child {
    border-bottom: 0;
  }

  .event-writeup time,
  .event-writeup span {
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .event-writeup a {
    min-width: 0;
    color: var(--text-primary);
    font-weight: 700;
  }

  .event-writeup a:hover {
    color: var(--accent-blue);
  }

  .empty-state {
    border: 1px solid var(--border-subtle);
    padding: 2rem;
  }

  .empty-state h2 {
    margin-top: 0;
  }

  @media (max-width: 820px) {
    .archive-hero-grid {
      grid-template-columns: 1fr;
    }

    .archive-metrics dd {
      text-align: left;
    }

    .event-writeup {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding: 0.9rem 0;
    }
  }

  @media (max-width: 520px) {
    .event-row summary {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.25rem;
    }

    .event-count {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
